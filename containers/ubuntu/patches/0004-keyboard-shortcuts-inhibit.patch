diff --git a/src/protocols/keyboard-shortcuts-inhibit.c b/src/protocols/keyboard-shortcuts-inhibit.c
new file mode 100644
index 0000000..38a0936
--- /dev/null
+++ b/src/protocols/keyboard-shortcuts-inhibit.c
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * thinfloe: zwp_keyboard_shortcuts_inhibit_manager_v1
+ *
+ * Native Wayland remote desktop clients (OxuLnk) ask the compositor to
+ * switch its keybindings off for their window, so that every key reaches
+ * the remote session. Without this global they report that the keyboard
+ * grab does not work.
+ *
+ * An inhibitor is activated once, when it is created, and stays active
+ * until the client destroys it. labwc only checks keybindings against the
+ * focused view (view_inhibits_actions()), so the inhibition already ends
+ * when the window loses the focus and returns with it. No 'inactive' event
+ * is sent on a focus change: clients read 'inactive' as "the user took the
+ * inhibition back" and do not ask again. ToggleKeybinds still works, as the
+ * protocol asks for a way out.
+ */
+#include <assert.h>
+#include <stdlib.h>
+#include <wayland-server-core.h>
+#include <wlr/types/wlr_compositor.h>
+#include <wlr/types/wlr_keyboard_shortcuts_inhibit_v1.h>
+#include <wlr/util/log.h>
+#include "common/mem.h"
+#include "labwc.h"
+#include "view.h"
+
+struct lab_shortcuts_inhibitor {
+	struct view *view;
+	struct wl_listener on_destroy;
+	struct wl_listener on_view_destroy;
+};
+
+static struct wl_listener on_new_inhibitor;
+static struct wl_listener on_manager_destroy;
+
+static void
+handle_view_destroy(struct wl_listener *listener, void *data)
+{
+	struct lab_shortcuts_inhibitor *inh =
+		wl_container_of(listener, inh, on_view_destroy);
+	wl_list_remove(&inh->on_view_destroy.link);
+	wl_list_init(&inh->on_view_destroy.link);
+	inh->view = NULL;
+}
+
+static void
+handle_inhibitor_destroy(struct wl_listener *listener, void *data)
+{
+	struct lab_shortcuts_inhibitor *inh =
+		wl_container_of(listener, inh, on_destroy);
+	if (inh->view) {
+		assert(inh->view->keybinds_inhibitors > 0);
+		inh->view->keybinds_inhibitors--;
+	}
+	wl_list_remove(&inh->on_view_destroy.link);
+	wl_list_remove(&inh->on_destroy.link);
+	free(inh);
+}
+
+static void
+handle_new_inhibitor(struct wl_listener *listener, void *data)
+{
+	struct wlr_keyboard_shortcuts_inhibitor_v1 *inhibitor = data;
+	struct wlr_surface *root =
+		wlr_surface_get_root_surface(inhibitor->surface);
+	struct view *view = root ? view_from_wlr_surface(root) : NULL;
+	if (!view) {
+		/* No window (e.g. a layer surface): nothing to inhibit for. */
+		return;
+	}
+
+	struct lab_shortcuts_inhibitor *inh = znew(*inh);
+	inh->view = view;
+	view->keybinds_inhibitors++;
+
+	inh->on_view_destroy.notify = handle_view_destroy;
+	wl_signal_add(&view->events.destroy, &inh->on_view_destroy);
+	inh->on_destroy.notify = handle_inhibitor_destroy;
+	wl_signal_add(&inhibitor->events.destroy, &inh->on_destroy);
+
+	wlr_keyboard_shortcuts_inhibitor_v1_activate(inhibitor);
+}
+
+static void
+handle_manager_destroy(struct wl_listener *listener, void *data)
+{
+	wl_list_remove(&on_new_inhibitor.link);
+	wl_list_remove(&on_manager_destroy.link);
+}
+
+void
+keyboard_shortcuts_inhibit_create(struct server *server)
+{
+	assert(server);
+	struct wlr_keyboard_shortcuts_inhibit_manager_v1 *manager =
+		wlr_keyboard_shortcuts_inhibit_v1_create(server->wl_display);
+	if (!manager) {
+		wlr_log(WLR_ERROR, "cannot create the keyboard shortcuts inhibit manager");
+		return;
+	}
+	on_new_inhibitor.notify = handle_new_inhibitor;
+	wl_signal_add(&manager->events.new_inhibitor, &on_new_inhibitor);
+	on_manager_destroy.notify = handle_manager_destroy;
+	wl_signal_add(&manager->events.destroy, &on_manager_destroy);
+}
