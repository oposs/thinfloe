  */
 void desktop_focus_topmost_view(struct server *server);
 
+/**
+ * desktop_fullscreen_keeps_focus() - whether a newly shown view must leave
+ * the keyboard focus where it is: the view is always-on-bottom, so it can
+ * never be raised above the topmost view, and that topmost view is
+ * fullscreen and focused. Without this, a desktop window that maps again
+ * (e.g. after a monitor wakes from power save) takes the keyboard from a
+ * fullscreen window that still covers it.
+ */
+bool desktop_fullscreen_keeps_focus(struct view *view);
+
 void seat_init(struct server *server);
 void seat_finish(struct server *server);
 void seat_reconfigure(struct server *server);
diff --git a/src/desktop.c b/src/desktop.c
index abff9c1..e5343c8 100644
--- a/src/desktop.c
+++ b/src/desktop.c
@@ -167,6 +167,18 @@ desktop_focus_topmost_view(struct server *server)
 	}
 }
 
+bool
+desktop_fullscreen_keeps_focus(struct view *view)
+{
+	if (!view_is_always_on_bottom(view)) {
+		return false;
+	}
+	struct server *server = view->server;
+	struct view *top = desktop_topmost_focusable_view(server);
+	return top && top != view && top->fullscreen
+		&& top == server->active_view;
+}
