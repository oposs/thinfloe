# ThinFloe boot screen: logo and name in the middle, a thin ice-blue progress
# line slanted 9 degrees below them, black background with a faint ice-blue
# glow rising from the bottom, the host name small in Geo at the foot.
#
# The PNGs are made for a 1920 px wide screen (brand/*.svg, rendered in the
# plymouth-art stage of containers/ubuntu/Dockerfile); k scales the glow and
# the bar, and picks one of the rendered logo widths.
#
# The host name arrives with "plymouth display-message", which
# tf_write_hostname (90thinfloe/thinfloe-lib.sh) calls once the name is known.
# Until then the foot line is empty. The version is not shown (nothing writes
# /etc/thinfloe/version yet).
#
# Above the host name a step line says what the machine is doing. It arrives
# through "plymouth update --status": ThinFloe's own steps as "tf:<text>",
# shown as they are, and systemd's as the id of each unit it starts, which a
# table translates; an id not in the table leaves the line as it was.
#
# Geo comes from the initrd's /usr/share/fonts (90thinfloe/module-setup.sh);
# the label plugin, label-pango, finds it through fontconfig.

# Background #05070a
Window.SetBackgroundTopColor(0.0196, 0.0275, 0.0392);
Window.SetBackgroundBottomColor(0.0196, 0.0275, 0.0392);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();
k = screen.w / 1920.0;
if (screen.h / 1080.0 < k)
    k = screen.h / 1080.0;

glow.image = Image("glow.png");
glow.sprite = Sprite(glow.image.Scale(screen.w, screen.h));
glow.sprite.SetPosition(0, 0, -10);

# The logo is drawn unscaled: Image.Scale interpolates, and a 640 px logo drawn
# 1280 px wide on a 4K screen had edges blurred over 3 px. The plymouth-art
# stage renders it at these widths; the widest one that fits 640 * k is used.
logo.widths[0] = 320;
logo.widths[1] = 427;
logo.widths[2] = 480;
logo.widths[3] = 640;
logo.widths[4] = 853;
logo.widths[5] = 960;
logo.widths[6] = 1280;
logo.pick = logo.widths[0];
i = 0;
while (i < 7)
{
    if (logo.widths[i] <= Math.Int(640 * k + 0.5))
        logo.pick = logo.widths[i];
    i = i + 1;
}
logo.image = Image("logo-" + logo.pick + ".png");
logo.w = logo.image.GetWidth();
logo.h = logo.image.GetHeight();
logo.sprite = Sprite(logo.image);
logo.x = Math.Int((screen.w - logo.w) / 2);
logo.y = Math.Int(screen.h * 0.46 - logo.h / 2);
logo.sprite.SetPosition(logo.x, logo.y, 10);

# Progress line: 28 % of the width, 6 px at 1080p, 40 px under the logo.
bar.w = Math.Int(screen.w * 0.28);
bar.h = Math.Int(12 * k / 2);
if (bar.h < 2)
    bar.h = 2;
bar.x = Math.Int((screen.w - bar.w) / 2);
bar.y = logo.y + logo.h + Math.Int(40 * k);
bar.track.image = Image("bar-track.png");
bar.fill.image = Image("bar-fill.png");
bar.track.sprite = Sprite(bar.track.image.Scale(bar.w, bar.h));
bar.track.sprite.SetPosition(bar.x, bar.y, 10);
bar.fill.sprite = Sprite();
bar.fill.sprite.SetPosition(bar.x, bar.y, 11);
bar.progress = 0.0;

fun set_progress(p)
{
    if (p < bar.progress)
        p = bar.progress;
    if (p > 1.0)
        p = 1.0;
    bar.progress = p;
    w = Math.Int(bar.w * p);
    if (w < 1)
        w = 1;
    bar.fill.sprite.SetImage(bar.fill.image.Scale(w, bar.h));
}
set_progress(0.02);

# Plymouth's own progress divides the elapsed time by the length of earlier
# boots, kept in /var/lib/plymouth/boot-duration. A machine running from RAM
# never keeps that file, so Plymouth assumes 60 s and the bar ended at 7 to
# 15 % when the session took over. The bar therefore follows the elapsed time
# alone: 1 - e^(-t/5), 63 % at 5 s, 86 % at 10 s, 95 % at 15 s. The script
# language has no exp: e^(-t/5) is (e^(-t/320))^64, the inner term from three
# terms of its series, then squared six times.
fun ease(t)
{
    y = t / 320.0;
    e = 1.0 - y + y * y / 2.0 - y * y * y / 6.0;
    if (e < 0.0)
        e = 0.0;
    i = 0;
    while (i < 6)
    {
        e = e * e;
        i = i + 1;
    }
    return 1.0 - e;
}

fun boot_progress(duration, progress)
{
    set_progress(ease(duration));
}
Plymouth.SetBootProgressFunction(boot_progress);

# Host name at the foot, #8a97a6 as in the mockup, 16 px at 1080p.
foot.sprite = Sprite();
foot.size = Math.Int(16 * k);
if (foot.size < 9)
    foot.size = 9;

fun show_message(text)
{
    foot.image = Image.Text(text, 0.541, 0.592, 0.651, 1, "Geo " + foot.size);
    foot.sprite.SetImage(foot.image);
    foot.sprite.SetPosition(
        Math.Int((screen.w - foot.image.GetWidth()) / 2),
        Math.Int(screen.h * 0.94 - foot.image.GetHeight()),
        10);
}

fun hide_message(text)
{
    foot.sprite.SetImage(Image.Text(" ", 0, 0, 0, 0, "Geo " + foot.size));
}

Plymouth.SetDisplayMessageFunction(show_message);
Plymouth.SetHideMessageFunction(hide_message);

# Step line, 20 px at 1080p, centred just above the host name.
step.sprite = Sprite();
step.size = Math.Int(20 * k);
if (step.size < 11)
    step.size = 11;
step.bottom = Math.Int(screen.h * 0.94
    - Image.Text("Ag", 0, 0, 0, 1, "Geo " + foot.size).GetHeight()
    - 8 * k);

fun show_step(text)
{
    if (text.Length() > 64)
        text = text.SubString(0, 64);
    step.image = Image.Text(text, 0.541, 0.592, 0.651, 1, "Geo " + step.size);
    step.sprite.SetImage(step.image);
    step.sprite.SetPosition(
        Math.Int((screen.w - step.image.GetWidth()) / 2),
        step.bottom - step.image.GetHeight(),
        10);
}

# systemd unit id -> step text. Keep it short; ids not listed change nothing.
fun unit_step(id)
{
    if (id == "systemd-udevd.service")
        return "Detecting hardware";
    if (id == "systemd-networkd.service")
        return "Starting the network";
    if (id == "systemd-resolved.service")
        return "Starting name lookup";
    if (id == "chrony.service")
        return "Setting the clock";
    if (id.SubString(0, 14) == "wpa_supplicant" || id.SubString(0, 12) == "netplan-wpa-")
        return "Connecting to WiFi";
    if (id == "wg-quick@wg0.service")
        return "Starting WireGuard";
    if (id == "ssh.service" || id == "thinfloe-ssh-hostkeys.service")
        return "Starting SSH";
    if (id == "thinfloe-wait-kms.service")
        return "Waiting for the graphics driver";
    if (id == "thinfloe-addons.service")
        return "Installing add-ons";
    return "";
}

fun update_status(status)
{
    if (status.SubString(0, 3) == "tf:")
        text = status.SubString(3, status.Length());
    else
        text = unit_step(status);
    if (text != "")
        show_step(text);
}

Plymouth.SetUpdateStatusFunction(update_status);
