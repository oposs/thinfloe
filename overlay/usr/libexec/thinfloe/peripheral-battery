#!/usr/bin/env python3
"""
peripheral-battery - write the battery charge of keyboards and mice

Writes $TF_BATTERY_DIR/battery (default /run/thinfloe/peripherals/battery),
one line per device, sorted by name:

    name<TAB>percent<TAB>state<TAB>read_epoch<TAB>kind

percent is 0..100 or "-"; state is discharging, charging, full, low,
critical, unknown or "not reachable"; kind is keyboard, mouse, numpad,
presenter, trackball, touchpad or unknown. A device that does not answer
keeps its last reading, the time it was taken and its kind. The temporary file, the name
cache and the lock live in $TF_BATTERY_STATE (default
/run/thinfloe/peripherals-state).

Two sources:
- Logitech receivers the kernel does not drive (the Logi Bolt receiver
  046d:c548 is left to hid-generic), asked over HID++ on their hidraw node.
  Needs root.
- /sys/class/power_supply entries with scope Device (Bluetooth devices,
  receivers the kernel drives).

Run once at boot by thinfloe-peripheral-battery.service and every 5
minutes by its timer. Every per-device failure is
logged and skipped; exit 1 only when the file could not be written.

The menu's battery tile reads the file, and a click runs this helper once
more through sudo -n; a run holds $TF_BATTERY_STATE/lock, so a click and the
timer take turns.

"peripheral-battery watch" (thinfloe-peripheral-battery-watch.service) stays
running and listens on every HID++ node for the events a Bolt device sends
by itself when it connects: WIRELESS DEVICE STATUS (0x1D4B) event 0 with
status 1 (reconnection) and UNIFIED BATTERY (0x1004) event 0. On one it runs
the reading above, after DEBOUNCE seconds, unless the device has a value
with a percent, not "not reachable", younger than HOLD_OFF seconds. It
sends nothing on a node except the root feature's getFeature for those two
features, once per receiver and slot, under the lock. Any other argument
is a usage error (exit 2).
"""

import fcntl
import os
import select
import sys
import time
import unicodedata
from pathlib import Path
from typing import Dict, List, NamedTuple, Optional, Sequence, Tuple

REQUEST_TIMEOUT = 2.0   # an idle keyboard answered after 850 ms
RUN_BUDGET = 15.0
LOCK_WAIT = 30.0        # how long a run waits for another one
LOCK_POLL = 0.1
DEBOUNCE = 2.0          # events within this time give one reading
HOLD_OFF = 300          # a successful value this young is not read again
RESCAN = 5.0            # how often the watcher looks for HID++ nodes
LOOKUP_RETRY = 30.0     # a slot whose features did not answer is asked again after
WIRELESS_STATUS = 0x1D4B
UNIFIED_BATTERY = 0x1004
SWID = 0x0A
MAX_NAME = 64

monotonic = time.monotonic

# Drivers that already give the kernel the battery (power_supply).
KERNEL_DRIVERS = {"logitech-djreceiver", "logitech-djdevice", "logitech-hidpp-device"}


class Reading(NamedTuple):
    name: str
    percent: Optional[int]
    state: str
    read_epoch: int
    kind: str = "unknown"


# The low nibble of the first byte of the receiver's pairing info (register
# b5/50+n), as Solaar numbers it for Bolt. 1 and 2 measured on 2026-11-03.
RECEIVER_KINDS = {1: "keyboard", 2: "mouse", 3: "numpad", 4: "presenter",
                  8: "trackball", 9: "touchpad"}
KINDS = set(RECEIVER_KINDS.values()) | {"unknown"}


def kind_of(byte: int) -> str:
    return RECEIVER_KINDS.get(byte & 0x0F, "unknown")


def log(what: str, why: str) -> None:
    print(f"thinfloe: battery: {what}: {why}", file=sys.stderr)


def sanitise(name: str) -> str:
    name = name.replace("\0", "")
    # Control and format characters (bidi overrides) and Unicode line or
    # paragraph separators: a name must stay one line for every reader.
    name = "".join("?" if unicodedata.category(c) in ("Cc", "Cf", "Zl", "Zp") else c
                   for c in name)
    name = name.strip()[:MAX_NAME]
    return name or "unknown device"


# --- HID++ over hidraw ------------------------------------------------------

class HidrawTransport:
    def __init__(self, node: Path):
        self.fd = os.open(str(node), os.O_RDWR)

    def write(self, data: bytes) -> None:
        os.write(self.fd, data)

    def read(self, timeout: float) -> Optional[bytes]:
        if not select.select([self.fd], [], [], max(timeout, 0))[0]:
            return None
        return os.read(self.fd, 64)

    def close(self) -> None:
        os.close(self.fd)


def open_transport(node: Path):
    return HidrawTransport(node)


def _exchange(t, msg: bytes, match, deadline: float) -> Optional[bytes]:
    """Send msg, return the data of the first reply match() accepts, None on
    an error reply or when the request timeout or the deadline passes.
    match(rep) returns data, False for an error reply, None for unrelated."""
    # A reply that came after its request timed out would match the next
    # request of the same kind (same slot, feature and SWID): drop it.
    for _ in range(32):
        if t.read(0) is None:
            break
    t.write(msg)
    stop = min(monotonic() + REQUEST_TIMEOUT, deadline)
    while True:
        left = stop - monotonic()
        if left <= 0:
            return None
        rep = t.read(left)
        if rep is None:
            return None
        got = match(rep)
        if got is False:
            return None
        if got is not None:
            return got


def _feature_call(t, slot: int, feat: int, func: int, params: bytes, deadline: float) -> Optional[bytes]:
    fsw = (func << 4) | SWID
    msg = bytes([0x11, slot, feat, fsw]) + params

    def match(rep):
        if len(rep) < 5 or rep[1] != slot:
            return None
        if rep[2] == feat and rep[3] == fsw:
            return rep[4:]
        if rep[2] == 0xFF and rep[3] == feat and rep[4] == fsw:
            return False
        if rep[0] == 0x10 and rep[2] == 0x8F and rep[3] == feat and rep[4] == fsw:
            return False
        return None
    return _exchange(t, msg.ljust(20, b"\0"), match, deadline)


def _receiver_register(t, sub: int, param: int, deadline: float) -> Optional[bytes]:
    msg = bytes([0x10, 0xFF, 0x83, 0xB5, sub, param, 0x00])

    def match(rep):
        if len(rep) < 5 or rep[1] != 0xFF:
            return None
        if rep[2] == 0x83 and rep[3] == 0xB5 and rep[4] == sub:
            return rep[5:]
        if rep[2] == 0x8F and rep[3] == 0x83 and rep[4] == 0xB5:
            return False
        return None
    return _exchange(t, msg, match, deadline)


def _receiver_name(t, slot: int, deadline: float) -> str:
    first = _receiver_register(t, 0x60 + slot, 1, deadline)
    if not first or len(first) < 2:
        return f"device {slot}"
    length = first[1]
    name = bytes(first[2:])
    chunk = 2
    while len(name) < length and chunk <= 4:
        more = _receiver_register(t, 0x60 + slot, chunk, deadline)
        if not more or len(more) < 2:
            break
        name += bytes(more[1:])
        chunk += 1
    return sanitise(name[:length].decode("utf-8", "replace"))


def _feature_index(t, slot: int, fid: int, deadline: float) -> Optional[int]:
    r = _feature_call(t, slot, 0x00, 0, bytes([fid >> 8, fid & 0xFF]), deadline)
    return r[0] if r and r[0] else None


def _device_name(t, slot: int, deadline: float) -> Optional[str]:
    idx = _feature_index(t, slot, 0x0005, deadline)
    if not idx:
        return None
    r = _feature_call(t, slot, idx, 0, b"", deadline)
    if not r:
        return None
    length = r[0]
    name = b""
    for _ in range(8):
        if len(name) >= length:
            break
        part = _feature_call(t, slot, idx, 1, bytes([len(name)]), deadline)
        if not part:
            break
        name += bytes(part[: length - len(name)])
    return sanitise(name.decode("utf-8", "replace")) if name else None


UB_CHARGING = {1: "charging", 2: "charging", 3: "full"}
BS_STATUS = {0: "discharging", 1: "charging", 2: "charging", 3: "full"}


def _battery(t, slot: int, deadline: float) -> Optional[Tuple[Optional[int], str]]:
    """(percent, state), or None when the device stopped answering."""
    idx = _feature_index(t, slot, 0x1004, deadline)
    if idx:
        r = _feature_call(t, slot, idx, 1, b"", deadline)
        if not r or len(r) < 3:
            return None
        soc, level, charging = r[0], r[1], r[2]
        if charging == 0:
            state = "critical" if level & 1 else "low" if level & 2 else "discharging"
        else:
            state = UB_CHARGING.get(charging, "unknown")
        return (soc if soc <= 100 else None), state
    idx = _feature_index(t, slot, 0x1000, deadline)
    if idx:
        r = _feature_call(t, slot, idx, 0, b"", deadline)
        if not r or len(r) < 3:
            return None
        return (r[0] if r[0] <= 100 else None), BS_STATUS.get(r[2], "unknown")
    idx = _feature_index(t, slot, 0x1001, deadline)
    if idx:
        r = _feature_call(t, slot, idx, 0, b"", deadline)
        return None if not r else (None, "unknown")
    return None, "unknown"


def read_receiver(t, now: int, deadline: Optional[float] = None
                  ) -> Tuple[List[Tuple[int, str, Reading]], List[Tuple[int, str, str]]]:
    """Read every paired slot of one receiver. Returns (slot, receiver_name,
    reading) for devices that answered and (slot, receiver_name, kind) for
    paired slots that did not. Pairing and kind come from the receiver's
    register b5/50+n, never from the ping: an empty slot answers the ping
    with an error too."""
    if deadline is None:
        deadline = monotonic() + RUN_BUDGET
    paired = []
    for slot in range(1, 7):
        info = _receiver_register(t, 0x50 + slot, 0, deadline)
        if info is not None:
            kind = kind_of(info[0]) if info else "unknown"
            paired.append((slot, _receiver_name(t, slot, deadline), kind))
    got, unreachable = [], []
    for slot, rname, kind in paired:
        if monotonic() >= deadline or _feature_call(t, slot, 0x00, 1, b"\0\0\x5a", deadline) is None:
            unreachable.append((slot, rname, kind))
            continue
        name = _device_name(t, slot, deadline) or rname
        bat = _battery(t, slot, deadline)
        if bat is None:
            unreachable.append((slot, rname, kind))
            continue
        got.append((slot, rname, Reading(name, bat[0], bat[1], now, kind)))
    return got, unreachable


def find_hidpp_nodes(sysfs: Path, dev: Path) -> List[Tuple[Path, str]]:
    """(device node, HID_PHYS) of every Logitech HID++ interface whose
    driver does not give the kernel the battery already."""
    nodes = []
    for d in sorted((sysfs / "class" / "hidraw").glob("hidraw*")):
        try:
            uevent = dict(line.split("=", 1) for line in
                          (d / "device" / "uevent").read_text().splitlines() if "=" in line)
            desc = (d / "device" / "report_descriptor").read_bytes()
            driver = os.path.basename(os.readlink(d / "device" / "driver"))
        except OSError:
            continue
        parts = uevent.get("HID_ID", "").upper().split(":")
        if len(parts) != 3 or parts[1] != "0000046D" or driver in KERNEL_DRIVERS:
            continue
        if b"\x06\x00\xff" in desc and b"\x85\x11" in desc:
            nodes.append((dev / d.name, uevent.get("HID_PHYS", d.name)))
    return nodes


# --- power_supply -----------------------------------------------------------

def kind_from_name(name: str) -> str:
    """power_supply has no kind; a name that says it is the only hint."""
    low = name.lower()
    if "keyboard" in low:
        return "keyboard"
    if "mouse" in low:
        return "mouse"
    return "unknown"


PS_STATUS = {"discharging": "discharging", "not charging": "discharging",
             "charging": "charging", "full": "full"}


def read_power_supply(sysfs: Path, now: int) -> List[Reading]:
    out = []
    for d in sorted((sysfs / "class" / "power_supply").glob("*")):
        try:
            kv = dict(line.split("=", 1) for line in
                      (d / "uevent").read_text().splitlines() if "=" in line)
        except OSError:
            continue
        if kv.get("POWER_SUPPLY_SCOPE") != "Device":
            continue
        name = kv.get("POWER_SUPPLY_MODEL_NAME") or kv.get("POWER_SUPPLY_NAME") or d.name
        cap = kv.get("POWER_SUPPLY_CAPACITY", "")
        percent = int(cap) if cap.isdigit() and int(cap) <= 100 else None
        state = PS_STATUS.get(kv.get("POWER_SUPPLY_STATUS", "").lower(), "unknown")
        name = sanitise(name)
        out.append(Reading(name, percent, state, now, kind_from_name(name)))
    return out


# --- file -------------------------------------------------------------------

def format_lines(readings: List[Reading]) -> str:
    return "".join(f"{r.name}\t{'-' if r.percent is None else r.percent}\t{r.state}\t{r.read_epoch}"
                   f"\t{r.kind}\n"
                   for r in sorted(readings))


def parse_lines(text: str) -> List[Reading]:
    """Five fields, or four from a file written before the kind existed."""
    out = []
    for line in text.split("\n"):
        f = line.split("\t")
        if len(f) not in (4, 5) or not f[3].isdigit() or not (f[1] == "-" or f[1].isdigit()):
            continue
        kind = f[4] if len(f) == 5 and f[4] in KINDS else "unknown"
        out.append(Reading(f[0], None if f[1] == "-" else int(f[1]), f[2], int(f[3]), kind))
    return sorted(out)


def merge(new: List[Reading], previous: List[Reading], unreachable: List[Tuple[str, str]],
          now: int) -> List[Reading]:
    """New readings win; an unreachable device (name, kind) keeps its
    previous percent and time, or gets "-" when it was never read, and the
    previous kind when its own is unknown. Anything else is dropped."""
    result = {r.name: r for r in new}
    prev = {r.name: r for r in previous}
    for name, kind in unreachable:
        if name in result:
            continue
        p = prev.get(name)
        if kind == "unknown" and p:
            kind = p.kind
        result[name] = (p._replace(state="not reachable", kind=kind) if p
                        else Reading(name, None, "not reachable", now, kind))
    return sorted(result.values())


NameCache = Dict[Tuple[str, int], Tuple[str, str, str]]


def resolve_name(cache: NameCache, phys: str, slot: int, receiver_name: str,
                 kind: str = "unknown") -> Tuple[str, str]:
    """(full name, kind) of a paired slot that did not answer: the cached
    ones while the slot holds the same device, the pairing kind first."""
    entry = cache.get((phys, slot))
    if entry and entry[0] == receiver_name:
        return entry[1], kind if kind != "unknown" else entry[2]
    return receiver_name, kind


def load_names(path: Path) -> NameCache:
    cache = {}
    try:
        for line in path.read_text().splitlines():
            f = line.split("\t")
            if len(f) in (4, 5) and f[1].isdigit():
                kind = f[4] if len(f) == 5 and f[4] in KINDS else "unknown"
                cache[(f[0], int(f[1]))] = (f[2], f[3], kind)
    except OSError:
        pass
    return cache


def _write_atomic(state: Path, target: Path, text: str, mode: int) -> None:
    tmp = state / f".{target.name}.new"
    try:
        with open(tmp, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, target)
    finally:
        if tmp.exists():
            tmp.unlink()


def _take_lock(state: Path) -> Optional[int]:
    """The locked fd of $TF_BATTERY_STATE/lock, waiting up to LOCK_WAIT for
    another run; None (logged) when it cannot be had. Closing the fd frees
    it."""
    lockpath = state / "lock"
    try:
        lockfd = os.open(str(lockpath),
                         os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    except OSError as e:
        log(str(lockpath), e.strerror or str(e))
        return None
    give_up = time.monotonic() + LOCK_WAIT
    while True:
        try:
            fcntl.flock(lockfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lockfd
        except BlockingIOError:
            if time.monotonic() >= give_up:
                os.close(lockfd)
                print("thinfloe: battery: lock busy", file=sys.stderr)
                return None
            time.sleep(LOCK_POLL)
        except OSError as e:
            os.close(lockfd)
            log(str(lockpath), e.strerror or str(e))
            return None


def _paths() -> Tuple[Path, Path, Path, Path]:
    return (Path(os.environ.get("TF_SYSFS", "/sys")),
            Path(os.environ.get("TF_DEV", "/dev")),
            Path(os.environ.get("TF_BATTERY_DIR", "/run/thinfloe/peripherals")),
            Path(os.environ.get("TF_BATTERY_STATE", "/run/thinfloe/peripherals-state")))


def read_batteries() -> int:
    sysfs, dev, outdir, state = _paths()
    lockfd = _take_lock(state)
    if lockfd is None:
        return 1
    try:
        return _read_locked(sysfs, dev, outdir, state)
    finally:
        os.close(lockfd)


def _read_locked(sysfs: Path, dev: Path, outdir: Path, state: Path) -> int:
    now = int(time.time())
    deadline = monotonic() + RUN_BUDGET
    cache = load_names(state / "names")
    try:
        previous = parse_lines((outdir / "battery").read_text())
    except OSError:
        previous = []

    new = read_power_supply(sysfs, now)
    # A power_supply device that was seen this boot and is gone now (a
    # Bluetooth mouse switched off) keeps its last reading as not reachable.
    try:
        ps_seen = set((state / "power-supply").read_text().split("\n")) - {""}
    except OSError:
        ps_seen = set()
    ps_now = {r.name for r in new}
    unreachable = [(name, "unknown") for name in sorted(ps_seen - ps_now)]
    for node, phys in find_hidpp_nodes(sysfs, dev):
        t = None
        try:
            t = open_transport(node)
            got, gone = read_receiver(t, now, deadline)
        except OSError as e:
            log(str(node), e.strerror or str(e))
            continue
        except Exception as e:  # noqa: BLE001 - device data is untrusted
            log(str(node), f"{type(e).__name__}: {e}")
            continue
        finally:
            if t is not None and hasattr(t, "close"):
                try:
                    t.close()
                except OSError:
                    pass
        for slot, rname, reading in got:
            cache[(phys, slot)] = (rname, reading.name, reading.kind)
            new.append(reading)
        for slot, rname, kind in gone:
            unreachable.append(resolve_name(cache, phys, slot, rname, kind))

    try:
        _write_atomic(state, outdir / "battery",
                      format_lines(merge(new, previous, unreachable, now)), 0o644)
    except Exception as e:  # noqa: BLE001 - anything here means no file
        log(str(outdir / "battery"), str(e))
        return 1
    try:
        _write_atomic(state, state / "power-supply",
                      "".join(f"{n}\n" for n in sorted(ps_seen | ps_now)), 0o600)
    except OSError as e:
        log(str(state / "power-supply"), e.strerror or str(e))
    try:
        _write_atomic(state, state / "names",
                      "".join(f"{p}\t{s}\t{r}\t{n}\t{k}\n" for (p, s), (r, n, k) in sorted(cache.items())),
                      0o600)
    except OSError as e:
        log(str(state / "names"), e.strerror or str(e))
    return 0


# --- watcher ----------------------------------------------------------------

def event_head(rep: bytes) -> Optional[Tuple[int, int]]:
    """(slot, feature index) of a report a device sent by itself: a long
    HID++ 2.0 report from slot 1..6 with function 0 and software id 0
    (replies to requests carry SWID, never 0), not the root feature and not
    an error report."""
    if len(rep) < 5 or rep[0] != 0x11 or not 1 <= rep[1] <= 6:
        return None
    if rep[3] != 0x00 or rep[2] in (0x00, 0xFF):
        return None
    return rep[1], rep[2]


def is_connect_event(rep: bytes, ws: Optional[int], ub: Optional[int]) -> bool:
    """A reconnection (0x1D4B status 1) or a battery report (0x1004), given
    the device's indices of those features."""
    head = event_head(rep)
    if head is None:
        return False
    idx = head[1]
    if ws is not None and idx == ws:
        return rep[4] == 0x01
    return ub is not None and idx == ub


class Listener:
    """A HID++ node opened read-only: the watcher only takes the reports
    the kernel hands every reader of the node."""

    def __init__(self, node: Path):
        self.fd = os.open(str(node), os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)

    def fileno(self) -> int:
        return self.fd

    def read(self) -> bytes:
        data = os.read(self.fd, 64)
        if not data:
            raise OSError(19, "node gone")
        return data

    def close(self) -> None:
        os.close(self.fd)


def open_listener(node: Path):
    return Listener(node)


def wait_readable(listeners, timeout: float):
    return select.select(listeners, [], [], max(timeout, 0))[0]


def _lookup_indices(node: Path, slot: int) -> Optional[Tuple[Optional[int], Optional[int]]]:
    """The device's indices of 0x1D4B and 0x1004 (None for an absent
    feature), asked under the reader's lock; None when it did not answer."""
    state = _paths()[3]
    lockfd = _take_lock(state)
    if lockfd is None:
        return None
    t = None
    try:
        t = open_transport(node)
        deadline = monotonic() + 2 * REQUEST_TIMEOUT + 1
        got = []
        for fid in (WIRELESS_STATUS, UNIFIED_BATTERY):
            r = _feature_call(t, slot, 0x00, 0, bytes([fid >> 8, fid & 0xFF]), deadline)
            if not r:
                return None
            got.append(r[0] or None)
        return got[0], got[1]
    finally:
        if t is not None and hasattr(t, "close"):
            try:
                t.close()
            except OSError:
                pass
        os.close(lockfd)


class Watcher:
    def __init__(self, read=None, wait=None):
        self.read = read            # None: read_batteries, looked up at call time
        self.wait = wait or wait_readable
        self.nodes = {}             # node -> (listener, HID_PHYS)
        self.indices = {}           # (HID_PHYS, slot) -> (0x1D4B index, 0x1004 index)
        self.lookup_failed = {}     # (HID_PHYS, slot) -> monotonic time of the next try
        self.pending = set()        # (HID_PHYS, slot) waiting for the debounce
        self.due = None
        self.next_scan = monotonic()

    def rescan(self) -> None:
        sysfs, dev, _, _ = _paths()
        found = dict(find_hidpp_nodes(sysfs, dev))
        for node in [n for n in self.nodes if n not in found]:
            self._drop(node, None)
        for node, phys in found.items():
            if node in self.nodes:
                continue
            try:
                self.nodes[node] = (open_listener(node), phys)
            except OSError as e:
                log(str(node), e.strerror or str(e))

    def _drop(self, node: Path, why: Optional[str]) -> None:
        listener, phys = self.nodes.pop(node)
        if why:
            log(str(node), why)
        try:
            listener.close()
        except OSError:
            pass
        for cache in (self.indices, self.lookup_failed):
            for key in [k for k in cache if k[0] == phys]:
                del cache[key]

    def on_report(self, node: Path, phys: str, rep: bytes) -> None:
        head = event_head(rep)
        if head is None:
            return
        key = (phys, head[0])
        if key not in self.indices:
            if monotonic() < self.lookup_failed.get(key, 0):
                return
            got = _lookup_indices(node, head[0])
            if got is None:
                self.lookup_failed[key] = monotonic() + LOOKUP_RETRY
                return
            self.lookup_failed.pop(key, None)
            self.indices[key] = got
        if is_connect_event(rep, *self.indices[key]):
            self.pending.add(key)
            if self.due is None:
                self.due = monotonic() + DEBOUNCE

    def held_off(self, key: Tuple[str, int]) -> bool:
        _, _, outdir, state = _paths()
        entry = load_names(state / "names").get(key)
        if not entry:
            return False
        try:
            readings = parse_lines((outdir / "battery").read_text())
        except OSError:
            return False
        now = time.time()
        return any(r.name == entry[1] and r.percent is not None and r.state != "not reachable"
                   and 0 <= now - r.read_epoch < HOLD_OFF for r in readings)

    def fire(self) -> None:
        keys, self.pending, self.due = sorted(self.pending), set(), None
        wanted = [k for k in keys if not self.held_off(k)]
        if not wanted:
            return
        log("connected", ", ".join(f"{p} slot {s}" for p, s in wanted) + ", reading")
        (self.read or read_batteries)()

    def step(self) -> None:
        if monotonic() >= self.next_scan:
            self.rescan()
            self.next_scan = monotonic() + RESCAN
        until = self.next_scan if self.due is None else min(self.next_scan, self.due)
        by_listener = {lst: node for node, (lst, _) in self.nodes.items()}
        for lst in self.wait(list(by_listener), until - monotonic()):
            node = by_listener[lst]
            if node not in self.nodes:
                continue
            phys = self.nodes[node][1]
            try:
                rep = lst.read()
            except BlockingIOError:
                continue
            except OSError as e:
                self._drop(node, e.strerror or str(e))
                continue
            try:
                self.on_report(node, phys, rep)
            except Exception as e:  # noqa: BLE001 - device data is untrusted
                log(str(node), f"{type(e).__name__}: {e}")
        if self.due is not None and monotonic() >= self.due:
            try:
                self.fire()
            except Exception as e:  # noqa: BLE001 - the watcher must keep running
                log("reading", f"{type(e).__name__}: {e}")

    def run(self) -> None:
        while True:
            try:
                self.step()
            except Exception as e:  # noqa: BLE001 - the watcher must keep running
                log("watch", f"{type(e).__name__}: {e}")
                time.sleep(1)


def watch() -> int:
    Watcher().run()
    return 0


def main(argv: Sequence[str] = ()) -> int:
    argv = list(argv)
    if not argv:
        return read_batteries()
    if argv == ["watch"]:
        return watch()
    print("usage: peripheral-battery [watch]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
