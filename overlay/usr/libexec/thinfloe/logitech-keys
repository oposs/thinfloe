#!/usr/bin/env python3
"""
logitech-keys - send the microphone mute key of Logi Bolt keyboards as F20

The mic-mute key of a Logi Bolt keyboard (MX Mechanical) sends nothing by
itself: the keyboard reports it only after host software diverts control
CID 0x011C (measured on the MX Mechanical) of REPROG_CONTROLS_V4 (0x1B04).
This program finds that control in a paired slot, diverts it (setCidReporting
without the persist bits, so the keyboard forgets it at power-off) and turns
each press of the diverted-buttons event into KEY_F20 on a uinput device
named "ThinFloe Logitech keys". F20 is a key no keyboard has and no program
binds, so it reaches the menu's mute handling unchanged.

This file holds the HID++ and uinput parts. It reuses the transport and
request code of peripheral-battery, under a software id of its own (0x0B;
the battery reader has 0x0A), so the two never take each other's replies.
Needs root. TF_PERIPHERAL_BATTERY names the battery reader (default
/usr/libexec/thinfloe/peripheral-battery).
"""

import fcntl
import importlib.machinery
import importlib.util
import os
import signal
import struct
import sys
import time
from typing import Dict, List, Optional, Sequence, Set, Tuple

MIC_CID = 0x011C
KEY_F20 = 190
REPROG = 0x1B04
SWID = 0x0B
DIVERTABLE = 0x20       # getCidInfo flags: the control can be diverted
RESCAN = 30.0           # how often the program looks for HID++ nodes and new slots
LOCK_WAIT = 2.0         # how long a request waits for the battery reader's lock
LOCK_POLL = 0.1
PROBE_GAP = 5.0         # a slot that reports but is not diverted is probed this often at most

EV_SYN, EV_KEY = 0, 1
UI_SET_EVBIT = 0x40045564
UI_SET_KEYBIT = 0x40045565
UI_DEV_SETUP = 0x405C5503
UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502
DEVICE_NAME = b"ThinFloe Logitech keys"
BUS_USB = 3
EVENT = "llHHi"         # struct input_event: time (sec, usec), type, code, value


def _load_battery():
    path = os.environ.get("TF_PERIPHERAL_BATTERY", "/usr/libexec/thinfloe/peripheral-battery")
    loader = importlib.machinery.SourceFileLoader("peripheral_battery", path)
    spec = importlib.util.spec_from_loader("peripheral_battery", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


pb = _load_battery()
pb.SWID = SWID      # _feature_call reads the module global at call time


def log(what: str, why: str) -> None:
    print(f"thinfloe: logitech-keys: {what}: {why}", file=sys.stderr)


def take_lock(state):
    """The locked fd of the battery reader's lock file, waiting up to
    LOCK_WAIT; None when it cannot be had. A busy lock is not logged here
    (the caller logs it once per fault); a real open or flock error is. The wait is short so a
    long battery read does not stall the key. Closing the fd frees the lock."""
    lockpath = state / "lock"
    try:
        lockfd = os.open(str(lockpath), os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    except OSError as e:
        log(str(lockpath), e.strerror or str(e))
        return None
    give_up = time.monotonic() + LOCK_WAIT
    while True:
        try:
            fcntl.flock(lockfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lockfd
        except BlockingIOError:
            if time.monotonic() >= give_up:
                os.close(lockfd)
                return None
            time.sleep(LOCK_POLL)
        except OSError as e:
            os.close(lockfd)
            log(str(lockpath), e.strerror or str(e))
            return None


def scan_mic(t, slot: int, deadline: float):
    """The 0x1B04 feature index when the slot has a divertable MIC_CID; False
    when the device answered everything and has none; None when a reply
    failed. Asks only the root getFeature, getCount and getCidInfo."""
    idx = pb._feature_index(t, slot, REPROG, deadline)
    if idx is None:
        return None
    if idx == 0:
        return False
    r = pb._feature_call(t, slot, idx, 0, b"", deadline)
    if not r:
        return None
    for n in range(r[0]):
        info = pb._feature_call(t, slot, idx, 1, bytes([n]), deadline)
        if not info or len(info) < 5:
            return None
        if (info[0] << 8 | info[1]) == MIC_CID:
            return idx if info[4] & DIVERTABLE else False
    return False


def find_mic(t, slot: int, deadline: float) -> Optional[int]:
    """The 0x1B04 feature index when the slot has a divertable MIC_CID, else
    None. A failed reply mid-scan also gives None; Keys does not record such
    a slot, so the next rescan asks again."""
    return scan_mic(t, slot, deadline) or None


def set_divert(t, slot: int, idx: int, on: bool, deadline: float) -> bool:
    """setCidReporting for MIC_CID: divert flag only, never the persist bits."""
    params = bytes([MIC_CID >> 8, MIC_CID & 0xFF, 0x03 if on else 0x02])
    return bool(pb._feature_call(t, slot, idx, 3, params, deadline))


def mic_down(rep: bytes, slot: int, idx: int) -> Optional[bool]:
    """For a diverted-buttons event of feature index idx from the given slot:
    whether MIC_CID is among the pressed controls (CIDs in pairs from byte 4).
    None for any other report, including one from another slot."""
    head = pb.event_head(rep)
    if head is None or head != (slot, idx):
        return None
    cids = struct.unpack(">4H", bytes(rep[4:12]).ljust(8, b"\0"))
    return MIC_CID in cids


class Uinput:
    """A keyboard device that can send KEY_F20 only."""

    def __init__(self, path: str = "/dev/uinput"):
        self.fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, KEY_F20)
            setup = struct.pack("HHHH80sI", BUS_USB, 0, 0, 1, DEVICE_NAME, 0)
            fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
            fcntl.ioctl(self.fd, UI_DEV_CREATE)
        except OSError:
            os.close(self.fd)
            raise

    def _event(self, kind: int, code: int, value: int) -> None:
        now = time.time()
        sec = int(now)
        os.write(self.fd, struct.pack(EVENT, sec, int((now - sec) * 1e6), kind, code, value))

    def key(self, code: int, down: bool) -> None:
        self._event(EV_KEY, code, 1 if down else 0)
        self._event(EV_SYN, 0, 0)

    def close(self) -> None:
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        finally:
            os.close(self.fd)


class Keys:
    """Diverts the mic key of every paired keyboard behind the HID++ nodes and
    turns its presses into one shared KEY_F20. The collaborators can be
    replaced for tests; the defaults are the battery reader's."""

    def __init__(self, uinput, find_nodes=None, open_listener=None,
                 open_transport=None, wait=None, take_lock=take_lock):
        self.uinput = uinput
        self.take_lock = take_lock
        self.find_nodes = find_nodes or (lambda: pb.find_hidpp_nodes(*pb._paths()[:2]))
        self.open_listener = open_listener or (lambda node: pb.open_listener(node))
        self.open_transport = open_transport or (lambda node: pb.open_transport(node))
        self.wait = wait or (lambda listeners, timeout: pb.wait_readable(listeners, timeout))
        self.nodes: Dict[object, Tuple[object, str]] = {}     # node -> (listener, HID_PHYS)
        self.slots: Dict[Tuple[str, int], Tuple[object, int, Optional[int]]] = {}
        # (HID_PHYS, slot) -> (node, 0x1B04 index, 0x1D4B index)
        self.down: Set[Tuple[str, int]] = set()     # slots whose mic key is held
        self.f20 = False                            # F20 is down on the uinput device
        self.no_mic: Set[Tuple[str, int]] = set()   # slots that answered fully and have no divertable mic
        self.last_probe: Dict[Tuple[str, int], float] = {}
        self.warned: Dict[str, str] = {}            # source -> the message logged for it
        self.next_scan = pb.monotonic()

    def _warn(self, what: str, why: str) -> None:
        """One journal line per fault, so a repeating fault does not fill the
        log; _ok(what) lets the next fault of that source be logged again."""
        if self.warned.get(what) != why:
            self.warned[what] = why
            log(what, why)

    def _ok(self, what: str) -> None:
        self.warned.pop(what, None)

    def _with_transport(self, node, work):
        """Run work(transport, deadline) under the battery reader's lock; the
        lock is let go before this returns. None when the lock is busy or the
        node cannot be opened (logged once)."""
        lockfd = self.take_lock(pb._paths()[3])
        if lockfd is None:
            self._warn(str(node), "lock busy, trying again later")
            return None
        t = None
        try:
            t = self.open_transport(node)
            got = work(t, pb.monotonic() + pb.RUN_BUDGET)
            self._ok(str(node))
            return got
        except OSError as e:
            self._warn(str(node), e.strerror or str(e))
            return None
        finally:
            if t is not None and hasattr(t, "close"):
                try:
                    t.close()
                except OSError:
                    pass
            os.close(lockfd)

    # -- the key

    def _sync_key(self) -> None:
        """F20 follows 'some slot is down', sent on change only."""
        want = bool(self.down)
        if want == self.f20:
            return
        self.f20 = want
        try:
            self.uinput.key(KEY_F20, want)
            self._ok("uinput")
        except OSError as e:
            self._warn("uinput", e.strerror or str(e))

    def _release(self, phys: str, slot: Optional[int] = None) -> None:
        self.down = {k for k in self.down if k[0] != phys or (slot is not None and k[1] != slot)}
        self._sync_key()

    # -- nodes and slots

    def rescan(self) -> None:
        found = dict(self.find_nodes())
        for node in [n for n in self.nodes if n not in found]:
            self._drop(node, None)
        for node, phys in found.items():
            if node not in self.nodes:
                try:
                    self.nodes[node] = (self.open_listener(node), phys)
                except OSError as e:
                    self._warn(str(node), e.strerror or str(e))
                    continue
            self._divert_new_slots(node, phys)

    def _divert_new_slots(self, node, phys: str, only: Optional[int] = None) -> None:
        """Every paired slot (receiver register b5/50+n, as the battery reader
        decides it) that is neither recorded nor known to have no mic key, or
        just slot `only`: find the control, divert it, record it. A slot that
        did not answer stays unrecorded, so the next rescan asks again; one
        that answered fully without a divertable mic key is not asked again."""
        def work(t, deadline):
            for slot in ([only] if only else range(1, 7)):
                key = (phys, slot)
                if key in self.slots or key in self.no_mic:
                    continue
                info = pb._receiver_register(t, 0x50 + slot, 0, deadline)
                if info is False or info is None:
                    continue
                idx = scan_mic(t, slot, deadline)
                if idx is None:
                    continue
                if idx is False:
                    self.no_mic.add(key)
                    continue
                ws = pb._feature_index(t, slot, pb.WIRELESS_STATUS, deadline) or None
                if not set_divert(t, slot, idx, True, deadline):
                    self._warn(f"{phys} slot {slot}", "no answer to the divert request")
                    continue
                self._ok(f"{phys} slot {slot}")
                self.slots[key] = (node, idx, ws)
            return True
        try:
            self._with_transport(node, work)
        except Exception as e:  # noqa: BLE001 - device data is untrusted
            self._warn(str(node), f"{type(e).__name__}: {e}")

    def _drop(self, node, why: Optional[str]) -> None:
        listener, phys = self.nodes.pop(node)
        if why:
            log(str(node), why)
        try:
            listener.close()
        except OSError:
            pass
        for key in [k for k in self.slots if k[0] == phys]:
            del self.slots[key]
        self.no_mic = {k for k in self.no_mic if k[0] != phys}
        self.last_probe = {k: v for k, v in self.last_probe.items() if k[0] != phys}
        self._release(phys)

    def _on_report(self, node, phys: str, rep: bytes) -> None:
        head = pb.event_head(rep)
        if head is None:
            return
        key = (phys, head[0])
        if key not in self.slots:
            # A keyboard that slept at start talks again: do not wait for the rescan.
            now = pb.monotonic()
            if key not in self.no_mic and now - self.last_probe.get(key, -PROBE_GAP) >= PROBE_GAP:
                self.last_probe[key] = now
                self._divert_new_slots(node, phys, only=head[0])
            return
        node, idx, ws = self.slots[key]
        if ws is not None and head[1] == ws:
            if rep[4] == 0x01:
                # The keyboard woke up or reconnected and forgot the divert.
                self._release(phys, head[0])
                if self._with_transport(node, lambda t, d: set_divert(t, head[0], idx, True, d)):
                    self._ok(f"{phys} slot {head[0]}")
                else:
                    # Forget the slot: the next rescan finds and diverts it again.
                    del self.slots[key]
                    self._warn(f"{phys} slot {head[0]}", "no answer to the divert request, trying again at the next rescan")
            return
        pressed = mic_down(rep, head[0], idx)
        if pressed is None:
            return
        if pressed:
            self.down.add(key)
        else:
            self.down.discard(key)
        self._sync_key()

    def step(self, timeout: float) -> None:
        """Rescan when it is time, then handle the reports that arrive within
        timeout seconds."""
        if pb.monotonic() >= self.next_scan:
            self.next_scan = pb.monotonic() + RESCAN
            try:
                self.rescan()
            except Exception as e:  # noqa: BLE001 - the program must keep running
                log("rescan", f"{type(e).__name__}: {e}")
        by_listener = {lst: node for node, (lst, _) in self.nodes.items()}
        for lst in self.wait(list(by_listener), max(0.0, min(timeout, self.next_scan - pb.monotonic()))):
            node = by_listener[lst]
            if node not in self.nodes:
                continue
            try:
                rep = lst.read()
            except BlockingIOError:
                continue
            except OSError as e:
                self._drop(node, e.strerror or str(e))
                continue
            try:
                self._on_report(node, self.nodes[node][1], rep)
            except Exception as e:  # noqa: BLE001 - device data is untrusted
                log(str(node), f"{type(e).__name__}: {e}")

    def stop(self) -> None:
        """Give the key back: release a held F20, undivert every recorded
        slot (a node that is gone is logged and skipped), close the nodes and
        the uinput device."""
        self.down.clear()
        self._sync_key()
        by_node: Dict[object, List[Tuple[str, int, int]]] = {}
        for (phys, slot), (node, idx, _) in self.slots.items():
            by_node.setdefault(node, []).append((phys, slot, idx))

        def undivert(items):
            def work(t, deadline):
                for phys, slot, idx in items:
                    if not set_divert(t, slot, idx, False, deadline):
                        self._warn(f"{phys} slot {slot}", "no answer to the undivert request")
                return True
            return work
        for node, items in by_node.items():
            try:
                self._with_transport(node, undivert(items))
            except Exception as e:  # noqa: BLE001 - stopping must go on
                self._warn(str(node), f"{type(e).__name__}: {e}")
        self.slots.clear()
        for listener, _ in self.nodes.values():
            try:
                listener.close()
            except OSError:
                pass
        self.nodes.clear()
        try:
            self.uinput.close()
        except OSError as e:
            log("uinput", e.strerror or str(e))


def main(argv: Sequence[str] = ()) -> int:
    if list(argv):
        print("usage: logitech-keys", file=sys.stderr)
        return 2
    try:
        uinput = Uinput()
    except OSError as e:
        log("uinput", e.strerror or str(e))
        return 1
    keys = Keys(uinput)
    stopping = []
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_, s=sig: stopping.append(s))
    while not stopping:
        try:
            keys.step(1.0)
        except Exception as e:  # noqa: BLE001 - the program must keep running
            log("run", f"{type(e).__name__}: {e}")
            time.sleep(1)
    keys.stop()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
