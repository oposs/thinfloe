#!/bin/bash
# Set the system time zone from the TIMEZONE= line (DHCP option 101) in
# networkd's lease files. Runs as root on a value any DHCP server on the LAN
# can send, so the value is checked before anything uses it:
#   - 1 to 64 characters from letters, digits and / _ + -
#   - no ".." and no leading "/" or "-"
#   - names a regular TZif file under the zoneinfo directory, and the file
#     really lives there once symlinks are resolved
# Anything else is logged, cut and with control characters replaced, and
# changes nothing.
#
# Without arguments it reads the leases once. With --watch (the service) it
# runs until stopped: it arms an inotify watch on the lease directory first,
# then reads the leases, then reads them again after every change. A change
# made while a read runs waits in the watch's queue, so none is lost (a path
# unit stops watching while its service runs). If the directory is not there
# yet, it waits for networkd to create it; it never creates it itself. It
# exits 1 when inotifywait ends, so systemd starts it again.
#
# THINFLOE_LEASE_DIR and THINFLOE_ZONEINFO_DIR exist for the offline test.
set -u
export LC_ALL=C

LEASE_DIR=${THINFLOE_LEASE_DIR:-/run/systemd/netif/leases}
ZONEINFO=${THINFLOE_ZONEINFO_DIR:-/usr/share/zoneinfo}

# The value as one printable, cut line: no control characters reach the journal.
safe() {
    printf '%s' "${1:0:64}" | tr -c '[:print:]' '?'
}

ignored() {
    printf "thinfloe: ignored DHCP time zone '%s': %s\n" "$(safe "$1")" "$2"
}

# Prints the reason and fails when $1 is not an acceptable zone name.
check() {
    local zone=$1 file root real magic
    if [ -z "$zone" ] || [ "${#zone}" -gt 64 ]; then
        echo "not 1 to 64 characters"; return 1
    fi
    case $zone in
        *[!A-Za-z0-9/_+-]*) echo "characters outside letters, digits and / _ + -"; return 1 ;;
        *..*|/*|-*) echo "not a plain zone name"; return 1 ;;
    esac
    file=$ZONEINFO/$zone
    if [ -d "$file" ]; then echo "a directory, not a zone"; return 1; fi
    if [ ! -f "$file" ]; then echo "no such zone in $ZONEINFO"; return 1; fi
    root=$(realpath -e -- "$ZONEINFO") || { echo "no zone database"; return 1; }
    real=$(realpath -e -- "$file") || { echo "no such zone in $ZONEINFO"; return 1; }
    case $real in
        "$root"/*) ;;
        *) echo "points outside $ZONEINFO"; return 1 ;;
    esac
    IFS= read -r -N 4 magic <"$real" 2>/dev/null
    if [ "$magic" != "TZif" ]; then echo "not a time zone file"; return 1; fi
    return 0
}

# The zone this process set last; scan logs only a different one.
LAST=

# Read every lease and apply its TIMEZONE=.
scan() {
    local lease value line why
    for lease in "$LEASE_DIR"/*; do
        [ -f "$lease" ] || continue
        value=
        while IFS= read -r line || [ -n "$line" ]; do
            case $line in
                TIMEZONE=*) value=${line#TIMEZONE=}; break ;;
            esac
        done <"$lease"
        [ -n "$value" ] || continue
        if why=$(check "$value"); then
            if timedatectl set-timezone -- "$value"; then
                # A renewal repeats the zone every few hours: log changes only.
                [ "$value" = "$LAST" ] || echo "thinfloe: time zone $value from DHCP"
                LAST=$value
            else
                echo "thinfloe: could not set DHCP time zone '$value'"
            fi
        else
            ignored "$value" "$why"
        fi
    done
}

WATCH_PID=
# watch_start EVENTS DIR: run inotifywait -m on DIR as the coprocess W and
# return once its watch is armed; fail when inotifywait ends before that.
watch_start() {
    local line
    coproc W (exec inotifywait -m -e "$1" --format '%e %f' -- "$2" 2>&1)
    WATCH_PID=$W_PID
    while IFS= read -r line <&"${W[0]}"; do
        case $line in
            "Watches established.") return 0 ;;
            "Setting up watches.") ;;
            *) printf 'thinfloe: dhcp-timezone: %s\n' "$(safe "$line")" ;;
        esac
    done
    return 1
}

watch_stop() {
    [ -n "$WATCH_PID" ] || return 0
    kill "$WATCH_PID" 2>/dev/null
    wait "$WATCH_PID" 2>/dev/null
    WATCH_PID=
}

watch() {
    trap watch_stop EXIT
    trap 'exit 143' TERM
    trap 'exit 130' INT
    if [ ! -d "$LEASE_DIR" ]; then
        # Arm on the parent, then look, so a directory made in between is
        # not missed.
        watch_start create,moved_to "${LEASE_DIR%/*}" || exit 1
        while [ ! -d "$LEASE_DIR" ]; do
            IFS= read -r _ <&"${W[0]}" || exit 1
        done
        watch_stop
    fi
    watch_start close_write,moved_to,create,delete "$LEASE_DIR" || exit 1
    scan
    while IFS= read -r _ <&"${W[0]}"; do
        # One lease write is several events: wait for 0.5 s of quiet, then
        # read the leases once for all of them.
        while IFS= read -r -t 0.5 _ <&"${W[0]}"; do :; done
        scan
    done
    exit 1
}

case ${1:-} in
    --watch) watch ;;
    "") scan; exit 0 ;;
    *) echo "usage: dhcp-timezone [--watch]" >&2; exit 2 ;;
esac
