#!/bin/bash
# Set the system time zone from the TIMEZONE= line (DHCP option 101) in
# networkd's lease files, and hand the NTP= servers (DHCP option 42) to
# chrony in /run/chrony-dhcp/thinfloe.sources (chrony reads that directory;
# only dhclient hooks or NetworkManager would fill it otherwise). A zone or
# NTP servers set in the menu (/etc/thinfloe/time, written by the initramfs
# and thinfloe-time) win: the DHCP zone is then not set, and the DHCP
# servers file is removed. Runs as root on a value any DHCP server on the LAN
# can send, so the value is checked before anything uses it:
#   - 1 to 64 characters from letters, digits and / _ + -
#   - no ".." and no leading "/" or "-"
#   - names a regular TZif file under the zoneinfo directory, and the file
#     really lives there once symlinks are resolved
# Anything else is logged, cut and with control characters replaced, and
# changes nothing.
#
# Without arguments it reads the leases once. With --watch (the service) it
# runs until stopped: it arms an inotify watch on the lease directory first,
# then reads the leases, then reads them again after every change. A change
# made while a read runs waits in the watch's queue, so none is lost (a path
# unit stops watching while its service runs). If the directory is not there
# yet, it waits for networkd to create it; it never creates it itself. It
# exits 1 when inotifywait ends or the directory goes, so systemd starts it
# again; a stop (SIGTERM) exits 0.
#
# The THINFLOE_*_DIR and THINFLOE_TIME_FILE variables exist for the
# offline test.
set -u
export LC_ALL=C

LEASE_DIR=${THINFLOE_LEASE_DIR:-/run/systemd/netif/leases}
ZONEINFO=${THINFLOE_ZONEINFO_DIR:-/usr/share/zoneinfo}
TIME_FILE=${THINFLOE_TIME_FILE:-/etc/thinfloe/time}
STATE_DIR=${THINFLOE_STATE_DIR:-/run/thinfloe/state}
CHRONY_DHCP=${THINFLOE_CHRONY_DHCP_DIR:-/run/chrony-dhcp}
MAX_SERVERS=8

# The value as one printable line cut to $2 (default 64) characters: no
# control characters reach the journal.
safe() {
    printf '%s' "${1:0:${2:-64}}" | tr -c '[:print:]' '?'
}

ignored() {
    printf "thinfloe: ignored DHCP time zone '%s': %s\n" "$(safe "$1")" "$2"
}

# Prints the reason and fails when $1 is not an acceptable zone name.
check() {
    local zone=$1 file root real magic
    if [ -z "$zone" ] || [ "${#zone}" -gt 64 ]; then
        echo "not 1 to 64 characters"; return 1
    fi
    case $zone in
        *[!A-Za-z0-9/_+-]*) echo "characters outside letters, digits and / _ + -"; return 1 ;;
        *..*|/*|-*) echo "not a plain zone name"; return 1 ;;
    esac
    file=$ZONEINFO/$zone
    if [ -d "$file" ]; then echo "a directory, not a zone"; return 1; fi
    if [ ! -f "$file" ]; then echo "no such zone in $ZONEINFO"; return 1; fi
    root=$(realpath -e -- "$ZONEINFO") || { echo "no zone database"; return 1; }
    real=$(realpath -e -- "$file") || { echo "no such zone in $ZONEINFO"; return 1; }
    case $real in
        "$root"/*) ;;
        *) echo "points outside $ZONEINFO"; return 1 ;;
    esac
    IFS= read -r -N 4 magic <"$real" 2>/dev/null
    if [ "$magic" != "TZif" ]; then echo "not a time zone file"; return 1; fi
    return 0
}

# Fails unless $1 is an IPv4 or IPv6 address (networkd writes addresses).
ntp_ok() {
    local a=$1 o
    [ -n "$a" ] && [ "${#a}" -le 45 ] || return 1
    case $a in
        *:*)
            case $a in *[!0-9A-Fa-f:.]*|*:::*) return 1 ;; esac
            return 0 ;;
        *[!0-9.]*|.*|*.|*..*) return 1 ;;
    esac
    local IFS=.
    set -- $a
    [ $# -eq 4 ] || return 1
    for o in "$@"; do
        [ "${#o}" -le 3 ] && [ "$((10#$o))" -le 255 ] || return 1
    done
}

# The menu's setting: MENU_ZONE, and MENU_NTP=yes when it names servers.
read_menu() {
    local line
    MENU_ZONE= MENU_NTP=
    [ -f "$TIME_FILE" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
            zone=*) MENU_ZONE=${line#zone=} ;;
            ntp=*) MENU_NTP=yes ;;
        esac
    done <"$TIME_FILE"
}

# Bring the DHCP sources file to $1 (empty: absent); reload chrony and log
# on a change only.
set_ntp() {
    local want=$1 have= file=$CHRONY_DHCP/thinfloe.sources tmp
    [ -f "$file" ] && have=$(<"$file")
    [ "$want" = "$have" ] && return 0
    if [ -z "$want" ]; then
        rm -f -- "$file"
        echo "thinfloe: no NTP servers from DHCP"
    else
        mkdir -p -- "$CHRONY_DHCP" && tmp=$(mktemp -- "$CHRONY_DHCP/.thinfloe.XXXXXX") \
            && printf '%s\n' "$want" >"$tmp" && chmod 644 -- "$tmp" && mv -f -- "$tmp" "$file" \
            || { echo "thinfloe: could not write $file"; rm -f -- "${tmp:-}"; return 0; }
        echo "thinfloe: NTP servers ${NTP_LIST# } from DHCP"
    fi
    chronyc reload sources >/dev/null 2>&1 || echo "thinfloe: chronyc reload sources failed"
}

# The zone this process set last; scan logs only a different one. SKIPPED:
# the DHCP zone last logged as not used.
LAST=
SKIPPED=

# Read every lease and set the zone of the last one, in glob order, that
# carries a valid zone: with two links that disagree, that zone is the one
# left set, so it is the only one set and logged.
scan() {
    local lease value line why zone= ntp a want= n=0
    local -a addrs
    NTP_LIST=
    read_menu
    for lease in "$LEASE_DIR"/*; do
        [ -f "$lease" ] || continue
        value= ntp=
        while IFS= read -r line || [ -n "$line" ]; do
            case $line in
                TIMEZONE=*) value=${line#TIMEZONE=} ;;
                NTP=*) ntp=${line#NTP=} ;;
            esac
        done <"$lease"
        read -r -a addrs <<<"$ntp"
        for a in "${addrs[@]}"; do
            if ! ntp_ok "$a"; then
                printf "thinfloe: ignored DHCP NTP server '%s': not an IP address\n" "$(safe "$a")"
            elif [ "$n" -lt "$MAX_SERVERS" ]; then
                case "$NTP_LIST " in
                    *" $a "*) ;;
                    *) NTP_LIST="$NTP_LIST $a"; n=$((n + 1)) ;;
                esac
            fi
        done
        [ -n "$value" ] || continue
        if why=$(check "$value"); then
            zone=$value
        else
            ignored "$value" "$why"
        fi
    done
    if [ -z "$MENU_NTP" ]; then
        for a in $NTP_LIST; do
            want="$want${want:+$'\n'}server $a iburst"
        done
    fi
    set_ntp "$want"
    [ -n "$zone" ] || return 0
    if [ -n "$MENU_ZONE" ]; then
        [ "$zone" = "$SKIPPED" ] || echo "thinfloe: DHCP time zone $zone not used: the zone is set in the menu"
        SKIPPED=$zone
        return 0
    fi
    SKIPPED=
    if timedatectl set-timezone -- "$zone"; then
        # A renewal repeats the zone every few hours: log changes only.
        [ "$zone" = "$LAST" ] || echo "thinfloe: time zone $zone from DHCP"
        LAST=$zone
        mkdir -p -- "$STATE_DIR" && printf '%s\n' "$zone" >"$STATE_DIR/dhcp-timezone.new" \
            && mv -f -- "$STATE_DIR/dhcp-timezone.new" "$STATE_DIR/dhcp-timezone"
    else
        echo "thinfloe: could not set DHCP time zone '$zone'"
    fi
}

WATCH_PID=
WATCH_FD=
# watch_start EVENTS DIR: run inotifywait -m on DIR, its output on WATCH_FD,
# and return once its watch is armed; fail when inotifywait ends before that.
watch_start() {
    local line
    exec {WATCH_FD}< <(exec inotifywait -m -e "$1" --format '%e %f' -- "$2" 2>&1)
    WATCH_PID=$!
    while IFS= read -r line <&"$WATCH_FD"; do
        case $line in
            "Watches established.") return 0 ;;
            "Setting up watches.") ;;
            *) printf 'thinfloe: dhcp-timezone: %s\n' "$(safe "$line" 200)" ;;
        esac
    done
    return 1
}

watch_stop() {
    [ -n "$WATCH_PID" ] || return 0
    kill "$WATCH_PID" 2>/dev/null
    exec {WATCH_FD}<&-
    wait "$WATCH_PID" 2>/dev/null
    WATCH_PID=
}

# next_event [-t SECONDS]: read one event line. Exits 1 when the watched
# directory itself is removed or moved: the watch is gone with it, and the
# restart starts over.
next_event() {
    local event
    IFS= read -r "$@" event <&"$WATCH_FD" || return 1
    case $event in
        DELETE_SELF*|MOVE_SELF*) exit 1 ;;
    esac
}

watch() {
    local parent=${LEASE_DIR%/*}
    trap watch_stop EXIT
    # A stop is a clean exit: systemd counts status 143 as a failure.
    trap 'exit 0' TERM INT
    if [ ! -d "$LEASE_DIR" ]; then
        if [ ! -d "$parent" ]; then
            echo "thinfloe: dhcp-timezone: no directory $(safe "$parent" 200) to wait in for the leases"
            exit 1
        fi
        # Arm on the parent, then look, so a directory made in between is
        # not missed.
        watch_start create,moved_to,delete_self,move_self "$parent" || exit 1
        while [ ! -d "$LEASE_DIR" ]; do
            next_event || exit 1
        done
        watch_stop
    fi
    watch_start close_write,moved_to,create,delete,delete_self,move_self "$LEASE_DIR" || exit 1
    scan
    while next_event; do
        # One lease write is several events: wait for 0.5 s of quiet, then
        # read the leases once for all of them.
        while next_event -t 0.5; do :; done
        scan
    done
    exit 1
}

case ${1:-} in
    --watch) watch ;;
    "") scan; exit 0 ;;
    *) echo "usage: dhcp-timezone [--watch]" >&2; exit 2 ;;
esac
