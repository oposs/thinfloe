#!/bin/sh
# Make labwc's title bars follow the scale thinfloe-menu chose.
#
# Usage: labwc-scale [--wait SECONDS] [--once]     (--wait default 15)
#
# labwc runs every output at scale 1, so its title bars stay small on a HiDPI
# screen. thinfloe-menu writes its scale to $XDG_RUNTIME_DIR/thinfloe-scale
# (TF_SCALE_FILE overrides the path): one number from 0.5 to 8, same rule as
# thinfloe-terminal. This helper waits for that file, then in the composed
# config dir $XDG_RUNTIME_DIR/thinfloe-labwc (TF_LABWC_DIR) replaces the
# symlinks rc.xml and themerc-override by scaled copies and runs
# "labwc --reconfigure" (TF_LABWC overrides the command). /etc/thinfloe/labwc
# is never edited.
#
#   rc.xml           the size="10" of each <font place=...> line becomes
#                    round(10 * scale), in points (<theme><font size>)
#   themerc-override these keys become round(value * scale); a key the file
#                    lacks is appended with labwc 0.9.3's default as value
#                    (docs/labwc-theme.5.scd):
#                      padding.height                    4 in the file
#                      window.titlebar.padding.width     8 in the file
#                      window.titlebar.padding.height    default 0, kept as is
#                      window.button.width               default 26
#                      window.button.height              default 26
#                      window.button.spacing             default 0, kept as is
#
# The menu rewrites the file when the real window width is known, when the
# window moves to another monitor and when the scale changes. The helper
# therefore keeps running for the whole session (thinfloe-session stops it at
# the end) and reads the file once a second (TF_SCALE_POLL overrides). Each
# change is applied again, always from the system files the symlinks pointed
# at, never from the copies of the last run; a change to a scale that rounds
# to 1 puts the symlinks back. labwc is reconfigured after each change. An
# unchanged file, or one that holds no valid scale, causes nothing.
#
# With --once the helper handles the first scale and exits (for tests).
#
# Exit 0, nothing done: no usable scale file within --wait seconds, or no
# composed dir (the session fell back to /etc/thinfloe/labwc), or a first
# scale that rounds to 1. Any failure logs
# "thinfloe: title bar scale not applied: <why>" to stderr, puts the symlinks
# back (and, when labwc failed, reconfigures once more); the helper then keeps
# running and tries the same value up to 3 more times, 5 s apart
# (TF_SCALE_RETRY), then waits for the next change of the file. The menu must write
# the scale file atomically (temp file, rename): the helper reads it as soon
# as it exists. The title bars keep size 10 while nothing is applied.

wait_s=15
once=
while [ $# -gt 0 ]; do
    case $1 in
        --wait) [ -n "${2:-}" ] && wait_s=$2; shift ;;
        --once) once=1 ;;
    esac
    shift
done

scale_file=${TF_SCALE_FILE:-}
if [ -z "$scale_file" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    scale_file=$XDG_RUNTIME_DIR/thinfloe-scale
fi
dir=${TF_LABWC_DIR:-}
if [ -z "$dir" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    dir=$XDG_RUNTIME_DIR/thinfloe-labwc
fi
labwc=${TF_LABWC:-labwc}
poll=${TF_SCALE_POLL:-1}

# The scale from the file, or nothing.
read_scale() {
    [ -n "$scale_file" ] && [ -r "$scale_file" ] || return 0
    awk 'NR == 1 && NF == 1 && $1 ~ /^[0-9]+(\.[0-9]+)?$/ &&
             $1 + 0 >= 0.5 && $1 + 0 <= 8 { print $1 + 0 }' "$scale_file" 2>/dev/null
}

is_one() {
    [ "$(awk -v s="$1" 'BEGIN { print (int(s * 10 + 0.5) == 10) ? 1 : 0 }')" = 1 ]
}

scale=
tries=$(awk -v w="$wait_s" 'BEGIN { print int(w * 5) }' 2>/dev/null)
i=0
while :; do
    scale=$(read_scale)
    [ -n "$scale" ] && break
    [ "$i" -ge "${tries:-0}" ] && exit 0
    i=$((i + 1))
    sleep 0.2
done

[ -d "$dir" ] || exit 0

# The system files, taken from the links before the first replacement.
[ -L "$dir/rc.xml" ] && [ -L "$dir/themerc-override" ] || {
    echo "thinfloe: title bar scale not applied: config files are not the expected links" >&2
    exit 0
}
rc_link=$(readlink "$dir/rc.xml")
theme_link=$(readlink "$dir/themerc-override")

tmp_rc=
tmp_theme=
replaced=
restore() {
    [ -n "$tmp_rc" ] && rm -f "$tmp_rc"
    [ -n "$tmp_theme" ] && rm -f "$tmp_theme"
    tmp_rc=
    tmp_theme=
    ln -sfn "$rc_link" "$dir/rc.xml"
    ln -sfn "$theme_link" "$dir/themerc-override"
    replaced=
}
fail() {
    echo "thinfloe: title bar scale not applied: $1" >&2
    restore
    [ -n "${reload_after_restore:-}" ] && "$labwc" --reconfigure >/dev/null 2>&1
    reload_after_restore=
    return 1
}

# Scaled copies of the system files for $1, then labwc reconfigures.
apply() {
    scale=$1
    reload_after_restore=
    [ -r "$rc_link" ] && [ -r "$theme_link" ] || { fail "cannot read the system config"; return; }

    tmp_rc=$(mktemp "$dir/.rc.xml.XXXXXX") || { fail "cannot write in $dir"; return; }
    tmp_theme=$(mktemp "$dir/.themerc-override.XXXXXX") || { fail "cannot write in $dir"; return; }

    awk -v s="$scale" '
        /<font place=/ && /size="10"/ {
            sub(/size="10"/, "size=\"" int(10 * s + 0.5) "\"")
        }
        { print }' "$rc_link" >"$tmp_rc" || { fail "cannot scale rc.xml"; return; }

    awk -v s="$scale" '
        BEGIN {
            base["padding.height"] = 0
            base["window.titlebar.padding.width"] = 0
            base["window.titlebar.padding.height"] = 0
            base["window.button.width"] = 26
            base["window.button.height"] = 26
            base["window.button.spacing"] = 0
        }
        {
            key = $1
            sub(/:$/, "", key)
            if (key in base && $1 ~ /:$/ && $2 ~ /^[0-9]+$/ && NF == 2) {
                print $1 " " int($2 * s + 0.5)
                seen[key] = 1
            } else {
                print
            }
        }
        END {
            for (k in base)
                if (!(k in seen) && base[k] > 0)
                    print k ": " int(base[k] * s + 0.5)
        }' "$theme_link" >"$tmp_theme" || { fail "cannot scale themerc-override"; return; }

    chmod 644 "$tmp_rc" "$tmp_theme" 2>/dev/null
    mv -f "$tmp_rc" "$dir/rc.xml" || { fail "cannot replace rc.xml"; return; }
    tmp_rc=
    mv -f "$tmp_theme" "$dir/themerc-override" || { fail "cannot replace themerc-override"; return; }
    tmp_theme=
    replaced=1

    if ! "$labwc" --reconfigure >/dev/null 2>&1; then
        # labwc may have applied the copies in part: load the restored files too.
        reload_after_restore=1
        fail "labwc --reconfigure failed"
        return
    fi
}

# Handle one scale: the copies, or the links back when it rounds to 1.
handle() {
    if is_one "$1"; then
        if [ -n "$replaced" ]; then
            restore
            "$labwc" --reconfigure >/dev/null 2>&1
        fi
    else
        apply "$1"
    fi
}

# A failed apply is tried again for the same value: up to 3 more attempts,
# TF_SCALE_RETRY seconds apart (default 5), counted in polls. After that the
# helper waits for the file to change. Each attempt reconfigures labwc, so
# the retries are never one per poll.
retry_s=${TF_SCALE_RETRY:-5}
retry_polls=$(awk -v r="$retry_s" -v p="$poll" 'BEGIN { n = int(r / p + 0.5); print (n < 1 ? 1 : n) }' 2>/dev/null)
retry_polls=${retry_polls:-5}
retries_left=0
wait_polls=0

# handle, then arm the retry when it failed.
attempt() {
    if handle "$1"; then
        retries_left=0
    else
        wait_polls=0
    fi
}

last=$scale
retries_left=3
attempt "$scale"
[ -n "$once" ] && exit 0

while :; do
    sleep "$poll"
    scale=$(read_scale)
    if [ -n "$scale" ] && [ "$scale" != "$last" ]; then
        last=$scale
        retries_left=3
        attempt "$scale"
    elif [ "$retries_left" -gt 0 ] && [ "$scale" = "$last" ]; then
        wait_polls=$((wait_polls + 1))
        if [ "$wait_polls" -ge "$retry_polls" ]; then
            retries_left=$((retries_left - 1))
            attempt "$scale"
        fi
    fi
done
