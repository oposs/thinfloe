#!/bin/sh
# Compose a labwc config directory that merges the system defaults in
# /etc/thinfloe/labwc with the menu's generated environment and a user's
# per-machine ~/.config/thinfloe/environment, so that labwc's OWN re-read of
# the environment file (session_environment_init(), src/config/session.c)
# sees the right values LAST and keeps them.
#
# Background: 10-thinfloe-session.sh sources the files into the shell with
# "set -a" before exec'ing labwc, which is correct - but labwc, run with
# -C, does not inherit and trust that; it re-reads <config_dir>/environment
# itself and setenv()s every key with overwrite=1
# (src/common/dir.c:153-157: with -C, this is the ONLY environment file it
# considers - the XDG list is skipped entirely). So any key present in two
# files was silently reset to the earlier value the moment labwc started,
# regardless of what the shell had already exported. See
# docs/notes/session.md for the full writeup and
# test/runtime/test-labwc-runtime.sh for the assertion that a LATER
# duplicate assignment in that file is what wins - the assumption this
# script's ordering depends on.
#
# Usage: thinfloe-compose-labwc-config [--env-only] <system-dir> <generated-env> <user-env> <output-dir>
#
#   <system-dir>     e.g. /etc/thinfloe/labwc - rc.xml and the system defaults
#   <generated-env>  e.g. $HOME/.config/thinfloe/generated/environment, written
#                    by the menu - may not exist, that is not an error
#   <user-env>       e.g. $HOME/.config/thinfloe/environment - may not exist,
#                    that is not an error
#   <output-dir>     e.g. $XDG_RUNTIME_DIR/thinfloe-labwc - passed to labwc -C
#
# Every file in <system-dir> other than 'environment' and 'rc.xml' is
# symlinked into <output-dir> unchanged, so a future file added under
# /etc/thinfloe/labwc/ is picked up without touching this script. rc.xml is
# a link to <output-dir>/.source/rc.xml (see "rc.xml and .source/" below).
# 'environment' is composed as <system-dir>/environment, then
# <generated-env>, then <user-env> without the lines whose key is listed in
# ${TF_MANAGED_KEYS:-/etc/thinfloe/menu-managed-keys} (the keys the menu
# sets; the key is the text before the first "=", after leading blanks and
# an optional "export "). Comment lines are kept.
#
# Without --env-only, <output-dir> is wiped and rebuilt on every call:
# everything under it is derived from the inputs and nothing is ever
# authored there directly, so rebuilding from scratch is what makes running
# this twice idempotent instead of accumulating stale symlinks or appended
# environment lines.
#
# With --env-only, <output-dir> must already exist; 'environment' is
# rewritten (a temporary file in <output-dir>, renamed over it) and then
# .source/rc.xml, so the scaled rc.xml and themerc-override that labwc-scale
# put there survive.
#
# rc.xml and .source/:
#   rc.xml             a link to <output-dir>/.source/rc.xml, always. This is
#                      the path labwc-scale records as its source at start;
#                      once the session runs, labwc-scale is the only writer
#                      of rc.xml, and this script writes only .source/.
#   .source/base.xml   written only by the full compose (session start): a
#                      link to <system-dir>/rc.xml, or with THINFLOE_NUMLOCK=off
#                      a copy that says <numlock>off</numlock>.
#   .source/rc.xml     written by both modes. With THINFLOE_VOLUME_KEYS and
#                      THINFLOE_BRIGHTNESS_KEYS both not on, a link to
#                      .source/base.xml; otherwise base.xml with the media
#                      key bindings on the lines before </keyboard>, the only
#                      keybindings labwc gets (CLAUDE.md, "labwc must have zero
#                      keybindings"). A file that cannot be written leaves
#                      the keys off (a line on stderr, the exit status is
#                      unchanged).

set -eu

me=thinfloe-compose-labwc-config
ENV_ONLY=0
if [ "${1:-}" = "--env-only" ]; then
    ENV_ONLY=1
    shift
fi

usage() {
    echo "Usage: $me [--env-only] <system-dir> <generated-env> <user-env> <output-dir>" >&2
    exit 1
}

[ $# -eq 4 ] || usage

GEN_ENV_FILE=$2
USER_ENV_FILE=$3
OUT_DIR=$4
MANAGED_KEYS=${TF_MANAGED_KEYS:-/etc/thinfloe/menu-managed-keys}

SYSTEM_DIR=$(cd "$1" 2>/dev/null && pwd) || {
    echo "$me: cannot read system config dir '$1'" >&2
    exit 1
}

# Write the merged environment to stdout. Later lines win in labwc's parser,
# so the order is the precedence.
merged_environment() {
    if [ -r "$SYSTEM_DIR/environment" ]; then
        cat "$SYSTEM_DIR/environment"
    fi
    if [ -r "$GEN_ENV_FILE" ]; then
        cat "$GEN_ENV_FILE"
    fi
    if [ -r "$USER_ENV_FILE" ]; then
        if [ -r "$MANAGED_KEYS" ]; then
            awk '
                FNR == NR {
                    k = $0
                    sub(/^[ \t]+/, "", k)
                    sub(/[ \t\r]+$/, "", k)
                    if (k != "" && substr(k, 1, 1) != "#") managed[k] = 1
                    next
                }
                {
                    k = $0
                    sub(/^[ \t]+/, "", k)
                    if (substr(k, 1, 1) != "#") {
                        sub(/^export[ \t]+/, "", k)
                        i = index(k, "=")
                        # labwc trims the key: "KEY = v" sets KEY.
                        key = substr(k, 1, i - 1)
                        sub(/[ \t]+$/, "", key)
                        if (i > 0 && (key in managed)) next
                    }
                    print
                }
            ' "$MANAGED_KEYS" "$USER_ENV_FILE"
        else
            cat "$USER_ENV_FILE"
        fi
    fi
}

# labwc 0.9.3 segfaults at start, before the session runs, when XKB cannot
# build the layout and variant in its environment; a reconfigure then
# keeps the old keymap. The menu checks every value it writes, but a value
# already on disk can go bad (an upgrade changes the layout list) and the
# menu would never start to repair it. So the values labwc will read are
# checked here: "<checker> --check-keyboard <layout> <variant>" prints the
# lines to append (later wins) or nothing; a failing or missing checker
# changes nothing, and so does one that does not answer within
# KB_CHECK_TIMEOUT seconds (the profile runs this before labwc: a hang
# would leave tty1 without a session). The parse is labwc's
# (src/config/session.c, process_line): the last line whose key, trimmed,
# is the name; the value is the text after the first "=", trimmed, quotes
# kept.
KB_CHECK=${TF_KB_CHECK:-/usr/bin/thinfloe-menu}
KB_CHECK_TIMEOUT=${TF_KB_CHECK_TIMEOUT:-5}
check_keyboard() {
    [ -x "$KB_CHECK" ] || return 0
    _kb_l=$(env_value XKB_DEFAULT_LAYOUT "$1")
    _kb_v=$(env_value XKB_DEFAULT_VARIANT "$1")
    _kb_fix=$(timeout -k 1 "$KB_CHECK_TIMEOUT" "$KB_CHECK" --check-keyboard "$_kb_l" "$_kb_v") || return 0
    [ -n "$_kb_fix" ] || return 0
    printf '# %s: XKB cannot build the keyboard above; replaced by\n%s\n' "$me" "$_kb_fix" >>"$1"
}
env_value() {
    awk -v want="$1" '
        substr($0, 1, 1) == "#" { next }
        {
            i = index($0, "=")
            if (i == 0) next
            k = substr($0, 1, i - 1)
            gsub(/^[ \t\r]+|[ \t\r]+$/, "", k)
            if (k != want) next
            v = substr($0, i + 1)
            gsub(/^[ \t\r]+|[ \t\r]+$/, "", v)
            last = v
        }
        END { printf "%s", last }
    ' "$2"
}

# "on" in the environment file $2 for key $1: the value may be quoted, as a
# shell or the menu's rebuild reads it.
env_is() {
    case $(env_value "$1" "$2") in
        "$3" | "\"$3\"" | "'$3'") return 0 ;;
    esac
    return 1
}

# The media key bindings for the environment file $1, on stdout. The
# command goes into an XML attribute, so it is escaped.
key_bindings() {
    _kb_vol=0
    _kb_bri=0
    env_is THINFLOE_VOLUME_KEYS "$1" on && _kb_vol=1
    env_is THINFLOE_BRIGHTNESS_KEYS "$1" on && _kb_bri=1
    TF_OSD_CMD=${TF_OSD_KEY_CMD:-/usr/bin/thinfloe-menu --osd-key} \
        awk -v vol="$_kb_vol" -v bri="$_kb_bri" '
        function bind(key, action, extra) {
            printf "    <keybind key=\"%s\" allowWhenInhibited=\"yes\"%s><action name=\"Execute\" command=\"%s %s\" /></keybind>\n", key, extra, cmd, action
        }
        BEGIN {
            cmd = ENVIRON["TF_OSD_CMD"]
            gsub(/&/, "\\&amp;", cmd)
            gsub(/</, "\\&lt;", cmd)
            gsub(/>/, "\\&gt;", cmd)
            gsub(/"/, "\\&quot;", cmd)
            if (vol) {
                print "    <!-- thinfloe-compose-labwc-config: THINFLOE_VOLUME_KEYS=on -->"
                bind("XF86AudioRaiseVolume", "volume-up", "")
                bind("XF86AudioLowerVolume", "volume-down", "")
                bind("XF86AudioMute", "volume-mute", " onRelease=\"yes\"")
                bind("XF86AudioMicMute", "mic-mute", " onRelease=\"yes\"")
            }
            if (bri) {
                print "    <!-- thinfloe-compose-labwc-config: THINFLOE_BRIGHTNESS_KEYS=on -->"
                bind("XF86MonBrightnessUp", "brightness-up", "")
                bind("XF86MonBrightnessDown", "brightness-down", "")
            }
        }'
}

# .source/rc.xml for the environment file $1: the link to base.xml, or
# base.xml with the bindings inserted before the </keyboard> line.
build_source_rc() {
    _src=$OUT_DIR/.source
    _bind=$(key_bindings "$1")
    if [ -n "$_bind" ]; then
        _tmp_rc=
        if _tmp_rc=$(mktemp "$_src/.rc.xml.XXXXXX" 2>/dev/null) &&
            TF_BIND=$_bind awk '
                !done && /<\/keyboard>/ { print ENVIRON["TF_BIND"]; done = 1 }
                { print }
                END { if (!done) exit 1 }
            ' "$_src/base.xml" >"$_tmp_rc" &&
            chmod 644 "$_tmp_rc" &&
            mv -f "$_tmp_rc" "$_src/rc.xml"; then
            return 0
        fi
        [ -n "$_tmp_rc" ] && rm -f "$_tmp_rc"
        echo "$me: cannot write the key bindings; the volume and brightness keys stay off" >&2
    fi
    ln -sfn "$_src/base.xml" "$_src/rc.xml" 2>/dev/null || true
}

if [ "$ENV_ONLY" -eq 1 ]; then
    [ -d "$OUT_DIR" ] || {
        echo "$me: no composed dir '$OUT_DIR'" >&2
        exit 1
    }
    OUT_DIR=$(cd "$OUT_DIR" && pwd)
    TMP_ENV=$(mktemp "$OUT_DIR/.environment.XXXXXX") || {
        echo "$me: cannot write into '$OUT_DIR'" >&2
        exit 1
    }
    if merged_environment >"$TMP_ENV" && check_keyboard "$TMP_ENV" &&
        mv -f "$TMP_ENV" "$OUT_DIR/environment"; then
        if [ -e "$OUT_DIR/.source/base.xml" ]; then
            build_source_rc "$OUT_DIR/environment"
        else
            echo "$me: no .source/base.xml; the key switches follow at the next start" >&2
        fi
        exit 0
    fi
    rm -f "$TMP_ENV"
    echo "$me: cannot write '$OUT_DIR/environment'" >&2
    exit 1
fi

if [ -e "$OUT_DIR" ]; then
    rm -rf "$OUT_DIR" 2>/dev/null || {
        echo "$me: cannot clear existing output dir '$OUT_DIR'" >&2
        exit 1
    }
fi

mkdir -p "$OUT_DIR/.source" 2>/dev/null || {
    echo "$me: cannot create output dir '$OUT_DIR'" >&2
    exit 1
}
OUT_DIR=$(cd "$OUT_DIR" && pwd)

for entry in "$SYSTEM_DIR"/*; do
    [ -e "$entry" ] || continue   # empty dir / no glob match
    name=$(basename "$entry")
    case $name in environment | rc.xml) continue ;; esac
    ln -s "$entry" "$OUT_DIR/$name"
done

merged_environment >"$OUT_DIR/environment"
check_keyboard "$OUT_DIR/environment"

# Num Lock: labwc sets it from <numlock> in rc.xml only when a keyboard
# appears (at start, on hot-plug), never on --reconfigure, so only the full
# compose at session start acts on it, in .source/base.xml.
# THINFLOE_NUMLOCK=off (the menu's Keyboard tab, a managed key) makes
# base.xml a copy that says off; any other value, or a copy that cannot be
# written, makes it a link to the system file.
base=$OUT_DIR/.source/base.xml
ln -s "$SYSTEM_DIR/rc.xml" "$base"
if env_is THINFLOE_NUMLOCK "$OUT_DIR/environment" off && [ -r "$SYSTEM_DIR/rc.xml" ]; then
    if awk '
            # Only the element inside <keyboard> counts, not a mention in
            # a comment elsewhere; without one, it is added.
            /<keyboard>/ { in_kb = 1 }
            in_kb && /^[ \t]*<numlock>[^<]*<\/numlock>/ {
                sub(/<numlock>[^<]*<\/numlock>/, "<numlock>off</numlock>")
                seen = 1
            }
            in_kb && /<\/keyboard>/ {
                if (!seen) {
                    match($0, /^[ \t]*/)
                    print substr($0, 1, RLENGTH) "  <numlock>off</numlock>"
                    seen = 1
                }
                in_kb = 0
            }
            { print }
        ' "$SYSTEM_DIR/rc.xml" >"$OUT_DIR/.source/.base.xml.tmp" &&
        mv -f "$OUT_DIR/.source/.base.xml.tmp" "$base"; then
        :
    else
        echo "$me: cannot write the Num Lock rc.xml; Num Lock stays as the system file says" >&2
        rm -f "$OUT_DIR/.source/.base.xml.tmp"
        ln -sfn "$SYSTEM_DIR/rc.xml" "$base"
    fi
fi

build_source_rc "$OUT_DIR/environment"
ln -s "$OUT_DIR/.source/rc.xml" "$OUT_DIR/rc.xml"
