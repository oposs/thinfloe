#!/bin/sh
# Compose a labwc config directory that merges the system defaults in
# /etc/thinfloe/labwc with the menu's generated environment and a user's
# per-machine ~/.config/thinfloe/environment, so that labwc's OWN re-read of
# the environment file (session_environment_init(), src/config/session.c)
# sees the right values LAST and keeps them.
#
# Background: 10-thinfloe-session.sh sources the files into the shell with
# "set -a" before exec'ing labwc, which is correct - but labwc, run with
# -C, does not inherit and trust that; it re-reads <config_dir>/environment
# itself and setenv()s every key with overwrite=1
# (src/common/dir.c:153-157: with -C, this is the ONLY environment file it
# considers - the XDG list is skipped entirely). So any key present in two
# files was silently reset to the earlier value the moment labwc started,
# regardless of what the shell had already exported. See
# docs/notes/session.md for the full writeup and
# test/runtime/test-labwc-runtime.sh for the assertion that a LATER
# duplicate assignment in that file is what wins - the assumption this
# script's ordering depends on.
#
# Usage: thinfloe-compose-labwc-config [--env-only] <system-dir> <generated-env> <user-env> <output-dir>
#
#   <system-dir>     e.g. /etc/thinfloe/labwc - rc.xml and the system defaults
#   <generated-env>  e.g. $HOME/.config/thinfloe/generated/environment, written
#                    by the menu - may not exist, that is not an error
#   <user-env>       e.g. $HOME/.config/thinfloe/environment - may not exist,
#                    that is not an error
#   <output-dir>     e.g. $XDG_RUNTIME_DIR/thinfloe-labwc - passed to labwc -C
#
# Every file in <system-dir> other than 'environment' is symlinked into
# <output-dir> unchanged - rc.xml stays a single source of truth, and a
# future file added under /etc/thinfloe/labwc/ is picked up without touching
# this script. 'environment' is composed as <system-dir>/environment, then
# <generated-env>, then <user-env> without the lines whose key is listed in
# ${TF_MANAGED_KEYS:-/etc/thinfloe/menu-managed-keys} (the keys the menu
# sets; the key is the text before the first "=", after leading blanks and
# an optional "export "). Comment lines are kept.
#
# Without --env-only, <output-dir> is wiped and rebuilt on every call:
# everything under it is derived from the inputs and nothing is ever
# authored there directly, so rebuilding from scratch is what makes running
# this twice idempotent instead of accumulating stale symlinks or appended
# environment lines.
#
# With --env-only, <output-dir> must already exist; only 'environment' is
# rewritten (a temporary file in <output-dir>, renamed over it), so the
# scaled rc.xml and themerc-override that labwc-scale put there survive.

set -eu

me=thinfloe-compose-labwc-config
ENV_ONLY=0
if [ "${1:-}" = "--env-only" ]; then
    ENV_ONLY=1
    shift
fi

usage() {
    echo "Usage: $me [--env-only] <system-dir> <generated-env> <user-env> <output-dir>" >&2
    exit 1
}

[ $# -eq 4 ] || usage

GEN_ENV_FILE=$2
USER_ENV_FILE=$3
OUT_DIR=$4
MANAGED_KEYS=${TF_MANAGED_KEYS:-/etc/thinfloe/menu-managed-keys}

SYSTEM_DIR=$(cd "$1" 2>/dev/null && pwd) || {
    echo "$me: cannot read system config dir '$1'" >&2
    exit 1
}

# Write the merged environment to stdout. Later lines win in labwc's parser,
# so the order is the precedence.
merged_environment() {
    if [ -r "$SYSTEM_DIR/environment" ]; then
        cat "$SYSTEM_DIR/environment"
    fi
    if [ -r "$GEN_ENV_FILE" ]; then
        cat "$GEN_ENV_FILE"
    fi
    if [ -r "$USER_ENV_FILE" ]; then
        if [ -r "$MANAGED_KEYS" ]; then
            awk '
                FNR == NR {
                    k = $0
                    sub(/^[ \t]+/, "", k)
                    sub(/[ \t\r]+$/, "", k)
                    if (k != "" && substr(k, 1, 1) != "#") managed[k] = 1
                    next
                }
                {
                    k = $0
                    sub(/^[ \t]+/, "", k)
                    if (substr(k, 1, 1) != "#") {
                        sub(/^export[ \t]+/, "", k)
                        i = index(k, "=")
                        if (i > 0 && (substr(k, 1, i - 1) in managed)) next
                    }
                    print
                }
            ' "$MANAGED_KEYS" "$USER_ENV_FILE"
        else
            cat "$USER_ENV_FILE"
        fi
    fi
}

# labwc 0.9.3 segfaults at start, before the session runs, when XKB cannot
# build the layout and variant in its environment; a reconfigure then
# keeps the old keymap. The menu checks every value it writes, but a value
# already on disk can go bad (an upgrade changes the layout list) and the
# menu would never start to repair it. So the values labwc will read are
# checked here: "<checker> --check-keyboard <layout> <variant>" prints the
# lines to append (later wins) or nothing; a failing or missing checker
# changes nothing. The parse is labwc's (src/config/session.c,
# process_line): the last line whose key, trimmed, is the name; the value is
# the text after the first "=", trimmed, quotes kept.
KB_CHECK=${TF_KB_CHECK:-/usr/bin/thinfloe-menu}
check_keyboard() {
    [ -x "$KB_CHECK" ] || return 0
    _kb_l=$(env_value XKB_DEFAULT_LAYOUT "$1")
    _kb_v=$(env_value XKB_DEFAULT_VARIANT "$1")
    _kb_fix=$("$KB_CHECK" --check-keyboard "$_kb_l" "$_kb_v") || return 0
    [ -n "$_kb_fix" ] || return 0
    printf '# %s: XKB cannot build the keyboard above; replaced by\n%s\n' "$me" "$_kb_fix" >>"$1"
}
env_value() {
    awk -v want="$1" '
        substr($0, 1, 1) == "#" { next }
        {
            i = index($0, "=")
            if (i == 0) next
            k = substr($0, 1, i - 1)
            gsub(/^[ \t\r]+|[ \t\r]+$/, "", k)
            if (k != want) next
            v = substr($0, i + 1)
            gsub(/^[ \t\r]+|[ \t\r]+$/, "", v)
            last = v
        }
        END { printf "%s", last }
    ' "$2"
}

if [ "$ENV_ONLY" -eq 1 ]; then
    [ -d "$OUT_DIR" ] || {
        echo "$me: no composed dir '$OUT_DIR'" >&2
        exit 1
    }
    TMP_ENV=$(mktemp "$OUT_DIR/.environment.XXXXXX") || {
        echo "$me: cannot write into '$OUT_DIR'" >&2
        exit 1
    }
    if merged_environment >"$TMP_ENV" && check_keyboard "$TMP_ENV" &&
        mv -f "$TMP_ENV" "$OUT_DIR/environment"; then
        exit 0
    fi
    rm -f "$TMP_ENV"
    echo "$me: cannot write '$OUT_DIR/environment'" >&2
    exit 1
fi

if [ -e "$OUT_DIR" ]; then
    rm -rf "$OUT_DIR" 2>/dev/null || {
        echo "$me: cannot clear existing output dir '$OUT_DIR'" >&2
        exit 1
    }
fi

mkdir -p "$OUT_DIR" 2>/dev/null || {
    echo "$me: cannot create output dir '$OUT_DIR'" >&2
    exit 1
}

for entry in "$SYSTEM_DIR"/*; do
    [ -e "$entry" ] || continue   # empty dir / no glob match
    name=$(basename "$entry")
    [ "$name" = "environment" ] && continue
    ln -s "$entry" "$OUT_DIR/$name"
done

merged_environment >"$OUT_DIR/environment"
check_keyboard "$OUT_DIR/environment"
