#!/usr/bin/python3 -I
"""
thinfloe-network - network state and WiFi scan for the menu

The menu runs this as root (sudo -n) and reads one JSON line from stdout.

Commands:
  status   {"interfaces": [{"name", "kind": wired|wifi|wireguard,
            "state": connected|no-cable|not-connected|off, "addresses",
            "ssid", "signal_dbm", "handshake_age_s"}]}
  scan     {"device", "networks": [{"ssid", "signal_dbm", "secured",
            "supported"}]}, strongest first, at most 64
  apply    {"result": "ok", "reason": ""}: checks ~/wifi.yaml and
            ~/ethernet.yaml of the user, installs them into /etc/netplan and
            runs netplan apply

Exit 0 on success, 1 on a failure, 2 on misuse. A failure prints
{"result": "failed", "reason": "..."}. Log lines go to stderr and the journal.
"""

import errno
import fcntl
import json
import os
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys
import syslog
import tempfile
import time
from typing import List, Optional, Tuple

# Module constants; the environment overrides them for the tests.
IP = os.environ.get("TF_NETWORK_IP", "ip")
IW = os.environ.get("TF_NETWORK_IW", "iw")
WG = os.environ.get("TF_NETWORK_WG", "wg")
SYS_NET = os.environ.get("TF_NETWORK_SYS", "/sys/class/net")

DEFAULT_SCAN_TIMEOUT = 20
TOOL_TIMEOUT = 10
BUSY_WAIT = 2
MAX_NETWORKS = 64
HANDSHAKE_FRESH_S = 180

# apply: the files of the user, the installed set, and the work areas.
# HOME_DIR None means the home of tfuser.
HOME_DIR = os.environ.get("TF_NETWORK_HOME")
ETC_NETPLAN = os.environ.get("TF_NETWORK_ETC", "/etc/netplan")
DEFAULT_WIRED = os.environ.get("TF_NETWORK_DEFAULT_WIRED",
                               "/usr/share/thinfloe/netplan/ethernet.yaml")
ESP_DIR = os.environ.get("TF_NETWORK_ESP", "/run/thinfloe/storage/efi")
NETPLAN = os.environ.get("TF_NETWORK_NETPLAN", "netplan")
LOCK = os.environ.get("TF_NETWORK_LOCK", "/run/thinfloe/network.lock")
# The check root lives here, never in the home of the user.
WORK_DIR = os.environ.get("TF_NETWORK_TMP", "/run/thinfloe/network-tmp")

MAX_FILE = 64 * 1024
LOCK_WAIT = 30
GENERATE_TIMEOUT = 30
APPLY_TIMEOUT = 120
TEMPLATE_MARKER = "device name of your wifi card"
INSTALLED = ("wifi.yaml", "ethernet.yaml")

USAGE = "usage: thinfloe-network status | scan | apply"


class NetworkError(Exception):
    """A failure. The text is the reason the menu shows."""


# ============ Log ============

_syslog_open = False


def log(text: str) -> None:
    global _syslog_open
    text = "".join(c if c.isprintable() else " " for c in str(text))[:1024]
    print("thinfloe-network: " + text, file=sys.stderr, flush=True)
    try:
        if not _syslog_open:
            syslog.openlog("thinfloe-network")
            _syslog_open = True
        syslog.syslog(syslog.LOG_INFO, text)
    except OSError:
        pass


# ============ Running tools ============

def run(cmd: List[str], timeout: float = TOOL_TIMEOUT) -> Tuple[int, str, str]:
    """Run cmd in a session of its own; on timeout the whole process group is
    killed and subprocess.TimeoutExpired is raised."""
    env = dict(os.environ, LC_ALL="C")
    try:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, env=env, start_new_session=True)
    except OSError as e:
        raise NetworkError("cannot run %s: %s" % (cmd[0], e.strerror or e))
    try:
        out, err = p.communicate(timeout=timeout)
    except BaseException:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        p.communicate()
        raise
    return (p.returncode, out.decode("utf-8", "replace"), err.decode("utf-8", "replace"))


# ============ Parsing ============

def _read_text(path: str) -> Optional[str]:
    try:
        with open(path, encoding="utf-8") as f:
            return f.read(64).strip()
    except OSError:
        return None


def parse_ip(link_json: str, addr_json: str, sys_net: str) -> List[dict]:
    """The wired, WiFi and WireGuard interfaces of `ip -j -d link` and
    `ip -j -4 addr`. A WireGuard interface is not-connected here; status()
    decides from its handshake."""
    addresses = {}
    for entry in json.loads(addr_json):
        found = []
        for a in entry.get("addr_info", []):
            if a.get("family") == "inet" and "local" in a and "prefixlen" in a:
                found.append("%s/%d" % (a["local"], a["prefixlen"]))
        addresses[entry.get("ifname")] = found

    result = []
    for entry in json.loads(link_json):
        name = entry.get("ifname")
        if not isinstance(name, str) or "/" in name:
            continue
        flags = entry.get("flags", [])
        base = os.path.join(sys_net, name)
        if (entry.get("linkinfo") or {}).get("info_kind") == "wireguard":
            kind = "wireguard"
        elif os.path.exists(os.path.join(base, "wireless")):
            kind = "wifi"
        elif os.path.exists(os.path.join(base, "device")) \
                and _read_text(os.path.join(base, "type")) == "1":
            kind = "wired"
        else:
            continue
        if "UP" not in flags:
            state = "off"
        elif kind == "wired":
            state = "connected" if "LOWER_UP" in flags else "no-cable"
        else:
            state = "not-connected"
        result.append({"name": name, "kind": kind, "state": state,
                       "addresses": addresses.get(name, []),
                       "ssid": None, "signal_dbm": None, "handshake_age_s": None})
    return result


def _decode_ssid(raw: str) -> str:
    """iw prints a name with \\\\ for a backslash and \\xNN for bytes that are
    not printable ASCII."""
    out = bytearray()
    i = 0
    while i < len(raw):
        if raw[i] == "\\" and raw[i + 1:i + 2] == "\\":
            out += b"\\"
            i += 2
        elif raw[i] == "\\" and re.fullmatch(r"x[0-9a-fA-F]{2}", raw[i + 1:i + 4]):
            out.append(int(raw[i + 2:i + 4], 16))
            i += 4
        else:
            out += raw[i].encode("utf-8")
            i += 1
    return out.decode("utf-8", "replace")


def _dbm(text: str) -> Optional[int]:
    m = re.search(r"(-?\d+(?:\.\d+)?)\s*dBm", text)
    return int(round(float(m.group(1)))) if m else None


def parse_iw_link(text: str) -> Tuple[Optional[str], Optional[int]]:
    """(ssid, signal in dBm) of `iw dev <if> link`; (None, None) when the
    device is not connected."""
    ssid = signal_dbm = None
    for line in text.splitlines():
        m = re.match(r"\s*SSID: (.*)$", line)
        if m and ssid is None:
            ssid = _decode_ssid(m.group(1)) or None
        m = re.match(r"\s*signal: (.*)$", line)
        if m and signal_dbm is None:
            signal_dbm = _dbm(m.group(1))
    if ssid is None:
        return None, None
    return ssid, signal_dbm


def parse_handshake(text: str, now: int) -> Optional[int]:
    """Seconds since the latest handshake in `wg show <if> latest-handshakes`,
    None when no peer ever shook hands (0)."""
    latest = 0
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1].isdigit():
            latest = max(latest, int(parts[-1]))
    if latest == 0:
        return None
    return max(0, now - latest)


# Authentication suites (iw's spellings) that a plain password can join:
# netplan renders a password as key_mgmt=WPA-PSK WPA-PSK-SHA256 SAE, so
# wpa_supplicant joins nothing else (not FT/*, SAE-EXT-KEY, PSK/SHA-384,
# 802.1X, OWE, FILS).
PASSWORD_SUITE = re.compile(r"(?<![\w/.-])(?:PSK|PSK/SHA-256|SAE)(?![\w/.-])")


def _supported(privacy: bool, rsn_wpa: bool, suites: List[str]) -> bool:
    """May the menu join with a plain password (or without one)?
    WEP, 802.1X-only and OWE-only networks: no. Without a suites line the
    default of iw is PSK. iw normally prints a suites line, so this is rare."""
    if rsn_wpa:
        return not suites or any(PASSWORD_SUITE.search(s) for s in suites)
    return not privacy


def parse_scan(text: str) -> List[dict]:
    """The networks of `iw dev <if> scan`, strongest first, one per name."""
    blocks = []
    for line in text.splitlines():
        if line.startswith("BSS "):
            blocks.append([])
        elif blocks:
            blocks[-1].append(line)

    best = {}
    for lines in blocks:
        ssid = signal_dbm = None
        privacy = rsn_wpa = in_section = False
        suites: List[str] = []
        for line in lines:
            if in_section and line.startswith("\t\t"):
                m = re.search(r"Authentication suites: (.*)$", line)
                if m:
                    suites.append(m.group(1))
                continue
            in_section = False
            m = re.match(r"\t(SSID|signal|capability): ?(.*)$", line)
            if m:
                key, value = m.groups()
                if key == "SSID" and ssid is None:
                    ssid = _decode_ssid(value)
                elif key == "signal":
                    signal_dbm = _dbm(value)
                elif key == "capability":
                    privacy = "Privacy" in value.split()
            elif re.match(r"\t(RSN|WPA):", line):
                rsn_wpa = in_section = True
        if not ssid or not ssid.strip("\0") or signal_dbm is None:
            continue
        net = {"ssid": ssid, "signal_dbm": signal_dbm,
               "secured": rsn_wpa or privacy,
               "supported": _supported(privacy, rsn_wpa, suites)}
        if ssid not in best or signal_dbm > best[ssid]["signal_dbm"]:
            best[ssid] = net
    nets = sorted(best.values(), key=lambda n: -n["signal_dbm"])
    return nets[:MAX_NETWORKS]


# ============ Commands ============

def status() -> dict:
    try:
        rc, link, err = run([IP, "-j", "-d", "link", "show"])
        if rc != 0:
            raise NetworkError("ip link failed: %s" % err.strip())
        rc, addr, err = run([IP, "-j", "-4", "addr", "show"])
        if rc != 0:
            raise NetworkError("ip addr failed: %s" % err.strip())
        interfaces = parse_ip(link, addr, SYS_NET)
    except (ValueError, subprocess.TimeoutExpired) as e:
        raise NetworkError("cannot read the interfaces: %s" % e)

    for i in interfaces:
        if i["state"] == "off":
            continue
        try:
            if i["kind"] == "wifi":
                rc, out, _ = run([IW, "dev", i["name"], "link"])
                ssid, dbm = parse_iw_link(out) if rc == 0 else (None, None)
                if ssid is not None:
                    i["state"], i["ssid"], i["signal_dbm"] = "connected", ssid, dbm
            elif i["kind"] == "wireguard":
                rc, out, _ = run([WG, "show", i["name"], "latest-handshakes"])
                age = parse_handshake(out, int(time.time())) if rc == 0 else None
                i["handshake_age_s"] = age
                if age is not None and age <= HANDSHAKE_FRESH_S:
                    i["state"] = "connected"
        except (NetworkError, subprocess.TimeoutExpired) as e:
            log("%s: %s" % (i["name"], e))
    return {"interfaces": interfaces}


def scan_timeout() -> float:
    try:
        value = float(os.environ.get("TF_NETWORK_SCAN_TIMEOUT", DEFAULT_SCAN_TIMEOUT))
    except ValueError:
        return DEFAULT_SCAN_TIMEOUT
    return value if value > 0 else DEFAULT_SCAN_TIMEOUT


def wifi_device() -> Optional[str]:
    try:
        names = sorted(os.listdir(SYS_NET))
    except OSError:
        return None
    for name in names:
        if os.path.exists(os.path.join(SYS_NET, name, "wireless")):
            return name
    return None


def _link_is_up(dev: str) -> bool:
    rc, out, _ = run([IP, "-j", "link", "show", "dev", dev])
    try:
        return rc == 0 and "UP" in json.loads(out)[0].get("flags", [])
    except (ValueError, IndexError, AttributeError):
        return False


def scan() -> dict:
    dev = wifi_device()
    if dev is None:
        raise NetworkError("No WiFi adapter found")
    try:
        if not _link_is_up(dev):
            rc, _, err = run([IP, "link", "set", dev, "up"])
            if rc != 0:
                raise NetworkError("Cannot switch the WiFi adapter on")
        timeout = scan_timeout()
        for attempt in (1, 2):
            rc, out, err = run([IW, "dev", dev, "scan"], timeout)
            if rc == 0:
                return {"device": dev, "networks": parse_scan(out)}
            if "Device or resource busy" in out + err and attempt == 1:
                time.sleep(BUSY_WAIT)
                continue
            log("iw scan failed: %s" % (err.strip() or out.strip()))
            break
    except subprocess.TimeoutExpired:
        log("iw scan took longer than %s s" % scan_timeout())
        raise NetworkError("The WiFi scan took too long")
    raise NetworkError("The WiFi scan failed")


# ============ apply ============

def is_template(text: str) -> bool:
    """As is_template of the menu: the marker, nothing, or only comments."""
    return TEMPLATE_MARKER in text or all(
        not l.strip() or l.strip().startswith("#") for l in text.splitlines())


def read_home_file(path: str) -> Optional[bytes]:
    """The bytes of a file of the user, None when it is missing. A link, a
    file that is not regular or one over 64 KiB is a failure."""
    name = os.path.basename(path)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    except OSError as e:
        if e.errno in (errno.ELOOP, errno.EMLINK):
            raise NetworkError("%s is a link" % name)
        raise NetworkError("cannot read %s: %s" % (name, e.strerror))
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise NetworkError("%s is not a regular file" % name)
        data = b""
        while len(data) <= MAX_FILE:
            chunk = os.read(fd, MAX_FILE + 1 - len(data))
            if not chunk:
                break
            data += chunk
    except OSError as e:
        raise NetworkError("cannot read %s: %s" % (name, e.strerror))
    finally:
        os.close(fd)
    if len(data) > MAX_FILE:
        raise NetworkError("%s is larger than 64 KiB" % name)
    return data


def read_system_file(path: str) -> Optional[bytes]:
    """A file of root: the installed one, or the default."""
    try:
        with open(path, "rb") as f:
            return f.read(MAX_FILE + 1)
    except FileNotFoundError:
        return None
    except OSError as e:
        raise NetworkError("cannot read %s: %s" % (path, e.strerror))


def home_dir() -> str:
    if HOME_DIR:
        return HOME_DIR
    try:
        return pwd.getpwnam("tfuser").pw_dir
    except KeyError:
        raise NetworkError("user tfuser does not exist")


def is_netboot() -> bool:
    """On a USB boot the initramfs mounts the ESP of the stick there."""
    return not os.path.ismount(ESP_DIR)


def lock_file():
    """Take the exclusive lock; the caller closes the descriptor."""
    os.makedirs(os.path.dirname(LOCK), mode=0o755, exist_ok=True)
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    deadline = time.monotonic() + LOCK_WAIT
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except OSError as e:
            if e.errno not in (errno.EAGAIN, errno.EACCES) or time.monotonic() > deadline:
                os.close(fd)
                raise NetworkError("Another network change is running")
            time.sleep(0.1)


def write_file(path: str, data: bytes) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
    finally:
        os.close(fd)


def check_files(files: dict) -> None:
    """netplan generate on a scratch root holding the set that will be in
    force: the files to install and the other *.yaml of ETC_NETPLAN."""
    os.makedirs(WORK_DIR, mode=0o700, exist_ok=True)
    root = tempfile.mkdtemp(prefix="check-", dir=WORK_DIR)
    try:
        conf = os.path.join(root, "etc", "netplan")
        os.makedirs(conf, mode=0o700)
        try:
            names = sorted(os.listdir(ETC_NETPLAN))
        except FileNotFoundError:
            names = []
        for name in names:
            src = os.path.join(ETC_NETPLAN, name)
            if name.endswith(".yaml") and name not in INSTALLED and os.path.isfile(src):
                write_file(os.path.join(conf, name), read_system_file(src) or b"")
        for name, data in files.items():
            write_file(os.path.join(conf, name), data)
        try:
            rc, out, err = run([NETPLAN, "generate", "--root-dir", root], GENERATE_TIMEOUT)
        except subprocess.TimeoutExpired:
            raise NetworkError("netplan generate took too long")
        if rc != 0:
            lines = [l.strip() for l in (err or out).splitlines()
                     if l.strip() and "systemctl" not in l and "daemon-reload" not in l]
            reason = " ".join(lines)[:300] or "netplan rejected the network files"
            raise NetworkError(reason)
    finally:
        shutil.rmtree(root, ignore_errors=True)


def install_files(files: dict) -> None:
    """Write each file next to its place (netplan reads *.yaml only), then
    rename it over the old one; mode 600."""
    tmps = []
    try:
        for name, data in files.items():
            tmp = os.path.join(ETC_NETPLAN, ".%s.%d.tmp" % (name, os.getpid()))
            tmps.append(tmp)
            write_file(tmp, data)
        for name, tmp in zip(files, tmps):
            os.rename(tmp, os.path.join(ETC_NETPLAN, name))
            log("installed %s" % name)
    except OSError as e:
        raise NetworkError("cannot install the network files: %s" % (e.strerror or e))
    finally:
        for tmp in tmps:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def apply() -> Tuple[int, str]:
    """(0, "") when installed and applied, else (1, reason). Nothing is
    installed unless the whole set passed netplan generate."""
    try:
        fd = lock_file()
    except NetworkError as e:
        return 1, str(e)
    except OSError as e:
        return 1, "cannot take the lock: %s" % (e.strerror or e)
    try:
        home = home_dir()
        wifi = read_home_file(os.path.join(home, "wifi.yaml"))
        wired = read_home_file(os.path.join(home, "ethernet.yaml"))
        files = {}
        install = []
        if wifi is not None and not is_template(wifi.decode("utf-8", "replace")):
            files["wifi.yaml"] = wifi
            install.append("wifi.yaml")
            log("wifi.yaml: from the home")
        else:
            current = read_system_file(os.path.join(ETC_NETPLAN, "wifi.yaml"))
            if current is not None:
                files["wifi.yaml"] = current
            log("wifi.yaml: left as it is")
        # No template rule for the wired file: the boot installs it as it is.
        if wired is not None and not is_netboot():
            files["ethernet.yaml"] = wired
            install.append("ethernet.yaml")
            log("ethernet.yaml: from the home")
        else:
            default = read_system_file(DEFAULT_WIRED)
            if default is None:
                raise NetworkError("The default wired setup is missing")
            files["ethernet.yaml"] = default
            install.append("ethernet.yaml")
            log("ethernet.yaml: the default")
        check_files(files)
        log("the files passed netplan generate")
        install_files({k: files[k] for k in install})
        try:
            rc, out, err = run([NETPLAN, "apply"], APPLY_TIMEOUT)
        except subprocess.TimeoutExpired:
            raise NetworkError("netplan apply took too long")
        if rc != 0:
            log("netplan apply: %s" % (err.strip() or out.strip()))
            raise NetworkError("netplan apply failed: %s"
                               % ((err.strip() or out.strip())[:300] or "exit %d" % rc))
        log("netplan apply done")
        return 0, ""
    except NetworkError as e:
        return 1, str(e)
    except OSError as e:
        return 1, "cannot apply the network files: %s" % (e.strerror or e)
    finally:
        os.close(fd)


def apply_command() -> dict:
    rc, reason = apply()
    if rc != 0:
        raise NetworkError(reason)
    return {"result": "ok", "reason": ""}


# ============ Entry point ============

COMMANDS = {"status": status, "scan": scan, "apply": apply_command}


def fail(reason: str) -> None:
    print(json.dumps({"result": "failed", "reason": reason}), flush=True)


def is_root() -> bool:
    return os.geteuid() == 0 or os.environ.get("TF_NETWORK_ASSUME_ROOT") == "1"


def main(argv: List[str]) -> int:
    """Exit 0 on success, 1 on a failure, 2 on misuse."""
    if len(argv) != 1 or argv[0] not in COMMANDS:
        print(USAGE, file=sys.stderr)
        fail(USAGE)
        return 2
    if not is_root():
        log("needs root")
        fail("needs root")
        return 2
    try:
        result = COMMANDS[argv[0]]()
    except NetworkError as e:
        log("%s failed: %s" % (argv[0], e))
        fail(str(e))
        return 1
    print(json.dumps(result), flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
