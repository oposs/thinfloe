#!/bin/sh
set -e

# Locations, overridable so test/integration/test-save-home.sh can run this
# script unprivileged.
TF_STATE_DIR="${TF_STATE_DIR:-/run/thinfloe/state}"
TF_CMDLINE="${TF_CMDLINE:-/proc/cmdline}"

# The ESP the initramfs mounted and deliberately left mounted. mount-squashfs.sh
# mounts it read-write and thinfloe-cleanup.sh says, in a comment, not to unmount
# it. It is by construction the partition this boot read, so writing here means
# the save and the restore cannot disagree.
#
# The old code mounted the EFI-SYSTEM partlabel symlink under /dev/disk on
# /boot/efi instead. Every thinfloe stick carries that partlabel, so with a second
# stick plugged in the symlink could resolve to the OTHER stick and the user's
# home was written there. It also mounted the same vfat filesystem a second time.
TF_EFI_MOUNT="${TF_EFI_MOUNT:-/run/thinfloe/storage/efi}"
TF_EXCLUDE_DEFAULT="${TF_EXCLUDE_DEFAULT:-/etc/thinfloe/save-home-exclude}"

# Exit codes, read by thinfloe-menu to tell the user what happened:
#
#   0  home saved
#   1  the resolved home directory is missing or is not a directory
#   2  this boot's home restore failed, so saving would destroy the good copy
#   3  the boot server is unreachable
#   4  this machine has no known place to store a home
#   5  the save was attempted and failed
#
# Everything except 1 used to be 0, and the no-target branch printed "home
# saved" while storing nothing.

# The directory to archive, which is NOT $HOME.
#
# thinfloe-upgrade re-execs itself under sudo and then calls this script from
# that root process. sudo runs with `Defaults env_reset` and no env_keep for
# HOME, so HOME becomes the target user's: `su - tluser -c "sudo printenv
# HOME"` prints /root on this image. A save triggered by `sudo thinfloe-upgrade`
# therefore ran `cd /root` and wrote a tar of root's dotfiles over
# /boot/efi/home.tar.gz. /root holds a .bashrc, so the archive had a valid
# member and tf_restore_home_from_file accepted it on the next boot,
# replacing the user's home and the SSH host keys staged in
# ~/.thinfloe-ssh-host-keys, with no error printed anywhere.
TF_HOME_DIR="${TF_HOME_DIR:-$(getent passwd tluser | cut -d: -f6)}"
: "${TF_HOME_DIR:=/home/tluser}"
if [ ! -d "$TF_HOME_DIR" ]; then
  echo "thinfloe: $TF_HOME_DIR is not a directory - refusing to save, so" >&2
  echo "       the stored home is not overwritten with something else." >&2
  exit 1
fi
# Prefer the base the initramfs actually built the fetch URL from.
#
# The sed below is kept only as a fallback, and it is wrong in a way worth
# naming: the greedy .* backtracks to the LAST slash anywhere in
# /proc/cmdline, so any kernel parameter appearing after ramroot= that
# contains a "/" - root=/dev/sda1, init=/sbin/init - yields a base with that
# parameter's text glued on. Today's configs/syslinux.cfg has no such
# parameter after ramroot=, so this has never fired, but adding one would
# silently orphan every netboot client's home. Reading the recorded value
# removes the whole class.
#
# The `|| true` is load-bearing, not decoration. A failed command
# substitution in an assignment ends the script under `set -e`, and
# restore_home() records boot-home-base only on the netboot branch
# (thinfloe-lib.sh:323-357). Without it, a USB machine died here on the second
# line of this script and saved nothing at logout, losing that session's
# changes and never persisting its SSH host keys.
BASE_PATH=$(cat "$TF_STATE_DIR/boot-home-base" 2>/dev/null || true)
if [ -z "$BASE_PATH" ]; then
  BASE_PATH=$(cat "$TF_CMDLINE" | sed -n 's/.*ramroot=\(.*\)\/.*$/\1/p')
fi

# Prefer the MAC the initramfs actually used to fetch this machine's home.
# Re-deriving it here (kernel ifindex 2) agreed with the restore only while
# both ran in the booted system; the restore now runs in the initramfs,
# which loads a smaller driver set and can therefore see a different ifindex
# order. Posting the archive under a different MAC than it was fetched with
# would silently orphan it. The old expression stays as a fallback for a
# boot where nothing was recorded.
MAC_ADDR=$(cat "$TF_STATE_DIR/boot-mac" 2>/dev/null || true)
if [ -z "$MAC_ADDR" ]; then
  MAC_ADDR=$(cat /sys/class/net/$(ip  addr show  | sed -n 's/^2: *\([^: ]*\).*$/\1/p')/address 2>/dev/null || true)
fi
BOOT_SRV=$(cat "$TF_CMDLINE" | sed -n 's/.*ramroot=http.*\/\/\([^/:]*\).*/\1/p')
# wait for dns to come up
#systemctl --user stop pulseaudio.service
#systemctl --user stop pulseaudio.socket
#systemctl --user disable pulseaudio.service
#systemctl --user disable pulseaudio.socket
cd "$TF_HOME_DIR"

# Build the tar exclude list.
#
# The archive is unpacked SYNCHRONOUSLY by the initramfs on every boot, so
# everything in it is paid for at every startup. A NUC7i3BNK's home held a
# 233MB Claude Code binary and a large ~/.cache: a 22MB archive became several
# hundred MB and every boot got slower.
#
# `set --` builds a real argument list rather than a string, so a pattern
# containing a space stays one pattern. A string split by the shell would
# break every path with a space in it.
EXCLUDE_FILE="$TF_HOME_DIR/.save-home-exclude"
[ -r "$EXCLUDE_FILE" ] || EXCLUDE_FILE="$TF_EXCLUDE_DEFAULT"
set --
if [ -r "$EXCLUDE_FILE" ]; then
  while IFS= read -r _dsh_pat || [ -n "$_dsh_pat" ]; do
    # Skip blanks and comments. An empty pattern would become a bare
    # --exclude=, which matches nothing or everything depending on tar
    # version - either way not what the file says.
    case "$_dsh_pat" in
      ''|'#'*) continue ;;
    esac
    set -- "$@" "--exclude=$_dsh_pat"
  done <"$EXCLUDE_FILE"
fi

# Refuse to overwrite a good archive with a home we failed to restore.
#
# restore_home cannot abort the boot - a non-zero return there bricks the
# machine - so it records its outcome instead. Without this gate, a boot
# where the archive was unreachable or corrupt comes up with the shipped
# default home, thinfloe-ssh-hostkeys generates fresh host keys into it, and
# this script then uploads that default over the user's real home: their
# data and the machine's stable SSH identity destroyed in one step.
#
# "absent" is NOT a failure - it is a first boot, or a machine whose home was
# never saved, and saving is exactly right there. Only "failed" blocks.
#
# A missing marker means an initramfs that predates this mechanism; fall
# through to saving, which is the old behaviour.
TF_RESTORE_STATE=$(cat "$TF_STATE_DIR/home-restore" 2>/dev/null || true)
if [ "$TF_RESTORE_STATE" = "failed" ]; then
  echo "thinfloe: home restore FAILED this boot - refusing to save, so the" >&2
  echo "       stored home and SSH host keys are not overwritten with a" >&2
  echo "       default one. Investigate before logging out again." >&2
  exit 2
fi

# Capture the live SSH host keys into the home directory so they travel with
# the archive. This is the ONLY place they are persisted - see
# /usr/bin/thinfloe-ssh-hostkeys and CLAUDE.md. It runs before the links below
# are checked, because it creates ~/.thinfloe-ssh-host-keys on a first save.
sudo /usr/bin/thinfloe-ssh-hostkeys --stage || true

# Every archive holds the 3.x names as links to the 4.0 ones.
#
# The restore reads a real ~/.dbrrg-* name beside its 4.0 name as "written on
# a 3.x fallback" and lets it win, and reads .thinfloe-password without
# .dbrrg-password as "cleared on 3.x". Both rely on 4.0 never saving a home
# without the links. A user who deleted a link, or an exclude pattern that
# matches it, broke that: 3.x's own default home ships a real
# ~/.dbrrg-environment, which then survived a 3.x boot and replaced the user's
# setting on the next 4.0 boot. The pairs are TF_HOME_RENAMES in
# 90thinfloe/thinfloe-lib.sh; test/integration/test-save-home.sh checks that
# both lists agree. A real old name is left alone: the restore lets it win.
TF_HOME_LINKS=".dbrrg-environment:.thinfloe-environment
.dbrrg-sessionrc:.thinfloe-sessionrc
.dbrrg-password:.thinfloe-password
.dbrrg-ssh-host-keys:.thinfloe-ssh-host-keys
.config/dbrrg:.config/thinfloe"
_dsh_pairs=""
for _dsh_pair in $TF_HOME_LINKS; do
  _dsh_old=${_dsh_pair%%:*}
  _dsh_new=${_dsh_pair#*:}
  # Below a symlinked directory (~/.config) the link would land wherever that
  # points, and tar archives the directory as a link anyway.
  case "$_dsh_old" in
    */*) [ -L "${_dsh_old%/*}" ] && continue ;;
  esac
  [ -e "$_dsh_new" ] || [ -L "$_dsh_new" ] || continue
  if [ ! -e "$_dsh_old" ] && [ ! -L "$_dsh_old" ]; then
    # Relative to the old name's directory, like the restore's links.
    if ln -s "${_dsh_new##*/}" "$_dsh_old" 2>/dev/null; then
      # Called by root from thinfloe-upgrade: the link is tluser's, like the
      # file it points to.
      [ "$(id -u)" != 0 ] || chown -h --reference="$_dsh_new" "$_dsh_old" 2>/dev/null || true
    else
      echo "thinfloe: could not link ~/$_dsh_old to ~/$_dsh_new" >&2
    fi
  fi
  [ -L "$_dsh_old" ] && _dsh_pairs="$_dsh_pairs ./$_dsh_old:./$_dsh_new"
done

# An exclude pattern that leaves out a link but not its 4.0 name is ignored,
# with a line in the menu's log. tar decides, because tar's matching
# (unanchored, * across /, a parent directory taking its members along) is
# what the save uses: it applies --exclude to names given on its command line
# too, and -v prints the ones it keeps.
dsh_drops_link() {
  _dsh_names=""
  for _dsh_pair in $_dsh_pairs; do
    _dsh_names="$_dsh_names ${_dsh_pair%%:*} ${_dsh_pair#*:}"
  done
  [ -n "$_dsh_names" ] || return 1
  # shellcheck disable=SC2086 # names hold no blanks
  _dsh_kept=$(tar -cf /dev/null --no-recursion -v "$1" $_dsh_names 2>/dev/null) || true
  for _dsh_pair in $_dsh_pairs; do
    case "
$_dsh_kept
" in
      *"
${_dsh_pair#*:}
"*) ;;
      *) continue ;;
    esac
    case "
$_dsh_kept
" in
      *"
${_dsh_pair%%:*}
"*) ;;
      *) _dsh_old=${_dsh_pair%%:*}
         echo "thinfloe: exclude pattern '${1#--exclude=}' ignored, it would leave out ~/${_dsh_old#./}"
         return 0 ;;
    esac
  done
  return 1
}
for _dsh_arg do
  shift
  dsh_drops_link "$_dsh_arg" || set -- "$@" "$_dsh_arg"
done

# Leave out every file over 10 MB, and name it.
#
# The archive is for configuration: WiFi, ThinLinc settings, keys, dotfiles.
# A file this size is a download, an image or a binary left in the home, and
# every boot would pay for unpacking it (see the exclude list above). Each one
# left out gets a line on stdout, which the menu shows in its log.
#
# find skips what the exclude list already leaves out, so a large file in
# ~/.cache is not reported. A pattern without a leading ./ gets */ in front,
# which approximates tar's unanchored match; a near miss costs a report line.
#
# The names reach tar as --exclude patterns, so * ? [ ] \ are escaped. A
# newline cannot travel in a line and becomes ?, which matches any one
# character: a small file whose name differs from a large one only there is
# left out with it.
TF_SAVE_HOME_MAX_BYTES=10485760
dsh_large_files() {
  set --
  if [ -r "$EXCLUDE_FILE" ]; then
    while IFS= read -r _dsh_lf_pat || [ -n "$_dsh_lf_pat" ]; do
      case "$_dsh_lf_pat" in
        ''|'#'*) continue ;;
        ./*|/*) ;;
        *) _dsh_lf_pat="*/$_dsh_lf_pat" ;;
      esac
      [ $# -gt 0 ] && set -- "$@" -o
      set -- "$@" -path "$_dsh_lf_pat"
    done <"$EXCLUDE_FILE"
  fi
  [ $# -gt 0 ] && set -- \( "$@" \) -prune -o
  # As root, like tar: a directory tluser cannot read is still archived.
  sudo find . "$@" -type f -size +"${TF_SAVE_HOME_MAX_BYTES}"c \
    -printf '%s\t%p\0' | sed -z 's/[][\\*?]/\\&/g' | tr '\n\0' '?\n'
}
_dsh_large=$(dsh_large_files)
_dsh_tab=$(printf '\t')
while IFS="$_dsh_tab" read -r _dsh_size _dsh_pat; do
  [ -n "$_dsh_pat" ] || continue
  set -- "$@" "--exclude=$_dsh_pat"
  echo "thinfloe: not saved ($((_dsh_size / 1048576)) MB, over 10 MB): $(printf '%s' "$_dsh_pat" | sed 's/\\\(.\)/\1/g')"
done <<EOF
$_dsh_large
EOF

if [ "" != "$BOOT_SRV" ]; then
  # Bounded, not "while true": an unreachable server at logout used to hang
  # the session forever - zero labwc keybindings and no menu mean the only
  # way out was a VT or a power cycle, and a power cycle loses this
  # session's home AND its freshly staged host keys. ~60s (60 * 1s sleep)
  # gives a flaky network a real chance while still bounding the wait.
  _dsh_waited=0
  _dsh_reachable=0
  while [ "$_dsh_waited" -lt 60 ]; do
    ping -nc 1 $BOOT_SRV 2>&1 >/dev/null && { _dsh_reachable=1; break; }
    sleep 1
    _dsh_waited=$((_dsh_waited + 1))
  done
  if [ "$_dsh_reachable" -ne 1 ]; then
    echo "thinfloe: boot server $BOOT_SRV unreachable after ${_dsh_waited}s -" >&2
    echo "       refusing to save. An upload that cannot reach its target" >&2
    echo "       cannot work; retry once the network is back." >&2
    exit 3
  fi
  # GNU tar exits 1 for "file changed as we read it", which is normal for a
  # live home; only status 2 and above is a failed archive.
  #
  # tar runs as root, as on the USB branch below. As tluser, one file in the
  # home that tluser cannot read (a root-owned 600 file left by a sudo
  # command) made tar exit 2 and failed every netboot save with exit 5, while
  # USB machines saved the same home fine. The archive is written through a
  # redirect by this shell, so the temporary file stays tluser's to remove.
  #
  # The file comes from mktemp, not a fixed name. It used to be
  # /tmp/$$.tar.gz, a name any local process can predict and create first:
  # the archive holds the password hash and the SSH host private keys, and a
  # file someone else made could be read, or swapped before the upload. Only
  # the kernel's protected_regular/protected_symlinks settings stood in the
  # way. mktemp creates a new file, mode 600, owned by tluser, and honours
  # $TMPDIR. The traps remove it on every path out, error exits included.
  if ! _dsh_archive=$(mktemp --tmpdir --suffix=.tar.gz thinfloe-save-home.XXXXXX); then
    echo "thinfloe: could not create a temporary file - nothing was uploaded." >&2
    exit 5
  fi
  # A signal ends a POSIX sh without running the EXIT trap, so turn one into
  # an exit; logout can deliver SIGHUP while tar or curl is still running.
  trap 'rm -f "$_dsh_archive"' EXIT
  trap 'exit 5' HUP INT TERM
  _dsh_rc=0
  sudo tar --warning=no-file-changed "$@" -zcf - . >"$_dsh_archive" || _dsh_rc=$?
  if [ "$_dsh_rc" -gt 1 ]; then
    echo "thinfloe: could not archive $TF_HOME_DIR - nothing was uploaded." >&2
    exit 5
  fi
  # -f: without it curl exits 0 on an HTTP 4xx/5xx reply (413, 500, full
  # disk) and this script would report "home saved" for an upload the server
  # rejected, breaking the exit-5 contract.
  #
  # filename= fixes the name the server sees. Without it curl sends the local
  # basename, which is now whatever mktemp picked.
  #
  # The path is double-quoted inside the form value, with " and \ escaped as
  # curl requires: curl splits an unquoted value on ; and , so a $TMPDIR
  # holding either made curl open a truncated path and exit 26.
  _dsh_form_path=$(printf '%s' "$_dsh_archive" | sed 's/[\\"]/\\&/g')
  if ! curl -f -sS -F "data=@\"$_dsh_form_path\";filename=home.tar.gz" "${BASE_PATH}/home.pkg?mac=${MAC_ADDR}"; then
    echo "thinfloe: upload to ${BASE_PATH} failed - your home was NOT saved." >&2
    exit 5
  fi
# mountpoint, not -d: the initramfs creates the directory on every boot,
# netboot included, so an unmounted one would take the archive into RAM and
# report "home saved".
elif mountpoint -q "$TF_EFI_MOUNT"; then
  # Write beside the live archive and rename over it only once the new one is
  # known good.
  #
  # The old code was `tar zcf - . | sudo dd of=/boot/efi/home.tar.gz`, which
  # truncates the only copy of the user's home BEFORE writing a byte. A power
  # cut or a full ESP mid-write left a broken archive, and the next boot came
  # up with an empty home: no SSH host keys, no WireGuard key, no settings.
  #
  # Writing tar -f directly also removes a second hole: /bin/sh has no
  # pipefail, so `tar | dd` only ever tested dd's status, and a tar that died
  # mid-stream still looked like a successful save.
  #
  # Every write to the ESP goes through sudo: the initramfs mounts it with a
  # plain `mount -t vfat` and no uid= option, so it is root:root 0755 and
  # tluser cannot create files there. tar still runs in the home directory, so
  # the members stay relative.
  _dsh_new="$TF_EFI_MOUNT/home.tar.gz.new"
  if ! sudo rm -f "$_dsh_new"; then
    echo "thinfloe: could not clear the staging file - your home was NOT saved," >&2
    echo "       and the previous archive is untouched." >&2
    exit 5
  fi
  # Status 1 is "file changed as we read it", normal for a live home; gzip -t
  # below still guards integrity. Only 2 and above is a failed archive.
  _dsh_rc=0
  sudo tar --warning=no-file-changed "$@" -zcf "$_dsh_new" . || _dsh_rc=$?
  if [ "$_dsh_rc" -gt 1 ]; then
    sudo rm -f "$_dsh_new" || true
    echo "thinfloe: could not write the archive - your home was NOT saved, and" >&2
    echo "       the previous one is untouched." >&2
    exit 5
  fi
  # Verify before committing. A truncated gzip is exactly what a full ESP
  # produces, and restore_home would accept a file that merely exists.
  if ! sudo gzip -t "$_dsh_new"; then
    sudo rm -f "$_dsh_new" || true
    echo "thinfloe: the new archive is corrupt - your home was NOT saved, and" >&2
    echo "       the previous one is untouched." >&2
    exit 5
  fi
  if ! sudo mv -f "$_dsh_new" "$TF_EFI_MOUNT/home.tar.gz"; then
    sudo rm -f "$_dsh_new" || true
    echo "thinfloe: could not replace the stored archive - your home was NOT" >&2
    echo "       saved, and the previous one is untouched." >&2
    exit 5
  fi
  sudo sync || true
else
  echo "thinfloe: this machine has no boot server and no mounted EFI partition," >&2
  echo "       so there is nowhere to store your home directory. Nothing was" >&2
  echo "       saved." >&2
  exit 4
fi
echo "home saved"
