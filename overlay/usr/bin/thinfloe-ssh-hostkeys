#!/bin/sh
# Install the machine's persistent SSH host keys, or generate them once.
#
# The root filesystem is a read-only squashfs with a ZRAM overlay, so
# /etc/ssh is writable but volatile: without this, keys are regenerated on
# every boot and every client reports a changed host key every time.
#
# The keys are persisted INSIDE the home directory, which is already saved
# to the EFI partition (USB) or the boot server (netboot) by
# thinfloe-save-home, and restored by the initramfs before the pivot. That is
# why this can run as an ordinary system service with no EFI mount, no
# network, and no server-side endpoint of its own.
#
# Ordering: the initramfs has already put ~tfuser/.config/thinfloe/ssh-host-keys in
# place by the time this runs, and thinfloe-ssh-hostkeys.service is ordered
# Before=ssh.service.
#
# Usage:
#   thinfloe-ssh-hostkeys            install from the keystore, or generate
#   thinfloe-ssh-hostkeys --stage    copy the live keys into the keystore
#                                 (called by thinfloe-save-home before tarring)
#
# The keystore is ~/.config/thinfloe/ssh-host-keys; a home still in the 4.x
# layout keeps ~/.thinfloe-ssh-host-keys. $TF_STATE_DIR/home-layout (default
# /run/thinfloe/state) says which. That file is tfuser's to change, so it only
# picks between those two paths in tfuser's home; this script runs as root and
# never follows a link at ~/.config, ~/.config/thinfloe or the keystore.
#
# The TF_* variables exist so test/integration/test-ssh-hostkeys.sh can
# redirect the layout; nothing in the image sets them.

set -u

SSH_DIR="${TF_SSH_DIR:-/etc/ssh}"
HOME_DIR="${TF_HOME_DIR:-/home/tfuser}"
KEY_OWNER="${TF_KEY_OWNER:-tfuser}"
STATE_DIR="${TF_STATE_DIR:-/run/thinfloe/state}"

# The menu's rule exactly: the whole file is "legacy" or "legacy" and one
# newline; anything else, a missing file included, is the new layout.
layout=
extra=
{
    IFS= read -r layout || true
    if IFS= read -r extra || [ -n "$extra" ]; then layout=new; fi
} 2>/dev/null <"$STATE_DIR/home-layout" || layout=new
CFG_DIR="$HOME_DIR/.config/thinfloe"
if [ "$layout" = legacy ]; then
    KEYSTORE="$HOME_DIR/.thinfloe-ssh-host-keys"
else
    KEYSTORE="$CFG_DIR/ssh-host-keys"
fi

# Refuse a link anywhere on the way to the keystore: root would otherwise
# read keys from, or write and chown in, a place tfuser chose.
keystore_path_is_safe() {
    for _p in "$HOME_DIR/.config" "$CFG_DIR" "$KEYSTORE"; do
        if [ -L "$_p" ]; then
            echo "thinfloe-ssh-hostkeys: $_p is a link; not using the keystore" >&2
            return 1
        fi
    done
}

# Create the directories above the keystore, owned by tfuser (new layout).
make_keystore_parents() {
    [ "$layout" = legacy ] && return 0
    for _d in "$HOME_DIR/.config" "$CFG_DIR"; do
        if [ ! -e "$_d" ]; then
            mkdir "$_d" || return 1
            chown -h "$KEY_OWNER:$KEY_OWNER" "$_d" 2>/dev/null || \
                echo "thinfloe-ssh-hostkeys: WARNING could not chown $_d" >&2
        fi
    done
}

# has_keys <dir> - true if <dir> holds at least one private host key.
# An unmatched glob stays literal in POSIX sh, so the -e test is the check.
has_keys() {
    set -- "$1"/ssh_host_*_key
    [ -e "$1" ]
}

# Install the persisted keys over the volatile ones.
install_from_keystore() {
    keystore_path_is_safe || return 1
    has_keys "$KEYSTORE" || return 1

    cp -p "$KEYSTORE"/ssh_host_* "$SSH_DIR"/ 2>/dev/null || return 1

    # The keystore lives inside tfuser's home, so these arrive owned by
    # tfuser and carrying whatever mode the archive preserved. sshd refuses
    # to start on a host key that is not root-owned and 0600, so both are
    # forced here rather than trusted.
    #
    # NOTE: this is deliberately the OPPOSITE of the home restore in
    # thinfloe-lib.sh, which must PRESERVE uid 1001 (tar --same-owner). Same
    # archive, two different requirements. Do not "make them consistent".
    chown root:root "$SSH_DIR"/ssh_host_* 2>/dev/null || \
        echo "thinfloe-ssh-hostkeys: WARNING could not chown host keys" >&2
    chmod 600 "$SSH_DIR"/ssh_host_*_key 2>/dev/null || true
    chmod 644 "$SSH_DIR"/ssh_host_*_key.pub 2>/dev/null || true

    return 0
}

# Copy the live keys into the keystore so the next thinfloe-save-home run
# captures them in the home archive.
stage_to_keystore() {
    has_keys "$SSH_DIR" || {
        echo "thinfloe-ssh-hostkeys: no host keys in $SSH_DIR to stage" >&2
        return 1
    }

    keystore_path_is_safe || return 1
    make_keystore_parents || return 1
    mkdir -p "$KEYSTORE" 2>/dev/null || return 1
    keystore_path_is_safe || return 1
    # --remove-destination: a link planted inside the keystore is replaced by
    # the key file, not written through as root.
    cp -p --remove-destination "$SSH_DIR"/ssh_host_* "$KEYSTORE"/ 2>/dev/null || return 1

    # Owned by tfuser like the rest of the home. thinfloe-save-home archives as
    # root now, but until 2026-10 the netboot save ran tar as tluser (the
    # account's name before 4.0), and an
    # unreadable root-owned file failed the whole save.
    chown -R "$KEY_OWNER:$KEY_OWNER" "$KEYSTORE" 2>/dev/null || \
        echo "thinfloe-ssh-hostkeys: WARNING could not chown $KEYSTORE" >&2
    chmod 700 "$KEYSTORE" 2>/dev/null || true
    chmod 600 "$KEYSTORE"/ssh_host_*_key 2>/dev/null || true

    return 0
}

case "${1:-}" in
    --stage)
        stage_to_keystore
        exit 0
        ;;
    "")
        ;;
    *)
        echo "Usage: thinfloe-ssh-hostkeys [--stage]" >&2
        exit 1
        ;;
esac

if install_from_keystore; then
    echo "thinfloe-ssh-hostkeys: installed persistent host keys from $KEYSTORE"

    # Top up any key type the keystore did not carry. has_keys above only
    # proves at least ONE key was present, so a partial keystore - a
    # truncated home archive, a hand-edited directory, or simply a keystore
    # written before a new key type existed - would otherwise leave sshd
    # running with fewer host key types than the image expects, silently and
    # with a log line identical to a full install.
    #
    # ssh-keygen -A only creates types that are missing and leaves existing
    # keys untouched, so this is safe to run unconditionally here. Anything
    # it generates is staged back so the keystore converges on the full set.
    if ssh-keygen -A; then
        chown root:root "$SSH_DIR"/ssh_host_* 2>/dev/null || true
        chmod 600 "$SSH_DIR"/ssh_host_*_key 2>/dev/null || true
        chmod 644 "$SSH_DIR"/ssh_host_*_key.pub 2>/dev/null || true
        stage_to_keystore || \
            echo "thinfloe-ssh-hostkeys: WARNING could not restage topped-up keys" >&2
    fi

    exit 0
fi

if has_keys "$SSH_DIR"; then
    echo "thinfloe-ssh-hostkeys: host keys already present in $SSH_DIR"
    exit 0
fi

# First boot of this machine, or a machine whose home was never saved.
echo "thinfloe-ssh-hostkeys: no persistent host keys, generating"
if ! ssh-keygen -A; then
    echo "thinfloe-ssh-hostkeys: ssh-keygen -A failed" >&2
    exit 1
fi

# Stage immediately so the keys are captured by the first thinfloe-save-home.
# Note they do not actually persist until that runs, at logout - a machine
# powered off before its first clean logout will generate fresh keys again
# next boot. Accepted; see the design spec.
stage_to_keystore || \
    echo "thinfloe-ssh-hostkeys: WARNING could not stage keys into $KEYSTORE" >&2

exit 0
