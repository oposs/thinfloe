#!/usr/bin/env python3
"""
thinfloe-upgrade - ThinFloe firmware upgrade utility

Installs or upgrades ThinFloe firmware on USB drives.
Supports A/B updates for existing ThinFloe drives, or fresh install for new drives.
"""

import argparse
import atexit
import errno
import fcntl
import fnmatch
import glob
import hashlib
import json
import os
import pwd
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
import uuid
from dataclasses import dataclass
from pathlib import Path
from typing import List, Optional, Tuple

# ============ Constants ============

DEFAULT_URL = "https://tobi.oetiker.ch/dbrrg"
EFI_PARTLABEL = "EFI-SYSTEM"
FIRMWARE_FILES = ("vmlinuz", "initrd.img", "ramroot.sqsh")
TFUSER = "tfuser"
HOME_ARCHIVE_NAME = "home.tar.gz"
# The shipped default exclude list; thinfloe-save-home reads the same file.
SAVE_HOME_EXCLUDE_DEFAULT = "/etc/thinfloe/save-home-exclude"
# Per-machine identity, always left out of the copy (appended outside the
# user-editable exclude list so a ~/.save-home-exclude cannot drop them):
#  - the SSH host keys: two machines with one host key is a real problem; a
#    stick without them generates its own on first boot. Both names: a save
#    on a 3.x fallback boot leaves a real ~/.dbrrg-ssh-host-keys in the home.
#  - the WireGuard config: it holds the machine's private key, and two peers
#    sharing one key break both tunnels.
# ~/.thinfloe-password is deliberately NOT here: the user set it for remote
# access and it travels with the home on purpose.
IDENTITY_EXCLUDES = ("./.thinfloe-ssh-host-keys", "./.dbrrg-ssh-host-keys", "./wg0.conf")
# The home archive carries configuration, not data. A file above this size is
# a download or a binary left in the home; thinfloe-save-home uses the same limit.
SAVE_HOME_MAX_FILE_BYTES = 10 * 1024 * 1024
# Room asked for beyond the release's own size: FAT cluster slack, and a
# release that is a little bigger than the one measured.
UPGRADE_SPACE_MARGIN = 1.1
# udev may not have re-read the partition table yet, right after partprobe on
# a drive that was just written byte for byte.
EFI_RETRY_SECONDS = 15
# Where the initramfs records this boot's home restore outcome; thinfloe-save-home
# reads the same file. Module constant so tests can point it elsewhere.
STATE_DIR = "/run/thinfloe/state"
# The ESP the initramfs mounted for this boot. Module constant so tests can
# point it elsewhere.
BOOT_EFI_MOUNT = "/run/thinfloe/storage/efi"
# Both copies of the boot loader config on the ESP: BIOS syslinux reads the
# first, the EFI build the second.
SYSLINUX_CFGS = ("syslinux.cfg", "efi/boot/syslinux.cfg")

# ============ Progress ============

class Progress:
    """Reports what a long operation is doing.

    Batch mode (the menu reads it) writes one line per message:
      @step <id> <text>      a phase starts
      @progress <done> <total|->   bytes so far; "-" when the total is unknown
      @done <id>             the phase ended
      @result ok|failed <reason>
    Newlines in text are replaced by spaces so one message stays one line.

    Interactive mode (SSH) prints "==> <text>" for a step and a carriage
    return line "  <MiB done> of <MiB total> MiB" for progress, ended by a
    newline at done == total, at done() or before a failure. A failed result
    prints "Failed: <reason>"; a successful one and done() print nothing more.

    progress() is rate limited to min_interval seconds, except for the last
    call (done == total).
    """

    def __init__(self, out, batch: bool, min_interval: float = 0.5):
        self.out = out
        self.batch = batch
        self.min_interval = min_interval
        self._last = None  # monotonic time of the last printed progress
        self._open = False  # an interactive progress line lacks its newline

    @staticmethod
    def _one_line(text: str) -> str:
        return " ".join(str(text).split("\n")).replace("\r", " ")

    def _emit(self, text: str) -> None:
        self.out.write(text)
        self.out.flush()

    def _close_line(self) -> None:
        if self._open:
            self._emit("\n")
            self._open = False

    def step(self, id: str, text: str) -> None:
        if self.batch:
            self._emit("@step %s %s\n" % (id, self._one_line(text)))
        else:
            self._close_line()
            self._emit("==> %s\n" % self._one_line(text))

    def progress(self, done: int, total: Optional[int]) -> None:
        last = total is not None and done >= total
        now = time.monotonic()
        if (not last and self._last is not None
                and now - self._last < self.min_interval):
            return
        self._last = now
        if self.batch:
            self._emit("@progress %d %s\n" % (done, "-" if total is None else total))
            return
        mib = done // (1024 * 1024)
        if total is None:
            line = "\r  %d MiB" % mib
        else:
            line = "\r  %d of %d MiB" % (mib, total // (1024 * 1024))
        self._emit(line)
        self._open = True
        if last:
            self._close_line()

    def done(self, id: str) -> None:
        if self.batch:
            self._emit("@done %s\n" % id)
        else:
            self._close_line()

    def result(self, ok: bool, reason: str) -> None:
        if self.batch:
            word = "ok" if ok else "failed"
            reason = self._one_line(reason)
            self._emit("@result %s%s\n" % (word, " " + reason if reason else ""))
        elif not ok:
            self._close_line()
            self._emit("Failed: %s\n" % self._one_line(reason))


# Interactive by default; batch mode replaces it.
PROGRESS = Progress(sys.stdout, batch=False)

# ============ Data Classes ============

@dataclass
class DriveInfo:
    """Information about a detected block device"""
    device: str              # /dev/sda
    size: str                # "16G"
    model: str               # "SanDisk Cruzer"
    label: str               # Filesystem label
    is_thinfloe: bool           # True if this is a ThinFloe drive
    efi_partition: Optional[str]  # /dev/sda1 if EFI-SYSTEM exists
    part_size_mb: int        # EFI partition size in MB
    is_boot: bool            # True if this is the current boot device
    has_tl_old: bool         # True if tl.old/ exists (has fallback)
    has_tl_new: bool         # True if tl.new/ exists (pending upgrade)
    size_bytes: int = 0      # exact size, for the fit check
    serial: str = ""         # lsblk SERIAL, else WWN
    transport: str = ""      # usb, nvme, sata, ...
    removable: bool = False
    mounted: bool = False    # the disk or any partition has a mountpoint
    fingerprint: str = "-"   # hash of the partition table, "-" if unreadable


# ============ Global State ============

_cleanup_items: List[Tuple[str, str]] = []  # (type, path) - "mount" or "dir"


def _register_cleanup(cleanup_type: str, path: str) -> None:
    """Register an item for cleanup on exit"""
    _cleanup_items.append((cleanup_type, path))


def _unregister_cleanup(cleanup_type: str, path: str) -> None:
    """Remove an item from cleanup list"""
    global _cleanup_items
    _cleanup_items = [(t, p) for t, p in _cleanup_items if not (t == cleanup_type and p == path)]


MOUNTINFO = "/proc/self/mountinfo"


def _unescape_mountinfo(field: str) -> str:
    """Decode the octal escapes (\\040 space, \\011 tab, \\012 newline, \\134 backslash)"""
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), field)


def _is_or_holds_mount(path: str) -> bool:
    """True if path is a mount point or has a mount anywhere beneath it"""
    if os.path.ismount(path):
        return True
    real = os.path.realpath(path).rstrip("/")
    try:
        with open(MOUNTINFO) as f:
            for line in f:
                fields = line.split()
                if len(fields) > 4:
                    mnt = _unescape_mountinfo(fields[4])
                    if mnt == real or mnt.startswith(real + "/"):
                        return True
    except OSError:
        pass
    return False


def _do_cleanup() -> None:
    """Cleanup all registered items (called on exit)"""
    for cleanup_type, path in reversed(_cleanup_items):
        try:
            if cleanup_type == "mount":
                run_cmd(["umount", path], check=False, capture=True)
            elif cleanup_type == "dir":
                # Entries run in reverse, so a "mount" on this path has had
                # its umount attempted already. If that failed (busy), the
                # directory IS the stick: rmtree would delete its tl/, tl.old/
                # and home.tar.gz. Leave it. rmtree is only right for scratch
                # dirs (work_dir) the script filled itself, never a mount point.
                if _is_or_holds_mount(path):
                    print(f"WARNING: {path} is still mounted - leaving it "
                          f"untouched", file=sys.stderr)
                else:
                    shutil.rmtree(path, ignore_errors=True)
        except Exception:
            pass


atexit.register(_do_cleanup)


# ============ Utility Functions ============

def die(message: str) -> None:
    """Print error and exit"""
    print(f"\nERROR: {message}", file=sys.stderr)
    sys.exit(1)


def log(message: str) -> None:
    """Print log message"""
    print(f"==> {message}")


def ensure_root(batch: bool = False) -> None:
    """Re-execute with sudo if not running as root.

    Batch mode must never prompt and keeps stdout for machine-readable
    output: the notice goes to stderr and sudo gets -n.
    """
    if os.geteuid() != 0:
        if batch:
            print("Requesting root privileges...", file=sys.stderr)
            os.execvp("sudo", ["sudo", "-n"] + sys.argv)
        else:
            print("Requesting root privileges...")
            os.execvp("sudo", ["sudo"] + sys.argv)


def run_cmd(
    cmd: List[str],
    check: bool = True,
    capture: bool = False,
) -> subprocess.CompletedProcess:
    """Run a command"""
    return subprocess.run(cmd, check=check, capture_output=capture, text=True)


def get_cmd_output(cmd: List[str]) -> str:
    """Run command and return stdout, empty string on failure"""
    try:
        result = run_cmd(cmd, check=False, capture=True)
        return result.stdout.strip() if result.returncode == 0 else ""
    except Exception:
        return ""


# ============ Menu Functions ============

def print_header(title: str) -> None:
    """Print a section header"""
    print()
    print("=" * 60)
    print(f"  {title}")
    print("=" * 60)


def show_menu(title: str, options: List[Tuple[str, str]], allow_back: bool = True) -> Optional[str]:
    """Show a numbered menu and get user selection."""
    print_header(title)

    for i, (_, desc) in enumerate(options, 1):
        print(f"  {i}) {desc}")

    if allow_back:
        print(f"  0) {'Back' if options else 'Cancel'}")

    print()

    while True:
        try:
            choice = input("Select option: ").strip()
            if not choice:
                continue

            num = int(choice)
            if num == 0 and allow_back:
                return None
            if 1 <= num <= len(options):
                return options[num - 1][0]

            print("Invalid choice. Please try again.")
        except ValueError:
            print("Please enter a number.")
        except (KeyboardInterrupt, EOFError):
            print()
            return None


def show_input(prompt: str, default: str = "") -> Optional[str]:
    """Get text input from user"""
    try:
        if default:
            result = input(f"{prompt} [{default}]: ").strip()
            return result if result else default
        else:
            return input(f"{prompt}: ").strip()
    except (KeyboardInterrupt, EOFError):
        print()
        return None


def confirm(message: str) -> bool:
    """Ask yes/no confirmation"""
    try:
        while True:
            response = input(f"{message} (y/n): ").strip().lower()
            if response in ("y", "yes"):
                return True
            if response in ("n", "no"):
                return False
            print("Please enter 'y' or 'n'.")
    except (KeyboardInterrupt, EOFError):
        print()
        return False


# ============ Boot Device Detection ============

def detect_boot_device() -> Optional[str]:
    """Detect which device we booted from (if any)."""
    sqsh_path_file = Path("/run/thinfloe/state/squashfs-path")
    if not sqsh_path_file.exists():
        return None

    try:
        sqsh_path = sqsh_path_file.read_text().strip()
    except Exception:
        return None

    if not sqsh_path.startswith("/run/thinfloe/storage/efi/"):
        return None

    boot_part = get_cmd_output(["findmnt", "-n", "-o", "SOURCE", "/run/thinfloe/storage/efi"])
    if not boot_part:
        return None

    parent = get_cmd_output(["lsblk", "-no", "PKNAME", boot_part])
    return f"/dev/{parent}" if parent else None


# ============ Drive Detection ============

def find_efi_partition(device: str) -> Optional[str]:
    """Find EFI-SYSTEM partition on a device"""
    devname = os.path.basename(device)

    for pattern in [f"/dev/{devname}*[0-9]", f"/dev/{devname}p*[0-9]"]:
        for part in glob.glob(pattern):
            partlabel = get_cmd_output(["blkid", "-s", "PARTLABEL", "-o", "value", part])
            if partlabel == EFI_PARTLABEL:
                return part

    return None


def examine_efi_partition(efi_partition: str) -> Tuple[bool, bool, bool]:
    """
    Examine EFI partition to determine if it's a ThinFloe drive.
    Returns: (is_thinfloe, has_tl_old, has_tl_new)
    """
    tmp_mount = tempfile.mkdtemp(prefix="thinfloe-check-")
    _register_cleanup("dir", tmp_mount)

    is_thinfloe = False
    has_tl_old = False
    has_tl_new = False

    try:
        result = run_cmd(["mount", "-o", "ro", efi_partition, tmp_mount], check=False, capture=True)
        if result.returncode == 0:
            _register_cleanup("mount", tmp_mount)

            tl_path = os.path.join(tmp_mount, "tl")
            if os.path.isdir(tl_path):
                # Check for firmware files
                has_vmlinuz = os.path.isfile(os.path.join(tl_path, "vmlinuz"))
                has_ramroot = os.path.isfile(os.path.join(tl_path, "ramroot.sqsh"))
                is_thinfloe = has_vmlinuz and has_ramroot

            has_tl_old = os.path.isdir(os.path.join(tmp_mount, "tl.old"))
            has_tl_new = os.path.isdir(os.path.join(tmp_mount, "tl.new"))

            run_cmd(["umount", tmp_mount], check=False, capture=True)
            _unregister_cleanup("mount", tmp_mount)
    except Exception:
        pass

    # rmdir, never rmtree: if the umount failed this is still the stick
    try:
        os.rmdir(tmp_mount)
    except OSError:
        pass
    _unregister_cleanup("dir", tmp_mount)

    return is_thinfloe, has_tl_old, has_tl_new


PTABLE_BYTES = 17408  # LBA 0 to 33: MBR, GPT header and entries


def ptable_fingerprint(device: str) -> str:
    """First 16 hex digits of SHA-256 over the partition table area."""
    try:
        with open(device, "rb") as f:
            data = f.read(PTABLE_BYTES)
    except OSError:
        return "-"
    return hashlib.sha256(data).hexdigest()[:16]


def drive_identity(d: DriveInfo) -> str:
    """Identity that changes when the drive is swapped or repartitioned."""
    return f"{d.serial or '-'}:{d.size_bytes}:{d.fingerprint}"


def _any_mounted(node: dict) -> bool:
    if any(node.get("mountpoints") or []):
        return True
    return any(_any_mounted(c) for c in node.get("children") or [])


def enumerate_drives(include_internal: bool = False) -> List[DriveInfo]:
    """Find suitable block devices; USB/removable and the boot drive by default."""
    drives = []
    boot_dev = detect_boot_device()

    out = get_cmd_output(["lsblk", "-J", "-b", "-o",
                          "NAME,PATH,SIZE,MODEL,SERIAL,WWN,TRAN,RM,TYPE,MOUNTPOINTS"])
    try:
        nodes = json.loads(out)["blockdevices"]
    except (ValueError, KeyError, TypeError):
        return []

    for node in nodes:
        devname = node.get("name") or ""
        if node.get("type") != "disk":
            continue
        if not any(devname.startswith(p) for p in ("sd", "nvme", "vd")):
            continue

        device = node.get("path") or f"/dev/{devname}"
        is_boot = boot_dev is not None and device == boot_dev
        transport = node.get("tran") or ""
        # Old util-linux prints rm as "0"/"1"; bool("0") would be True.
        removable = node.get("rm") in (True, "1", 1)
        if not (include_internal or removable or transport == "usb" or is_boot):
            continue

        try:
            size_bytes = int(node.get("size") or 0)
        except (TypeError, ValueError):
            size_bytes = 0
        size = get_cmd_output(["lsblk", "-dno", "SIZE", device]) or "?"
        model = (node.get("model") or "").strip() or "Unknown"

        efi_part = find_efi_partition(device)

        is_thinfloe = False
        has_tl_old = False
        has_tl_new = False
        part_size_mb = 0
        label = ""

        if efi_part:
            part_size_str = get_cmd_output(["lsblk", "-bno", "SIZE", efi_part])
            try:
                part_size_mb = int(part_size_str) // (1024 * 1024) if part_size_str else 0
            except ValueError:
                part_size_mb = 0
            label = get_cmd_output(["blkid", "-s", "LABEL", "-o", "value", efi_part])
            is_thinfloe, has_tl_old, has_tl_new = examine_efi_partition(efi_part)

        drives.append(DriveInfo(
            device=device,
            size=size,
            model=model,
            label=label,
            is_thinfloe=is_thinfloe,
            efi_partition=efi_part,
            part_size_mb=part_size_mb,
            is_boot=is_boot,
            has_tl_old=has_tl_old,
            has_tl_new=has_tl_new,
            size_bytes=size_bytes,
            serial=node.get("serial") or node.get("wwn") or "",
            transport=transport,
            removable=removable,
            mounted=_any_mounted(node),
            fingerprint=ptable_fingerprint(device),
        ))

    return drives


def drives_json(drives: List[DriveInfo], image_bytes: Optional[int]) -> str:
    """The drive list for the menu."""
    rows = []
    for d in drives:
        rows.append({
            "device": d.device,
            "model": d.model,
            "size_bytes": d.size_bytes,
            "serial": d.serial,
            "transport": d.transport,
            "removable": d.removable,
            "mounted": d.mounted,
            "is_boot": d.is_boot,
            "is_thinfloe": d.is_thinfloe,
            "has_tl_old": d.has_tl_old,
            "has_tl_new": d.has_tl_new,
            "efi_partition": d.efi_partition,
            "id": drive_identity(d),
            "fits": None if image_bytes is None else d.size_bytes >= image_bytes,
        })
    return json.dumps(rows)


# ============ Source Selection ============

def select_source() -> Optional[str]:
    """Let user select firmware source URL"""
    options = [
        ("default", f"Default: {DEFAULT_URL}"),
        ("custom", "Enter custom URL"),
    ]

    choice = show_menu("Select Firmware Source", options)
    if choice is None:
        return None

    if choice == "default":
        return DEFAULT_URL
    elif choice == "custom":
        return show_input("Enter firmware URL", DEFAULT_URL)

    return None


# ============ Firmware Download ============

def download_file(url: str, dest: str) -> bool:
    """Download a file with progress"""
    print(f"  Downloading {os.path.basename(url)}...")
    result = subprocess.run(
        ["curl", "-L", "--progress-bar", "-o", dest, url],
        check=False
    )
    return result.returncode == 0


def download_firmware(base_url: str, work_dir: str) -> str:
    """Download firmware files from URL, returns path to firmware directory"""
    log(f"Downloading firmware from {base_url}...")

    firmware_dir = os.path.join(work_dir, "firmware")
    os.makedirs(firmware_dir, exist_ok=True)

    for filename in FIRMWARE_FILES:
        url = f"{base_url}/{filename}"
        dest = os.path.join(firmware_dir, filename)
        if not download_file(url, dest):
            die(f"Failed to download {filename}")

    log("Firmware downloaded successfully")
    return firmware_dir


ZSTD_MAGIC = b"\x28\xb5\x2f\xfd"


def zstd_content_size(header: bytes) -> Optional[int]:
    """Uncompressed size from a zstd frame header, None when it has none.

    The header is at most 18 bytes: magic, Frame_Header_Descriptor, an
    optional window byte, a 0/1/2/4-byte dictionary id and a 0/1/2/4/8-byte
    Frame_Content_Size (RFC 8878, 3.1.1.1).
    """
    if len(header) < 5 or header[:4] != ZSTD_MAGIC:
        return None
    fhd = header[4]
    fcs_flag = fhd >> 6
    single_segment = bool(fhd & 0x20)
    if fcs_flag == 0 and not single_segment:
        return None
    pos = 5 + (0 if single_segment else 1) + (0, 1, 2, 4)[fhd & 0x03]
    width = (1, 2, 4, 8)[fcs_flag]
    field = header[pos:pos + width]
    if len(field) != width:
        return None
    size = int.from_bytes(field, "little")
    return size + 256 if width == 2 else size


def image_size(image_url: str) -> Optional[int]:
    """Uncompressed size of the published image, None when it cannot be learned.

    Only the first 18 bytes are fetched. --max-filesize makes curl give up
    instead of downloading the whole 700 MB image from a server that ignores
    the range and answers 200 with a Content-Length.
    """
    try:
        result = subprocess.run(
            ["curl", "-fsSL", "-r", "0-17", "--max-filesize", "4096", image_url],
            capture_output=True, timeout=30, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    return zstd_content_size(result.stdout[:18])


def drive_size_bytes(device: str) -> Optional[int]:
    """Size of the whole drive in bytes, None when lsblk cannot tell."""
    try:
        return int(get_cmd_output(["lsblk", "-bdno", "SIZE", device]))
    except ValueError:
        return None


def check_drive_fits(base_url: str, device: str) -> None:
    """Die when the image is larger than the drive, before anything is written.

    dd onto a stick smaller than thinfloe-usb.img (3148873728 bytes with the
    3000 MB ESP) wrote until the end of the device and failed, leaving a
    partition table that points past it and a stick that does not boot.
    An old server or a stream compressed from a pipe may not tell the size;
    the install then goes on as before, with a warning.
    """
    needed = image_size(f"{base_url}/thinfloe-usb.img.zst")
    have = drive_size_bytes(device)
    if needed is None or have is None:
        log("WARNING: could not learn the size of "
            + ("the image" if needed is None else f"{device}")
            + "; the drive is not checked for space")
        return
    if have < needed:
        die(f"{device} is too small: it holds {have} bytes "
            f"({have / 1e9:.1f} GB), the image needs {needed} bytes "
            f"({needed / 1e9:.1f} GB). Nothing was written.")


# Flush to the stick this often, so the progress follows what the stick has
# really taken and not what the page cache accepted.
SYNC_EVERY = 32 * 1024 * 1024
WRITE_BLOCK = 1024 * 1024


class WriteFailed(Exception):
    """Writing the image failed; .reason is one plain sentence for users."""

    def __init__(self, reason: str):
        super().__init__(reason)
        self.reason = reason


@dataclass
class WriteResult:
    written: int
    image_sha256: str  # of the uncompressed image, as written
    download_sha256: str  # of the compressed bytes, as downloaded


def _feed(src, dst, digest, state) -> None:
    """Thread body: hash curl's output and pass it on to zstd."""
    try:
        while True:
            block = src.read(WRITE_BLOCK)
            if not block:
                break
            digest.update(block)
            dst.write(block)
    except (BrokenPipeError, ValueError):
        state["broken"] = True  # zstd quit early; main reports why
    except OSError:
        state["broken"] = True
    finally:
        try:
            dst.close()
        except OSError:
            state["broken"] = True


def _last_line(f) -> str:
    """': <last line>' of a child's stderr file, '' when it said nothing."""
    try:
        f.seek(0)
        lines = f.read().decode("utf-8", "replace").strip().splitlines()
    except (OSError, ValueError):
        return ""
    return ": " + lines[-1][:200] if lines else ""


def stream_image(url: str, device: str, total: Optional[int],
                 progress: Progress) -> WriteResult:
    """curl -> zstd -dc -> device, hashing both streams on the way.

    The device is opened without O_TRUNC so a block device and a regular
    file (tests) behave alike. Every SYNC_EVERY bytes it is flushed and
    progress reported, so the number is what the stick has accepted.
    Any exception, KeyboardInterrupt included, kills both children and
    joins the thread before it propagates.
    """
    curl = zstd = thread = None
    fd = None
    # Files, not pipes: a full stderr pipe would block the child.
    curl_err = tempfile.TemporaryFile()
    zstd_err = tempfile.TemporaryFile()
    image_hash = hashlib.sha256()
    download_hash = hashlib.sha256()
    state = {"broken": False}
    written = 0
    ok = False
    try:
        try:
            # A silent network must end the download, not hang the writer.
            curl = subprocess.Popen(
                ["curl", "-fsSL", "--speed-limit", "1", "--speed-time", "60", url],
                stdout=subprocess.PIPE, stderr=curl_err)
            zstd = subprocess.Popen(["zstd", "-dc"], stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE, stderr=zstd_err)
        except OSError as e:
            raise WriteFailed(f"could not start the download: {e}")
        thread = threading.Thread(
            target=_feed, args=(curl.stdout, zstd.stdin, download_hash, state),
            daemon=True)
        thread.start()
        try:
            fd = os.open(device, os.O_WRONLY)
        except OSError as e:
            raise WriteFailed(f"opening {device} failed: {e.strerror or e}")
        since_sync = 0
        while True:
            block = zstd.stdout.read(WRITE_BLOCK)
            if not block:
                break
            image_hash.update(block)
            view = memoryview(block)
            synced = False
            try:
                while view:
                    n = os.write(fd, view)
                    view = view[n:]
                written += len(block)
                since_sync += len(block)
                if since_sync >= SYNC_EVERY:
                    os.fdatasync(fd)
                    since_sync = 0
                    synced = True
            except OSError as e:
                raise WriteFailed(f"writing {device} failed: {e.strerror or e}")
            if synced:  # outside the try: a closed stdout is not a stick error
                progress.progress(written, total)
        try:
            os.fdatasync(fd)
        except OSError as e:
            raise WriteFailed(f"writing {device} failed: {e.strerror or e}")
        progress.progress(written, total)
        thread.join()
        if state["broken"]:
            curl.kill()  # nobody reads it any more
        zstd.wait()
        curl.wait()
        if not state["broken"] and curl.returncode != 0:
            raise WriteFailed(f"the download failed (curl exit {curl.returncode})"
                              + _last_line(curl_err))
        if zstd.returncode != 0 or state["broken"]:
            raise WriteFailed(
                f"the downloaded image could not be unpacked (zstd exit {zstd.returncode})"
                + _last_line(zstd_err))
        ok = True
        return WriteResult(written, image_hash.hexdigest(), download_hash.hexdigest())
    finally:
        if not ok:
            for proc in (curl, zstd):
                if proc is not None and proc.poll() is None:
                    proc.kill()
        if thread is not None:
            thread.join()
        for proc in (curl, zstd):
            if proc is None:
                continue
            for pipe in (proc.stdin, proc.stdout):
                if pipe is not None:
                    try:
                        pipe.close()
                    except OSError:
                        pass
            proc.wait()
        if fd is not None:
            os.close(fd)
        curl_err.close()
        zstd_err.close()


BLKFLSBUF = 0x1261  # <linux/fs.h>: flush the buffer cache of a block device
VERIFY_BLOCK = 1024 * 1024
SHA256_RE = re.compile(r"[0-9a-fA-F]{64}")


def drop_cache(fd: int) -> None:
    """Make the next read of fd come from the device, not from RAM.

    Without this a verify would read back what the kernel still holds from
    the write and could not notice a stick that stored it wrongly.
    Failures are logged and ignored: the read still happens.
    """
    try:
        if stat.S_ISBLK(os.fstat(fd).st_mode):
            fcntl.ioctl(fd, BLKFLSBUF)
    except OSError as e:
        log(f"Could not flush the device cache: {e}")
    try:
        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
    except OSError as e:
        log(f"Could not drop cached pages: {e}")


def verify_device(device: str, length: int, expected_sha256: str,
                  progress: Progress) -> bool:
    """Read length bytes back from the device and compare their SHA-256."""
    try:
        fd = os.open(device, os.O_RDONLY)
    except OSError as e:
        log(f"Cannot read {device} back: {e}")
        return False
    try:
        drop_cache(fd)
        digest = hashlib.sha256()
        done = 0
        while done < length:
            block = os.read(fd, min(VERIFY_BLOCK, length - done))
            if not block:
                log(f"{device} ended after {done} of {length} bytes")
                return False
            digest.update(block)
            done += len(block)
            progress.progress(done, length)
        return digest.hexdigest() == expected_sha256.lower()
    except OSError as e:
        log(f"Cannot read {device} back: {e}")
        return False
    finally:
        os.close(fd)


def expected_download_sha256(base_url: str, name: str) -> Optional[str]:
    """The published SHA-256 of <base_url>/<name>, or None.

    Reads <name>.sha256 in sha256sum format. None when the file is missing
    or malformed. The single place to change if the checksums move into one
    file.
    """
    try:
        r = subprocess.run(
            ["curl", "-fsSL", "--speed-limit", "1", "--speed-time", "60",
             f"{base_url}/{name}.sha256"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    fields = r.stdout.decode("utf-8", "replace").split()
    if len(fields) != 2 or not SHA256_RE.fullmatch(fields[0]):
        return None
    if fields[1].lstrip("*") != name:
        return None
    return fields[0].lower()


# ============ Upgrade Operations ============

def _new_label_block(lines: List[str]) -> List[str]:
    """A "LABEL new" entry copied from "LABEL current", with tl/ -> tl.new/.

    Sticks written before the entry existed lack it. Copying the stick's own
    current entry keeps its kernel options.
    """
    start = next((i for i, l in enumerate(lines) if l.strip() == "LABEL current"), None)
    if start is None:
        return []
    block = ["", "LABEL new"]
    for line in lines[start + 1:]:
        if not line.startswith((" ", "\t")):
            break
        block.append(line.replace("/tl/", "/tl.new/").replace("ramroot=tl/", "ramroot=tl.new/"))
    return block


def set_boot_default(efi_mount: str, label: str) -> None:
    """Make syslinux boot <label> by default, in both config copies.

    After a staged upgrade the next boot must take its kernel from tl.new/:
    only that kernel matches tl.new/ramroot.sqsh, and the initramfs rotates
    tl.new into tl/ only on such a boot (tf_finalize_upgrade), then sets
    DEFAULT current again. Each copy is written to .tmp and renamed over the
    original, so a power cut leaves the old or the new file.
    """
    for rel in SYSLINUX_CFGS:
        path = os.path.join(efi_mount, rel)
        if not os.path.isfile(path):
            continue
        with open(path) as f:
            lines = f.read().splitlines()
        lines = [f"DEFAULT {label}" if l.startswith("DEFAULT ") else l for l in lines]
        if not any(l.strip() == "LABEL new" for l in lines):
            lines += _new_label_block(lines)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write("\n".join(lines) + "\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)


# An APPEND line of syslinux.cfg, and one whose ramroot= is a URL (netboot).
_APPEND_RE = re.compile(r"^[ \t]*APPEND[ \t]", re.I)
_REMOTE_RAMROOT_RE = re.compile(r"[ \t]ramroot=[a-z]+://")
_STICK_WORD_RE = re.compile(r"[ \t]+thinfloe\.stick=[^ \t\r]*")
_LINE_END_RE = re.compile(r"[ \t]*(\r?)$")


def stamp_syslinux(text: str, stick_id: str) -> str:
    """syslinux.cfg text with thinfloe.stick=<id> on every local APPEND line.

    The same edit tf_stamp_stick makes in the initramfs, byte for byte
    (test-esp-choice.sh compares them): on an APPEND line whose ramroot= is
    not a URL, any old thinfloe.stick= word goes and the new one is appended,
    before a trailing CR if the file has CRLF line ends. The initramfs mounts
    the ESP whose config/stick-id the command line names, so a second stick
    attached cannot take the home, the add-ons or the saves.
    """
    lines = text.split("\n")
    for i, line in enumerate(lines):
        if _APPEND_RE.match(line) and not _REMOTE_RAMROOT_RE.search(line):
            line = _STICK_WORD_RE.sub("", line)
            lines[i] = _LINE_END_RE.sub(
                lambda m: f" thinfloe.stick={stick_id}{m.group(1)}", line, count=1)
    return "\n".join(lines)


def _write_replace(path: str, text: str) -> None:
    """Write text to path through path.tmp, fsync and rename."""
    tmp = path + ".tmp"
    with open(tmp, "w", newline="", errors="surrogateescape") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def stamp_new_stick(device: str) -> bool:
    """Give a freshly written drive a new stick id.

    Writes config/stick-id on its ESP and thinfloe.stick=<id> into both
    syslinux.cfg copies (stamp_syslinux). Without it the new stick and the
    one it was made from carry no id, or, when an old stick was overwritten,
    its old one. Never raises: a stick that is not stamped here gets its id
    at its first boot, so this returns False with a warning instead.
    """
    try:
        efi_partition, waited = wait_for_efi_partition(device)
    except KeyboardInterrupt:
        log("WARNING: interrupted - the new stick gets its id at its first boot")
        return False
    if efi_partition is None:
        log(f"WARNING: no {EFI_PARTLABEL} partition found on {device} after "
            f"{waited}s - the new stick gets its id at its first boot")
        return False

    stick_id = str(uuid.uuid4())
    try:
        tmp_mount = tempfile.mkdtemp(prefix="thinfloe-stamp-")
    except OSError as e:
        log(f"WARNING: could not create a temporary mount point: {e} - "
            f"the new stick gets its id at its first boot")
        return False
    _register_cleanup("dir", tmp_mount)
    ok = False
    mounted = False
    try:
        run_cmd(["mount", efi_partition, tmp_mount], capture=True)
        mounted = True
        _register_cleanup("mount", tmp_mount)
        os.makedirs(os.path.join(tmp_mount, "config"), exist_ok=True)
        _write_replace(os.path.join(tmp_mount, "config", "stick-id"), stick_id + "\n")
        for rel in SYSLINUX_CFGS:
            path = os.path.join(tmp_mount, rel)
            if not os.path.isfile(path):
                continue
            with open(path, newline="", errors="surrogateescape") as f:
                text = f.read()
            _write_replace(path, stamp_syslinux(text, stick_id))
        ok = True
    except (subprocess.CalledProcessError, OSError) as e:
        detail = _failure_detail(e) if isinstance(e, subprocess.CalledProcessError) else str(e)
        log(f"WARNING: could not give the new stick its id: {detail} - "
            f"it gets one at its first boot")
    except KeyboardInterrupt:
        log("WARNING: interrupted - the new stick gets its id at its first boot")
    finally:
        if mounted:
            try:
                run_cmd(["umount", tmp_mount], capture=True)
                _unregister_cleanup("mount", tmp_mount)
            except subprocess.CalledProcessError as e:
                log(f"WARNING: could not unmount {tmp_mount}: {e}")
                ok = False
        # rmdir, never rmtree: an unmount that failed leaves the stick here.
        try:
            os.rmdir(tmp_mount)
        except OSError:
            pass
        _unregister_cleanup("dir", tmp_mount)

    if ok:
        log(f"The new stick is {stick_id}")
    return ok


def free_bytes(path: str) -> int:
    """Bytes an unprivileged writer can still put on the filesystem at path."""
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize


def tree_bytes(path: str) -> int:
    """Bytes the files below path occupy on disk; 0 when it does not exist."""
    total = 0
    for root, _dirs, files in os.walk(path):
        for name in files:
            try:
                total += os.lstat(os.path.join(root, name)).st_blocks * 512
            except OSError:
                pass
    return total


def addon_copy_bytes(efi_mount: str) -> int:
    """Bytes of every addons/<id>/current.* (not the .meta files); 0 if none."""
    total = 0
    for path in glob.glob(os.path.join(efi_mount, "addons", "*", "current.*")):
        if path.endswith(".meta"):
            continue
        try:
            total += os.lstat(path).st_size
        except OSError:
            pass
    return total


def do_ab_upgrade(drive: DriveInfo, base_url: str) -> None:
    """Perform A/B upgrade on existing ThinFloe drive"""

    if drive.is_boot:
        # Boot drive - use already mounted partition
        efi_mount = BOOT_EFI_MOUNT
        if not os.path.ismount(efi_mount):
            die(f"Boot EFI partition not mounted at {efi_mount}")
        owned_mount = False
    else:
        # Non-boot drive - mount it
        efi_mount = tempfile.mkdtemp(prefix="thinfloe-upgrade-")
        _register_cleanup("dir", efi_mount)

        result = run_cmd(["mount", drive.efi_partition, efi_mount], check=False, capture=True)
        if result.returncode != 0:
            die(f"Failed to mount EFI partition: {result.stderr}")
        _register_cleanup("mount", efi_mount)
        owned_mount = True

    # Download firmware
    work_dir = tempfile.mkdtemp(prefix="thinfloe-fw-")
    _register_cleanup("dir", work_dir)

    firmware_dir = download_firmware(base_url, work_dir)

    # Paths
    tl_path = os.path.join(efi_mount, "tl")
    tl_old_path = os.path.join(efi_mount, "tl.old")
    tl_new_path = os.path.join(efi_mount, "tl.new")

    # Both paths remove tl.old and tl.new before they write, so their space
    # counts as free. Checked before anything is removed: a stick that cannot
    # take the release keeps its fallback.
    need = int(sum(os.path.getsize(os.path.join(firmware_dir, f))
                   for f in FIRMWARE_FILES) * UPGRADE_SPACE_MARGIN)
    # Room for one next.* beside every installed add-on's current.*, so the
    # daily check can still fetch an update after the upgrade.
    need += addon_copy_bytes(efi_mount)
    have = free_bytes(efi_mount) + tree_bytes(tl_old_path) + tree_bytes(tl_new_path)
    if have < need:
        die(f"Not enough space on {drive.device}: the new release needs "
            f"{need // (1024 * 1024)} MB, {have // (1024 * 1024)} MB can be made "
            f"free. Nothing was changed.")

    if drive.is_boot:
        # Additive upgrade - write to tl.new/, finalized on next boot.
        #
        # tl.old goes first. The rotation on the next boot removes it anyway,
        # and with it in place the stick needed room for three releases: at
        # 775 MB each that does not fit a 2000 MB partition. While tl.new is
        # staged the fallback is tl/, the "current" entry.
        log("Installing firmware to tl.new/ (will activate on reboot)...")

        if os.path.exists(tl_old_path):
            run_cmd(["rm", "-rf", tl_old_path])

        if os.path.exists(tl_new_path):
            run_cmd(["rm", "-rf", tl_new_path])

        run_cmd(["mkdir", "-p", tl_new_path])
        for filename in FIRMWARE_FILES:
            run_cmd(["cp", os.path.join(firmware_dir, filename), tl_new_path])
        # Only after tl.new is complete: DEFAULT new with a partial tl.new
        # would not boot.
        run_cmd(["sync"])
        set_boot_default(efi_mount, "new")
    else:
        # Direct A/B rotation
        log("Rotating firmware (tl -> tl.old, installing new tl)...")

        if os.path.exists(tl_old_path):
            run_cmd(["rm", "-rf", tl_old_path])

        if os.path.exists(tl_path):
            run_cmd(["mv", tl_path, tl_old_path])

        if os.path.exists(tl_new_path):
            run_cmd(["rm", "-rf", tl_new_path])

        run_cmd(["mkdir", "-p", tl_path])
        for filename in FIRMWARE_FILES:
            run_cmd(["cp", os.path.join(firmware_dir, filename), tl_path])
        # A DEFAULT new left from an unfinished upgrade would point at the
        # tl.new just removed.
        set_boot_default(efi_mount, "current")

    run_cmd(["sync"])

    # Cleanup
    if owned_mount:
        run_cmd(["umount", efi_mount])
        _unregister_cleanup("mount", efi_mount)
        shutil.rmtree(efi_mount, ignore_errors=True)
        _unregister_cleanup("dir", efi_mount)

    shutil.rmtree(work_dir, ignore_errors=True)
    _unregister_cleanup("dir", work_dir)

    if drive.is_boot:
        log("Upgrade staged! Reboot to activate new firmware.")
        log("If the new version fails, type 'current' at the boot prompt.")
    else:
        log("Upgrade complete! Previous version saved as fallback.")


def load_exclude_patterns(home_dir: str) -> List[str]:
    """Read the save-home exclude list the way thinfloe-save-home does.

    ~/.save-home-exclude replaces the shipped default (it does not extend it).
    Blank lines and lines starting with # are skipped.
    """
    path = os.path.join(home_dir, ".save-home-exclude")
    if not os.access(path, os.R_OK):
        path = SAVE_HOME_EXCLUDE_DEFAULT
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    return [ln for ln in lines if ln and not ln.startswith("#")]


def _excluded(rel: str, patterns: List[str]) -> bool:
    """Approximately tar's --exclude match for a "./"-relative member name.

    A pattern starting with "./" matches the whole name, anything else a
    trailing part after a slash; "*" matches "/" as it does in tar. Used only
    to skip what tar will leave out anyway, so a near miss costs a log line.
    """
    return any(
        fnmatch.fnmatchcase(rel, p if p.startswith("./") else "*/" + p)
        for p in patterns
    )


def large_files(home_dir: str, patterns: List[str]) -> List[Tuple[int, str]]:
    """(size, "./"-relative name) of each regular file above the size limit.

    Directories and files the patterns exclude are skipped, and symlinks are
    not followed.
    """
    found = []
    for root, dirs, files in os.walk(home_dir):
        rel_root = "." + root[len(home_dir):]
        dirs[:] = [d for d in dirs
                   if not _excluded(f"{rel_root}/{d}", patterns)]
        for name in files:
            rel = f"{rel_root}/{name}"
            if _excluded(rel, patterns):
                continue
            try:
                st = os.lstat(os.path.join(root, name))
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode) and st.st_size > SAVE_HOME_MAX_FILE_BYTES:
                found.append((st.st_size, rel))
    return sorted(found, key=lambda f: f[1])


def tar_literal(name: str) -> str:
    """An --exclude pattern that matches exactly this name: wildcard
    characters are escaped. A newline needs nothing, as an argument carries it.
    """
    return re.sub(r"([\\*?\[\]])", r"\\\1", name)


def home_archive_argv(home_dir: str, dest: str) -> List[str]:
    """Build the tar command line for a new stick's home.tar.gz.

    restore_home() in the initramfs unpacks this archive into the home
    directory itself, so the members must be relative: -C <home> with a bare
    ".". The excludes are the save-home list plus IDENTITY_EXCLUDES, plus
    every file above SAVE_HOME_MAX_FILE_BYTES, each one named in the log.
    """
    patterns = load_exclude_patterns(home_dir) + list(IDENTITY_EXCLUDES)
    excludes = [f"--exclude={p}" for p in patterns]
    limit_mb = SAVE_HOME_MAX_FILE_BYTES // (1024 * 1024)
    for size, rel in large_files(home_dir, patterns):
        log(f"not copied ({size // (1024 * 1024)} MB, over {limit_mb} MB): "
            f"{rel.replace(chr(10), '?')}")
        excludes.append(f"--exclude={tar_literal(rel)}")
    return ["tar", "-C", home_dir, *excludes, "-czf", dest, "."]


def _failure_detail(e: subprocess.CalledProcessError) -> str:
    """What to show for a failed command: its stderr, else the exception text.

    str(e) is the whole command line (every --exclude for tar), which hides
    the one thing the person needs to see, e.g. "No space left on device".
    """
    stderr = e.stderr
    if isinstance(stderr, bytes):
        stderr = stderr.decode("utf-8", "replace")
    stderr = (stderr or "").strip()
    return stderr if stderr else str(e)


def home_restore_failed() -> bool:
    """True when this boot's home restore failed (the home is a default one).

    A missing or unreadable marker means "proceed": it is absent on a first
    boot and on an initramfs that predates it, same as thinfloe-save-home.
    """
    try:
        with open(os.path.join(STATE_DIR, "home-restore"),
                  encoding="utf-8", errors="replace") as f:
            return f.read().strip() == "failed"
    except OSError:
        return False


def wait_for_efi_partition(device: str) -> Tuple[Optional[str], int]:
    """The EFI-SYSTEM partition of a drive just written, and the seconds waited.

    udev may not have re-read the partition table yet, so this looks again
    every second for EFI_RETRY_SECONDS. None when it never appears.
    """
    waited = 0
    efi_partition = find_efi_partition(device)
    while efi_partition is None and waited < EFI_RETRY_SECONDS:
        time.sleep(1)
        waited += 1
        efi_partition = find_efi_partition(device)
    return efi_partition, waited


def copy_home_to_drive(device: str) -> bool:
    """Write this machine's home directory onto a freshly installed drive.

    Returns True when a verified home.tar.gz is on the drive's EFI partition.
    Never raises: the install has already succeeded by the time this runs, and
    a failed copy must not turn a good install into a traceback.
    """
    # Never $HOME, ~, Path.home() or SUDO_USER. This process is root by now,
    # so HOME is /root, and SUDO_USER is unset for a VT root login - which is
    # reachable because root has no password. The same defect in
    # thinfloe-save-home archived root's dotfiles over the user's home.
    try:
        home_dir = pwd.getpwnam(TFUSER).pw_dir
    except KeyError:
        log(f"WARNING: no {TFUSER} account on this system - home not copied")
        return False

    if not os.path.isdir(home_dir):
        log(f"WARNING: {home_dir} is not a directory - home not copied")
        return False

    # The same refusal thinfloe-save-home makes: after a failed restore the live
    # home is the shipped default, and copying it would pass that off as the
    # machine's configuration.
    if home_restore_failed():
        log("WARNING: this boot's home restore failed, so the home here is a "
            "default one - home not copied")
        return False

    try:
        efi_partition, waited = wait_for_efi_partition(device)
    except KeyboardInterrupt:
        log("WARNING: home copy interrupted - home not copied")
        return False
    if efi_partition is None:
        log(f"WARNING: no {EFI_PARTLABEL} partition found on {device} after "
            f"{waited}s - home not copied")
        return False

    try:
        tmp_mount = tempfile.mkdtemp(prefix="thinfloe-home-")
    except OSError as e:
        log(f"WARNING: could not create a temporary mount point: {e} - "
            f"home not copied")
        return False
    _register_cleanup("dir", tmp_mount)
    dest = os.path.join(tmp_mount, HOME_ARCHIVE_NAME)
    ok = False
    mounted = False

    try:
        run_cmd(["mount", efi_partition, tmp_mount], capture=True)
        mounted = True
        _register_cleanup("mount", tmp_mount)

        log(f"Copying {home_dir} to {device} (without SSH host keys and wg0.conf)")
        try:
            run_cmd(home_archive_argv(home_dir, dest), capture=True)
        except subprocess.CalledProcessError as e:
            # GNU tar exits 1 for "file changed as we read it" - a socket, a
            # dangling symlink, a file being written - and still produces a
            # usable archive. Only 2 and above are real errors.
            if e.returncode == 1:
                detail = _failure_detail(e) if e.stderr else ""
                log("NOTE: some files changed while being archived; the copy "
                    "is usable" + (f" ({detail})" if detail else ""))
            else:
                raise

        # tar can succeed on a stick that is failing; a bad home.tar.gz may be
        # accepted by the next boot in place of a good home.
        run_cmd(["gzip", "-t", dest], capture=True)

        # The archive is in the page cache until this returns. A stick pulled
        # out before it lands carries an empty or partial file.
        run_cmd(["sync"], capture=True)
        ok = True
    except subprocess.CalledProcessError as e:
        log(f"WARNING: could not copy the home directory: {_failure_detail(e)}")
        if os.path.isfile(dest):
            # A truncated home.tar.gz is worse than none at all.
            try:
                os.unlink(dest)
            except OSError:
                pass
        ok = False
    except OSError as e:
        log(f"WARNING: could not copy the home directory: {e}")
        ok = False
    except KeyboardInterrupt:
        log("WARNING: home copy interrupted - home not copied")
        ok = False
    finally:
        # Whatever ended the copy early, a partial home.tar.gz must not stay on
        # the stick: the next boot's restore only checks that the first member
        # lists, so a truncated archive would unpack a partial home.
        if mounted and not ok and os.path.isfile(dest):
            try:
                os.unlink(dest)
            except OSError as e:
                log(f"WARNING: could not remove the partial {dest}: {e}")
        if mounted:
            try:
                run_cmd(["umount", tmp_mount], capture=True)
                _unregister_cleanup("mount", tmp_mount)
            except subprocess.CalledProcessError as e:
                log(f"WARNING: could not unmount {tmp_mount}: {e} - the copied "
                    f"home may be incomplete")
                ok = False
        # rmdir, never rmtree: if the unmount failed, the directory is still
        # the stick, and a recursive delete would wipe the copy (and the
        # stick's other files). rmdir on a busy mount point just fails.
        try:
            os.rmdir(tmp_mount)
        except OSError:
            pass
        _unregister_cleanup("dir", tmp_mount)

    if ok:
        log(f"Home directory copied to {device}")
    return ok


class Cancelled(Exception):
    """The batch caller asked to stop (SIGTERM)."""


WIPE_BYTES = 1024 * 1024


def wipe_partition_tables(device: str) -> bool:
    """Zero the first and the last MiB so a cut-off write cannot boot.

    The first MiB holds the MBR, the GPT and syslinux's boot code, the last
    one the backup GPT. Never raises; False (logged) when it could not.
    SIGTERM is ignored meanwhile: a second one must not leave the stick
    half-cleared.
    """
    try:
        old = signal.signal(signal.SIGTERM, signal.SIG_IGN)
    except ValueError:  # not the main thread
        old = None
    try:
        fd = os.open(device, os.O_WRONLY)
        try:
            size = os.lseek(fd, 0, os.SEEK_END)
            zeros = bytes(WIPE_BYTES)
            if size < 2 * WIPE_BYTES:
                spans = [(0, size)]
            else:
                spans = [(0, WIPE_BYTES), (size - WIPE_BYTES, WIPE_BYTES)]
            for start, length in spans:
                os.lseek(fd, start, os.SEEK_SET)
                left = length
                while left > 0:
                    n = os.write(fd, zeros[:left])
                    if n <= 0:
                        raise OSError(errno.EIO, "short write")
                    left -= n
            os.fdatasync(fd)
        finally:
            os.close(fd)
        run_cmd(["partprobe", device], check=False, capture=True)
        return True
    except BaseException as e:
        if not isinstance(e, Exception):
            raise
        log(f"could not clear the partition tables of {device}: {e}")
        return False
    finally:
        if old is not None:
            signal.signal(signal.SIGTERM, old)


@dataclass
class FreshOutcome:
    ok: bool
    reason: str = ""
    written: bool = False  # the stick passed write, checksum and verify
    cancelled: bool = False
    home_copied: Optional[bool] = None  # None: not asked for
    home_saved: bool = False


def fresh_install(drive: DriveInfo, base_url: str, copy_home: bool,
                  verify: bool, progress: Progress, save: bool = True,
                  stamp_required: bool = True) -> FreshOutcome:
    """Write the image to a drive and finish the stick.

    Used by both modes. A failure during write, checksum or verify leaves
    a stick that may half-boot, so it is wiped. Once verify passed the
    stick is good and later failures only fail the report.
    """
    device = drive.device
    image_name = "thinfloe-usb.img.zst"
    image_url = f"{base_url}/{image_name}"
    outcome = FreshOutcome(ok=False)
    stick_good = False
    try:
        try:
            progress.step("write", "Downloading and writing")
            result = stream_image(image_url, device, image_size(image_url), progress)
            expected = expected_download_sha256(base_url, image_name)
            if expected is None:
                log(f"checksum not checked: {image_name}.sha256 not found")
            elif expected != result.download_sha256:
                raise WriteFailed("the download was damaged; write the stick again")
            progress.done("write")
            if verify:
                progress.step("verify", "Checking the stick")
                if not verify_device(device, result.written, result.image_sha256,
                                     progress):
                    raise WriteFailed("the stick did not read back what was written")
                progress.done("verify")
            stick_good = True
            outcome.written = True
        except (WriteFailed, Cancelled) as e:
            wipe_partition_tables(device)
            if isinstance(e, Cancelled):
                outcome.cancelled = True
                outcome.reason = "cancelled"
            else:
                outcome.reason = e.reason
            return outcome

        run_cmd(["sync"])
        run_cmd(["partprobe", device], check=False, capture=True)

        # Its own id, so a boot with this stick and another one attached
        # finds this stick's ESP.
        progress.step("stamp", "Marking the stick")
        stamped = stamp_new_stick(device)
        if not stamped and stamp_required:
            outcome.reason = "the stick id could not be written to the stick"
            return outcome
        progress.done("stamp")

        problems = []
        if copy_home:
            progress.step("home", "Copying the home directory")
            outcome.home_copied = copy_home_to_drive(device)
            if outcome.home_copied:
                progress.done("home")
            else:
                problems.append("the home directory could not be copied to the stick")
        if save:
            progress.step("save", "Saving this machine's home")
            outcome.home_saved = save_home_before_finish() == 0
            if outcome.home_saved:
                progress.done("save")
            else:
                problems.append("this machine's home could not be saved")
        if problems:
            outcome.reason = "the stick is written, but " + "; ".join(problems)
            return outcome
        outcome.ok = True
        return outcome
    except Cancelled:
        # After verify passed: the stick is good, nothing to wipe.
        outcome.cancelled = True
        outcome.reason = "cancelled"
        if not stick_good:
            wipe_partition_tables(device)
        return outcome


def do_fresh_install(drive: DriveInfo, base_url: str) -> Optional[bool]:
    """Write fresh image to drive.

    Returns None when the home copy was not asked for or declined, otherwise
    whether it succeeded. The install itself counts as done either way.
    """

    check_drive_fits(base_url, drive.device)

    print_header("WARNING - Data Loss")
    print(f"\n  This will ERASE ALL DATA on {drive.device}!")
    print(f"\n  Device: {drive.device}")
    print(f"  Model:  {drive.model}")
    print(f"  Size:   {drive.size}")
    print()

    if not confirm("  Continue?"):
        die("Aborted")

    # Offer to carry this machine's configuration across; otherwise the new
    # stick boots with the shipped default home. Nothing is copied without an
    # explicit "y": confirm() re-asks on an empty answer and treats EOF or
    # Ctrl-C as no (the person may be building a stick for somebody else).
    # Asked only here - the A/B upgrade path writes to a drive that already
    # carries its own home. Asked before the write now, so the write and
    # what follows it run without a pause.
    print()
    print("  This machine's home directory holds its WiFi credentials,")
    print("  ThinLinc settings and customisations. Copying it onto the new")
    print("  drive means it boots configured. The SSH host keys and wg0.conf")
    print("  are not copied, so the new machine keeps its own identity.")
    print()
    copy_home = confirm("  Copy this machine's home directory to the new drive?")

    # main() saves the home afterwards; a stamp that fails only warns, the
    # stick then gets its id at its first boot.
    outcome = fresh_install(drive, base_url, copy_home, False, PROGRESS,
                            save=False, stamp_required=False)
    if not outcome.written:
        die(f"Failed to write image: {outcome.reason}")

    log("Fresh install complete!")
    return outcome.home_copied


# ============ Drive Display ============

def format_drive_info(d: DriveInfo) -> str:
    """Format drive information for display"""
    parts = [d.device, d.size]

    if d.model and d.model != "Unknown":
        parts.append(d.model)

    if d.label:
        parts.append(f'"{d.label}"')

    return " ".join(parts)


def format_drive_status(d: DriveInfo) -> str:
    """Format drive status tags"""
    tags = []

    if d.is_boot:
        tags.append("<<< BOOT DRIVE >>>")

    if d.is_thinfloe:
        tags.append("[ThinFloe]")
        if d.has_tl_old:
            tags.append("[has fallback]")
        if d.has_tl_new:
            tags.append("[pending upgrade]")
    elif d.efi_partition:
        tags.append("[has EFI]")
    else:
        tags.append("[empty]")

    return " ".join(tags)


SHOW_ALL = "show-all"


def show_drives_with_operations(drives: List[DriveInfo], offer_all: bool = False):
    """
    Show all drives with their available operations.
    Returns (selected_drive, operation), None if cancelled, or SHOW_ALL when
    offer_all was set and the user asked for the unfiltered list.
    """
    print_header("Available Drives")
    print()

    # Build list of all options across all drives
    options = []
    option_num = 1

    for d in drives:
        # Print drive info header
        info = format_drive_info(d)
        status = format_drive_status(d)
        print(f"  {info}")
        print(f"    {status}")

        # Determine available operations for this drive
        if d.is_boot:
            # Boot drive: only upgrade available
            print(f"    {option_num}) Upgrade firmware (A/B, activates on reboot)")
            options.append((d, "upgrade"))
            option_num += 1
        elif d.is_thinfloe:
            # Other ThinFloe drive: upgrade or overwrite
            print(f"    {option_num}) Upgrade firmware (A/B with fallback)")
            options.append((d, "upgrade"))
            option_num += 1
            print(f"    {option_num}) Overwrite entire drive (fresh install)")
            options.append((d, "overwrite"))
            option_num += 1
        else:
            # Non-ThinFloe drive: only overwrite
            print(f"    {option_num}) Install ThinFloe (overwrites entire drive)")
            options.append((d, "overwrite"))
            option_num += 1

        print()

    if offer_all:
        print("  a) show all drives")
    print(f"  0) Cancel")
    print()

    while True:
        try:
            choice = input("Select option: ").strip()
            if not choice:
                continue
            if offer_all and choice.lower() == "a":
                return SHOW_ALL

            num = int(choice)
            if num == 0:
                return None
            if 1 <= num <= len(options):
                return options[num - 1]

            print("Invalid choice. Please try again.")
        except ValueError:
            print("Please enter a number.")
        except (KeyboardInterrupt, EOFError):
            print()
            return None


# ============ Home Save ============

# thinfloe-save-home's own bound on waiting for the boot server is 60 seconds,
# and the tar and upload come after it. A 60 second timeout here therefore
# killed the child while it was uploading, and the bare `except Exception:
# pass` around it discarded both the timeout and any failure, so a user whose
# home was not saved was told the operation completed successfully.
SAVE_HOME_TIMEOUT = 600

# Exit codes from thinfloe-save-home. See the table at the top of that script.
SAVE_HOME_MESSAGES = {
    0: None,  # saved; nothing to say
    1: "the home directory could not be found",
    2: "this boot's home restore had failed, so saving was refused",
    3: "the boot server could not be reached",
    4: "this machine has nowhere to store a home directory",
    5: "the save was attempted and failed",
}


def save_home_before_finish() -> int:
    """Save the home directory before the user reboots.

    Returns thinfloe-save-home's exit status, or -1 if it could not be run.
    Never raises: a failed save must not lose the install that just
    succeeded, but it must not be hidden either.
    """
    log("Saving the home directory (this can take a few minutes on netboot)...")
    try:
        result = subprocess.run(
            ["thinfloe-save-home"],
            capture_output=True,
            timeout=SAVE_HOME_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        log(f"WARNING: saving the home directory timed out after "
            f"{SAVE_HOME_TIMEOUT}s - it may be incomplete")
        return -1
    except (FileNotFoundError, OSError) as e:
        log(f"WARNING: could not run thinfloe-save-home: {e}")
        return -1

    if result.returncode == 0:
        return 0

    reason = SAVE_HOME_MESSAGES.get(
        result.returncode, f"it exited {result.returncode}"
    )
    log(f"WARNING: your home directory was NOT saved - {reason}")
    stderr = result.stderr.decode("utf-8", "replace").strip()
    if stderr:
        for line in stderr.splitlines():
            print(f"    {line}", file=sys.stderr)
    return result.returncode


# ============ Main ============

def print_outcome_lines(home_copied: Optional[bool], home_saved: bool) -> None:
    """One line per outcome, so the closing screen cannot contradict a warning.

    The install succeeded either way; these lines say what else did not.
    """
    if home_copied is True:
        print("  Home directory copied to the new drive.")
    elif home_copied is False:
        print("  Home directory NOT copied to the new drive - the reason "
              "was printed above.")
    if home_saved:
        print("  Home directory saved.")
    else:
        print("  Home directory NOT saved - see the warning above.")


# ============ Batch interface ============

def batch_fresh(drive: DriveInfo, args, progress: Progress) -> int:
    """Exit 0 ok, 1 failed (reason reported), 130 cancelled."""
    outcome = fresh_install(drive, args.source, args.copy_home, args.verify,
                            progress)
    if outcome.ok:
        progress.result(True, "")
        return 0
    progress.result(False, outcome.reason)
    return 130 if outcome.cancelled else 1


def batch_upgrade(drive: DriveInfo, args, progress: Progress) -> int:
    progress.result(False, "not implemented yet")
    return 1


class UsageError(Exception):
    pass


class _BatchArgumentParser(argparse.ArgumentParser):
    """Reports a usage error as an exception, so main can print @result."""

    def error(self, message):
        self.print_usage(sys.stderr)
        raise UsageError(message)


def _batch_parser() -> argparse.ArgumentParser:
    parser = _BatchArgumentParser(prog="thinfloe-upgrade", allow_abbrev=False)
    sub = parser.add_subparsers(dest="command", required=True)
    d = sub.add_parser("drives", help="list drives as JSON", allow_abbrev=False)
    d.add_argument("--all", action="store_true", help="include internal drives")
    d.add_argument("--source", default=DEFAULT_URL)
    w = sub.add_parser("write", help="write or upgrade a stick without questions",
                       allow_abbrev=False)
    w.add_argument("--device", required=True)
    w.add_argument("--mode", required=True, choices=("fresh", "upgrade"))
    w.add_argument("--expect-id", required=True)
    w.add_argument("--source", default=DEFAULT_URL)
    w.add_argument("--copy-home", action="store_true")
    w.add_argument("--verify", action="store_true")
    w.add_argument("--allow-internal", action="store_true")
    return parser


def _write_refusal(args, drive: Optional[DriveInfo]) -> Optional[str]:
    """Why this write must not start, or None. Nothing is opened before."""
    if drive is None:
        return f"{args.device} is not a drive this tool may write"
    if drive_identity(drive) != args.expect_id:
        return f"{args.device} does not match the drive that was chosen"
    if args.mode == "fresh":
        if drive.is_boot:
            return f"{args.device} is the boot drive and cannot be overwritten"
        if drive.mounted:
            return f"{args.device} is mounted and cannot be overwritten"
        size = image_size(f"{args.source}/thinfloe-usb.img.zst")
        if size is not None and drive.size_bytes < size:
            return f"{args.device} is too small for the image"
    else:
        if not drive.is_thinfloe:
            return f"{args.device} is not a ThinFloe drive and cannot be upgraded"
        if drive.mounted and not drive.is_boot:
            return f"{args.device} is mounted and cannot be upgraded"
    if args.copy_home:
        if args.mode != "fresh":
            return "copying the home directory only works with a fresh install"
        if home_restore_failed():
            return "the home directory of this boot was not restored, so it is not copied"
    return None


def _cancel_on_sigterm(signum, frame):
    raise Cancelled()


def batch_main(argv: List[str]) -> int:
    """The question-free commands `drives` and `write`."""
    global PROGRESS
    PROGRESS = Progress(sys.stdout, batch=True)
    try:
        args = _batch_parser().parse_args(argv)
    except UsageError as e:
        PROGRESS.result(False, f"usage: {e}")
        return 2
    except SystemExit as e:  # --help
        return e.code if isinstance(e.code, int) else 2
    args.source = getattr(args, "source", DEFAULT_URL).rstrip("/")

    old_handler = signal.signal(signal.SIGTERM, _cancel_on_sigterm)
    try:
        return _batch_run(args)
    except Cancelled:
        PROGRESS.result(False, "cancelled")
        return 130
    except Exception as e:
        import traceback
        traceback.print_exc()
        PROGRESS.result(False, f"{type(e).__name__}: {e}")
        return 1
    finally:
        signal.signal(signal.SIGTERM, old_handler)


def _batch_run(args) -> int:
    ensure_root(batch=True)

    if args.command == "drives":
        drives = enumerate_drives(include_internal=args.all)
        size = image_size(f"{args.source}/thinfloe-usb.img.zst")
        print(drives_json(drives, size))
        return 0

    drives = enumerate_drives(include_internal=args.allow_internal)
    drive = next((d for d in drives if d.device == args.device), None)
    reason = _write_refusal(args, drive)
    if reason is not None:
        PROGRESS.result(False, reason)
        return 2
    if args.mode == "fresh":
        return batch_fresh(drive, args, PROGRESS)
    return batch_upgrade(drive, args, PROGRESS)


def main() -> int:
    """Main entry point"""
    if len(sys.argv) > 1 and sys.argv[1] in ("drives", "write"):
        return batch_main(sys.argv[1:])
    try:
        ensure_root()

        # Step 1: Select firmware source first
        base_url = select_source()
        if base_url is None:
            return 0

        # Ensure URL doesn't end with /
        base_url = base_url.rstrip("/")

        # Step 2: Enumerate drives
        drives = enumerate_drives()
        if not drives:
            die("No suitable drives found")

        # Step 3: Show drives and let user select operation
        result = show_drives_with_operations(drives, offer_all=True)
        if result == SHOW_ALL:
            drives = enumerate_drives(include_internal=True)
            if not drives:
                die("No suitable drives found")
            result = show_drives_with_operations(drives)
        if result is None:
            return 0

        drive, operation = result

        # Step 4: Execute the selected operation
        home_copied: Optional[bool] = None
        if operation == "upgrade":
            # Confirm upgrade
            print_header("Confirm Upgrade")
            print(f"\n  Target: {format_drive_info(drive)}")
            print(f"  Source: {base_url}")
            if drive.is_boot:
                print(f"  Mode:   Additive (writes to tl.new/, activates on reboot)")
            else:
                print(f"  Mode:   A/B upgrade (current -> tl.old, new -> tl)")
            print()

            if not confirm("  Proceed?"):
                return 0

            do_ab_upgrade(drive, base_url)
        else:
            # Fresh install (overwrite)
            if drive.is_boot:
                die("Cannot overwrite the boot drive while running!")
            home_copied = do_fresh_install(drive, base_url)

        # Save home before a potential reboot. A failure here is reported and
        # does not fail the install, which has already succeeded.
        home_saved = save_home_before_finish() == 0

        print_header("Success")
        print("\n  Operation completed successfully!")
        print_outcome_lines(home_copied, home_saved)
        if operation == "upgrade" and drive.is_boot:
            print("\n  Reboot to activate the new firmware.")
            print("  If it fails, select 'previous' at boot menu.")
        print()

        return 0

    except KeyboardInterrupt:
        print("\n\nCancelled.")
        return 130

    except Exception as e:
        print(f"\nERROR: {e}", file=sys.stderr)
        import traceback
        traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(main())
