#!/bin/sh
# Body of the graphical session, run by labwc via 'labwc -S'.
#
# The body of the session is thinfloe-menu, the tile grid. ThinLinc is one of
# its tiles. The menu saves the home directory itself before it exits, so
# this script does not save; it reads the menu's exit status (see the end
# of this file).
#
# When this script returns, labwc terminates and the tty1 login starts a
# fresh session. Leaving the compositor running would strand the user on a
# bare desktop with no keybindings and no way to recover.
# NOTE: the home directory has ALREADY been restored, by restore_home() in
# the initramfs before the pivot - not by this script or its caller. It has
# to happen there so a user's ~/.thinfloe-environment (keyboard layout, cursor)
# is on disk before labwc reads XKB_DEFAULT_* at startup, and so the SSH host
# keys inside it are available before sshd starts. Do not add a restore call
# here - it would overwrite the running session's home with the on-disk copy
# midway through.

# Monitor layout. The menu writes ~/.config/kanshi/config and kanshi is the
# only thing that sets outputs. A new layout stays unconfirmed until the person
# confirms it within 15 s; the menu leaves the marker below while it waits.
# Finding it here means the session ended in that window: put the old layout
# back BEFORE kanshi starts, so kanshi never applies the unconfirmed one.
#   prev   restore config.prev over config
#   none   there was no config before: remove config
#   other  unknown content: leave the config alone
kanshi_dir=$HOME/.config/kanshi
layout_marker=${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/thinfloe-layout-unconfirmed}
if [ -n "$layout_marker" ] && [ -e "$layout_marker" ]; then
    read -r layout_undo <"$layout_marker" 2>/dev/null || true
    case "$layout_undo" in
        prev)
            if [ -e "$kanshi_dir/config.prev" ]; then
                mv -f "$kanshi_dir/config.prev" "$kanshi_dir/config"
            else
                echo "thinfloe: unconfirmed layout without config.prev: removing the kanshi config" >&2
                rm -f "$kanshi_dir/config"
            fi
            ;;
        none)
            rm -f "$kanshi_dir/config" "$kanshi_dir/config.prev"
            ;;
    esac
    rm -f "$layout_marker"
fi
# Per-device session customisation, sourced after the home restore so the
# user's own saved copy wins.
#
# This is the Wayland replacement for ~/.xsessionrc, which the move off X11
# removed. That file was how people configured individual machines - display
# layout with xrandr, keyboard, netplan/WiFi - and because it lives in $HOME
# it is captured by save-home and restored on every boot, so edits persist
# without rebuilding an image.
#
# Displays: wlr-randr is the xrandr equivalent for this compositor, e.g.
#   wlr-randr --output DP-1 --transform 90 --pos 1920,0
# For layouts that must survive a monitor being switched on late or waking
# from DPMS, run kanshi from here instead - it reapplies on hotplug, which a
# one-shot wlr-randr does not.
#
# Sourced rather than executed, matching ~/.xsessionrc semantics: no execute
# bit needed, and it can export variables into the session.
#
# It runs BEFORE the menu, and so before any tile starts tlclient, because the ThinLinc client reads the monitor
# layout once at startup - a rotation applied afterwards would leave the
# client believing a portrait screen is still landscape.
if [ -r "$HOME/.thinfloe-sessionrc" ]; then
    . "$HOME/.thinfloe-sessionrc"
fi

# Background helpers. Every one of them must die with the session: labwc
# terminates when this script returns, and an orphan would linger against the
# next session's compositor. The traps below kill all of them, so adding a
# helper means appending its PID here and nothing else.
HELPER_PIDS=""
# $! too: a helper forked just before a signal is not in the list yet.
kill_helpers() {
    for _p in $HELPER_PIDS $!; do
        kill "$_p" 2>/dev/null
    done
}
# INT or TERM before the menu starts ends the session, and the EXIT trap
# kills the helpers; without the exit the shell would go on and start the
# menu with its helpers already dead. Once the menu has started, the trap
# does nothing: dash holds it until the menu has ended, the menu's exit
# status decides as usual, and the helpers end with the session, so a
# failure window still blanks the screen. A trap that killed them here
# would also catch a signal between "menu_started=1" and the menu's fork,
# and the menu would run without them.
# shellcheck disable=SC2329 # run by the INT and TERM traps
tf_signalled() {
    [ -n "$menu_started" ] || exit "$1"
}
menu_started=
trap kill_helpers EXIT
trap 'tf_signalled 130' INT
trap 'tf_signalled 143' TERM

# Screen blanking. Wayland splits this in two: labwc reports idleness via
# ext_idle_notifier_v1 but has no timeout of its own, so without a policy
# daemon listening nothing ever blanks. That is what was lost moving off X11,
# where the X server did it internally (xset s / server-side DPMS).
#
# wlopm - not wlr-randr - is the right tool. wlr-randr --off speaks the output
# *management* protocol and disables the output outright, changing the monitor
# layout and resizing the fullscreen ThinLinc client. wlopm speaks output
# *power* management, which is true DPMS: the panel sleeps, the layout is
# untouched, any input wakes it.
#
# No locking. ext_session_lock_manager_v1 is available, but tfuser has no
# password, so a lock screen would have nothing to authenticate against -
# session security is ThinLinc's job, not the local compositor's.
#
# Note the ThinLinc client is an X11 app under Xwayland and cannot send an
# idle inhibit, so a long video inside the remote session with no input will
# blank the local screen. Any keypress restores it.
#
# The timeout, in seconds, 0 for never:
#   ~/.config/thinfloe/screen, the file the menu's Screen tab writes: the
#     last line idle_timeout=<digits>, 0 to 86400. Any other value counts
#     as no value. Without a value it is 300.
#   ~/.thinfloe-sessionrc, sourced above, wins over that file:
#     TF_IDLE_TIMEOUT=900   longer grace period
#     TF_IDLE_TIMEOUT=0     disable blanking entirely (so does any value that
#                           is not a positive number)
#     DBRRG_IDLE_TIMEOUT, its name before 4.0, is read when TF_IDLE_TIMEOUT
#     is unset
#
# The menu changes the file and then sends SIGUSR1 to TF_IDLE_PID, so the
# new timeout applies at once. That PID is a helper loop of its own, not
# this shell: dash runs a trap only after the foreground command has ended,
# so a SIGUSR1 to this shell would wait until the menu exits. Running the
# menu in the background instead would make it, and every program it
# starts, ignore SIGINT, and Ctrl-C in a terminal would stop working.
# TF_IDLE_TIMEOUT_RC=1 tells the menu that the sessionrc sets the timeout,
# and TF_IDLE_TIMEOUT is then the one in force, as plain digits, so the
# menu can show it without reading a shell file.
if [ -n "${TF_IDLE_TIMEOUT:-}" ] || [ -n "${DBRRG_IDLE_TIMEOUT:-}" ]; then
    : "${TF_IDLE_TIMEOUT:=$DBRRG_IDLE_TIMEOUT}"
    if [ "$TF_IDLE_TIMEOUT" -gt 0 ] 2>/dev/null; then
        # [ ] takes " 900", "+900" and "0900" as 900; so do swayidle and the
        # menu from here on.
        TF_IDLE_TIMEOUT=$(printf '%s\n' "$TF_IDLE_TIMEOUT" | tr -d ' \t+' | sed 's/^0*//')
    else
        TF_IDLE_TIMEOUT=0
    fi
    TF_IDLE_TIMEOUT_RC=1
    export TF_IDLE_TIMEOUT TF_IDLE_TIMEOUT_RC
else
    unset TF_IDLE_TIMEOUT_RC
fi
unset TF_IDLE_PID

# The timeout for the next swayidle, by the rules above. The file rule is
# the menu's: digits only, read as decimal, at most 86400.
tf_idle_timeout() {
    if [ "${TF_IDLE_TIMEOUT_RC:-}" = 1 ]; then
        if [ "$TF_IDLE_TIMEOUT" -gt 0 ] 2>/dev/null; then
            echo "$TF_IDLE_TIMEOUT"
        else
            echo 0
        fi
        return
    fi
    _v=$(sed -n 's/^idle_timeout=//p' "$HOME/.config/thinfloe/screen" 2>/dev/null | tail -n 1)
    _v=${_v%"$(printf '\r')"}
    case $_v in
        ''|*[!0-9]*) echo 300; return ;;
    esac
    while [ "${#_v}" -gt 1 ] && [ "${_v#0}" != "$_v" ]; do
        _v=${_v#0}
    done
    if [ "${#_v}" -le 5 ] && [ "$_v" -le 86400 ]; then
        echo "$_v"
    else
        echo 300
    fi
}

# One swayidle at a time, restarted with a fresh timeout on SIGUSR1.
#
# Every child is started in the background and waited for, the back-off
# sleep too: dash runs a trap only once a foreground command has ended, and
# the helper would then outlive the session. A swayidle that ends by itself
# is restarted after 5 s, so a crashing one does not spin.
#
# The traps kill the child by $!, which is set the moment it is forked (a
# variable assigned after the fork would leave a gap), and by _c, which
# names it while the helper waits. dash drops a signal that reaches a child
# it has forked but not yet set up, so a killed child gets the signal again
# after 0.1 s; it is not reaped before that, so its PID is still its own.
# shellcheck disable=SC2329 # run by the idle loop's traps
tf_idle_kill() {
    kill "$!" ${_c:+"$_c"} 2>/dev/null
}

# Run "$@" in the background until it ends, or until SIGUSR1 ends it.
tf_idle_child() {
    "$@" &
    _c=$!
    # A SIGUSR1 that came after the timeout was read: start again.
    [ "$_reread" = 1 ] && kill "$_c" 2>/dev/null
    wait "$_c"
    while kill -0 "$_c" 2>/dev/null; do
        if [ "$_reread" = 1 ]; then
            sleep 0.1 &
            wait "$!"
            kill "$_c" 2>/dev/null
        fi
        wait "$_c"
    done
    _c=
}

tf_idle_loop() {
    # $! inherited from this shell may name a program the sessionrc started;
    # a child of the loop's own replaces it before the traps exist.
    : &
    wait "$!"
    _c=
    _reread=0
    trap '_reread=1; tf_idle_kill' USR1
    trap 'tf_idle_kill; sleep 0.1; tf_idle_kill; exit 0' TERM
    while :; do
        _reread=0
        _t=$(tf_idle_timeout)
        if [ "$_t" -gt 0 ]; then
            tf_idle_child swayidle -w \
                timeout "$_t" 'wlopm --off \*' \
                resume 'wlopm --on \*'
        else
            tf_idle_child sleep 2147483647
        fi
        [ "$_reread" = 1 ] || tf_idle_child sleep 5
    done
}

if command -v swayidle >/dev/null 2>&1 &&
   command -v wlopm >/dev/null 2>&1; then
    tf_idle_loop &
    TF_IDLE_PID=$!
    export TF_IDLE_PID
    HELPER_PIDS="$HELPER_PIDS $TF_IDLE_PID"
fi

# The menu, overridable so test/integration/test-session-lifecycle.sh can
# run this script unprivileged.
TF_MENU="${TF_MENU:-/usr/bin/thinfloe-menu}"
# Where the menu's exit status is left for 10-thinfloe-session.sh. labwc always
# exits 0 whatever this script returns, so this file is the only way the
# login shell learns that the menu failed.
TF_SESSION_STATUS="${TF_SESSION_STATUS:-${XDG_RUNTIME_DIR:-/tmp}/thinfloe-session.status}"

# Show why the menu failed, in a window, and keep the compositor alive while
# it is open. Returning straight away would let getty restart the session
# and the reason would never be on screen.
tf_hold() {
    foot --title "ThinFloe: the menu failed" -- sh -c '
        echo "thinfloe-menu exited with status $1, so the session stopped."
        echo "This session did not save your home directory when it ended."
        echo ""
        echo "Last lines of the session log ($2):"
        tail -n 20 "$2" 2>/dev/null
        echo ""
        echo "Close this window to continue."
        exec sh' thinfloe-hold "$1" "${TF_SESSION_LOG:-unknown}"
}

# The menu's exit status:
#
#   0          log out. The menu has already saved the home directory
#              behind its dialog, or the save failed and the person at the
#              machine chose "Log out anyway". Do not save again: a second
#              save would only repeat the first one's result, or overwrite
#              what the person just declined to keep waiting for.
#   10, 11     restart, power off. The menu has saved, as for 0.
#   any other  the menu failed: do NOT save, show why, hold
#
# Failure is the default branch on purpose. A Rust panic exits 101, a
# segfault 139, a failed exec 126 or 127; reading those as logout would make
# a crash silent, and saving on them would archive the home once per
# respawn.
# labwc is up and its screen covers the boot picture: end Plymouth now, so
# the boot can finish (multi-user.target waits for Plymouth to quit), and
# leave its last picture rather than a text console behind. The helper
# needs root; it does nothing when Plymouth is gone (every later session).
sudo -n "${TF_PLYMOUTH_STEP:-/usr/libexec/thinfloe/plymouth-step}" quit-retain \
    >/dev/null 2>&1 || true

# A kanshi the sessionrc started by hand is left alone: two would fight.
# Scans /proc rather than calling pgrep: procps is not guaranteed.
tf_kanshi_running() {
    for _d in /proc/[0-9]*; do
        [ -O "$_d" ] || continue
        read -r _n 2>/dev/null <"$_d/comm" || continue
        [ "$_n" = kanshi ] && return 0
    done
    return 1
}
if [ -r "$kanshi_dir/config" ] && command -v kanshi >/dev/null 2>&1 &&
   ! tf_kanshi_running; then
    kanshi -c "$kanshi_dir/config" >>"${TF_SESSION_LOG:-/dev/null}" 2>&1 &
    HELPER_PIDS="$HELPER_PIDS $!"
fi

# The title bars follow the menu's scale: drop a scale file left by an earlier
# session (the helper would apply it before the menu has measured), then let
# the helper wait for the menu's new one.
# Same path rule as the menu and the helpers: an empty variable is unset, and
# with neither set there is no file to remove.
scale_file=${TF_SCALE_FILE:-}
if [ -z "$scale_file" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    scale_file=$XDG_RUNTIME_DIR/thinfloe-scale
fi
[ -n "$scale_file" ] && rm -f "$scale_file"
# Likewise the monitor an earlier session's menu asked for, and labwc-scale's
# confirmation of it: the helper would put this menu there, and the menu
# writes the file only when its own choice changes.
menu_output_file=${TF_MENU_OUTPUT_FILE:-}
if [ -z "$menu_output_file" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    menu_output_file=$XDG_RUNTIME_DIR/thinfloe-menu-output
fi
[ -n "$menu_output_file" ] && rm -f "$menu_output_file" "$menu_output_file.applied"
"${TF_LABWC_SCALE:-/usr/libexec/thinfloe/labwc-scale}" >>"${TF_SESSION_LOG:-/dev/null}" 2>&1 &
HELPER_PIDS="$HELPER_PIDS $!"

menu_started=1
"$TF_MENU"
menu_rc=$?
echo "$menu_rc" >"$TF_SESSION_STATUS" 2>/dev/null || true
case "$menu_rc" in
    0)
        exit 0
        ;;
    10|11)
        # sudo, because the image has no polkit: systemd refuses Reboot and
        # PowerOff to a caller that is not root when no polkit authority
        # answers.
        if [ "$menu_rc" = 10 ]; then verb=reboot; else verb=poweroff; fi
        if sudo systemctl "$verb"; then
            exit 0
        fi
        echo "thinfloe: sudo systemctl $verb failed" >&2
        foot --title "ThinFloe: $verb failed" -- sh -c '
            echo "The menu saved your home directory, but \"sudo systemctl $1\" failed."
            echo ""
            echo "Close this window to continue."
            exec sh' thinfloe-hold "$verb"
        exit "$menu_rc"
        ;;
    *)
        echo "thinfloe: thinfloe-menu exited with status $menu_rc - the home directory was not saved" >&2
        tf_hold "$menu_rc"
        exit "$menu_rc"
        ;;
esac
