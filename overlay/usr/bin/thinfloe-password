#!/bin/sh
# Set, clear or restore tfuser's password for remote access.
#
# The image ships no password: adduser --disabled-password leaves `!` in the
# shadow field, so password authentication cannot succeed until someone sets
# one here. sshd keeps PasswordAuthentication yes, which is inert while no
# password exists.
#
# The hash is stored in tfuser's home directory (~/.config/thinfloe/password;
# a home still in the 4.x layout keeps ~/.thinfloe-password), which thinfloe-save-home
# archives at every clean logout and the initramfs restores before
# multi-user.target. thinfloe-password --apply, ordered before ssh.service, puts
# it back into the shadow file on each boot.
#
# The hash therefore travels in home.tar.gz on the EFI partition, or to the
# boot server over plain HTTP on a netbooted machine. Anyone holding the boot
# medium can read it and attack it offline. This is the same exposure the SSH
# host private keys in ~/.config/thinfloe/ssh-host-keys already carry; see docs/notes/home-persistence.md.
set -e

USER_NAME=tfuser
LEGACY_STORE_NAME=".thinfloe-password"

usage() {
    cat >&2 <<EOF
Usage: sudo thinfloe-password [--set | --clear | --apply]

  --set     Set the remote-access password (the default with no arguments).
  --clear   Remove the stored password and lock the account again.
  --apply   Install the stored password. Run at boot, before ssh.service.
EOF
}

# The home directory comes from the passwd database, never from \$HOME. This
# script runs under sudo, where env_reset and the absence of an env_keep for
# HOME make \$HOME /root, so a \$HOME-based path writes the hash into root's
# home: lost at the next boot, and owned by the wrong user. Same defect as the
# one cfe7aa0 fixed in thinfloe-save-home.
#
# The `|| true` is load-bearing: a failed command substitution in an
# assignment ends the script under `set -e`, which is what disabled every home
# save on USB boot before cfe7aa0.
home_dir=$(getent passwd "$USER_NAME" | cut -d: -f6 2>/dev/null || true)
: "${home_dir:=/home/$USER_NAME}"

# Which layout the home has: $TF_STATE_DIR/home-layout is "legacy" or "new".
# The menu's rule exactly: the whole file is "legacy" or "legacy" and one
# newline; anything else, a missing file included, is the new layout. The
# file is owned by tfuser, who can change it, so it only picks between two
# paths inside tfuser's own home; see check_no_links for the rest.
layout=
extra=
{
    IFS= read -r layout || true
    if IFS= read -r extra || [ -n "$extra" ]; then layout=new; fi
} 2>/dev/null <"${TF_STATE_DIR:-/run/thinfloe/state}/home-layout" || layout=new
[ "$layout" = legacy ] || layout=new

cfg_dir="$home_dir/.config/thinfloe"
if [ "$layout" = legacy ]; then
    store="$home_dir/$LEGACY_STORE_NAME"
else
    store="$cfg_dir/password"
fi

# This runs as root inside a tree tfuser can write to. Refuse to go through
# a link at a component this layout uses (new: ~/.config, ~/.config/thinfloe
# and the store; legacy: the store only): root would write the hash (or chown)
# wherever tfuser pointed it. What holds: the temp file is created with
# O_EXCL (shell noclobber), which fails on any existing name, links included,
# so the hash is never written through a link at that name; chown -h and mv
# act on the name itself. What does not: tfuser can still swap a directory
# component between the check and the use; that needs a race and only
# redirects root into places tfuser's own rename could not reach.
check_no_links() {
    if [ "$layout" = legacy ]; then
        set -- "$store"
    else
        set -- "$home_dir/.config" "$cfg_dir" "$store"
    fi
    for _p in "$@"; do
        if [ -L "$_p" ]; then
            echo "thinfloe-password: $_p is a link; refusing to use it." >&2
            return 1
        fi
    done
}

# Create ~/.config/thinfloe, owned by tfuser, unless this home is legacy.
ensure_store_dir() {
    [ "$layout" = legacy ] && return 0
    for _d in "$home_dir/.config" "$cfg_dir"; do
        if [ ! -e "$_d" ]; then
            mkdir "$_d" || return 1
            chown -h "$USER_NAME:$USER_NAME" "$_d" || return 1
        fi
        if [ -L "$_d" ] || [ ! -d "$_d" ]; then
            echo "thinfloe-password: $_d is not a directory; refusing to use it." >&2
            return 1
        fi
    done
}

do_set() {
    if [ ! -d "$home_dir" ]; then
        echo "thinfloe-password: $home_dir is not a directory" >&2
        return 1
    fi
    # Before chpasswd: a refusal must change nothing.
    check_no_links || return 1

    if [ -t 0 ]; then
        printf 'New remote-access password for %s: ' "$USER_NAME" >&2
        stty -echo 2>/dev/null || true
    fi
    read -r _pw1 || true
    if [ -t 0 ]; then
        stty echo 2>/dev/null || true
        printf '\nRetype it: ' >&2
        stty -echo 2>/dev/null || true
    fi
    read -r _pw2 || true
    if [ -t 0 ]; then
        stty echo 2>/dev/null || true
        printf '\n' >&2
    fi

    if [ -z "$_pw1" ]; then
        echo "thinfloe-password: empty password refused. Nothing was changed." >&2
        return 1
    fi
    if [ "$_pw1" != "$_pw2" ]; then
        echo "thinfloe-password: the two entries differ. Nothing was changed." >&2
        return 1
    fi

    # Let chpasswd hash it, then read back what it produced, so the stored
    # value always matches the crypt method the image is configured for
    # rather than one hardcoded here.
    printf '%s:%s\n' "$USER_NAME" "$_pw1" | chpasswd
    _hash=$(getent shadow "$USER_NAME" | cut -d: -f2 2>/dev/null || true)
    if [ -z "$_hash" ] || [ "$_hash" = "!" ] || [ "$_hash" = "*" ]; then
        echo "thinfloe-password: no hash in the shadow file after chpasswd;" >&2
        echo "               the password was not stored." >&2
        return 1
    fi

    # Create the file unreadable to anyone else before the hash goes into it:
    # a new file (noclobber = O_EXCL, mode 600 from the umask, no window in
    # which it exists with other modes or can be reached through a link),
    # then a rename over the store, which replaces a link instead of
    # following it. Every failure removes the temp file: it holds the hash and
    # the next save would archive it.
    ensure_store_dir || return 1
    _tmp="$(dirname "$store")/.password.$$.$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
    if ! (umask 077; set -C; printf '%s\n' "$_hash" >"$_tmp"); then
        rm -f "$_tmp"
        return 1
    fi
    # Owned by tfuser, not root, like everything else in the home. Until
    # 2026-10 the netboot save ran tar as tluser (the account's name before
    # 4.0), where a root-owned 600 file
    # failed the whole save; both save paths now archive as root.
    if ! chown -h "$USER_NAME:$USER_NAME" "$_tmp" || ! mv -f "$_tmp" "$store"; then
        rm -f "$_tmp"
        return 1
    fi

    echo "Remote-access password set. It is kept with your home directory" >&2
    echo "and restored on the next boot after you log out cleanly." >&2
}

do_clear() {
    # Both stores go, whatever the layout says: a cleared password must not
    # come back through the other one. rm -f removes a link, not its target;
    # a link at ~/.config or ~/.config/thinfloe is not followed.
    rm -f "$home_dir/$LEGACY_STORE_NAME"
    if [ ! -L "$home_dir/.config" ] && [ ! -L "$cfg_dir" ]; then
        rm -f "$cfg_dir/password"
    fi
    # A ~/.dbrrg-password that a save on a 3.x fallback boot left in the
    # home goes too. 4.0 never reads it, but the next 3.x boot would install
    # it, and so would a migration on a boot whose archive lost
    # ~/.thinfloe-home-version: a cleared password must not come back.
    rm -f "$home_dir/.dbrrg-password"
    # -d before -l, and both. `passwd -l` on its own prefixes the EXISTING
    # hash with `!` and leaves it recoverable, so clearing the password left
    # the old one in the shadow file: observed in the image as
    # `!$y$j9T$ULDsq...` after a --clear. -d empties the field first, and -l
    # then makes it `!` rather than empty, which matters because
    # /etc/pam.d/common-auth carries `nullok`.
    passwd -d "$USER_NAME" >/dev/null
    passwd -l "$USER_NAME" >/dev/null
    echo "Remote-access password removed. Password logins are refused again." >&2
}

do_apply() {
    # Not an error: this is every machine on which nobody has set a password.
    # This runs before ssh.service, so a non-zero exit here would fail a unit
    # on an ordinary boot.
    [ -f "$store" ] || [ -L "$store" ] || exit 0
    check_no_links || return 1

    _hash=$(cat "$store" 2>/dev/null || true)
    if [ -z "$_hash" ]; then
        echo "thinfloe-password: $store is empty; refusing to set an empty" >&2
        echo "               password. Run 'sudo thinfloe-password' to set one." >&2
        return 1
    fi
    printf '%s:%s\n' "$USER_NAME" "$_hash" | chpasswd -e
}

case "${1:---set}" in
    --set)   do_set ;;
    --clear) do_clear ;;
    --apply) do_apply ;;
    -h|--help) usage; exit 0 ;;
    *) echo "thinfloe-password: unknown argument '$1'" >&2; usage; exit 2 ;;
esac
