[Unit]
Description=Check the ThinFloe release server once a day

# The check after boot is thinfloe-upgrade-boot-check.timer. systemd applies
# RandomizedDelaySec to every time a timer fires, so an OnBootSec= here would
# delay that first check by up to an hour. OnUnitActiveSec counts from the
# last run of thinfloe-upgrade-check.service, which the boot timer starts first.
[Timer]
OnUnitActiveSec=1d
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
