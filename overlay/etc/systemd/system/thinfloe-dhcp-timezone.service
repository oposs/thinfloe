[Unit]
Description=Set the time zone the DHCP server sends
# Deliberately no Before= on anything in sysinit.target. This unit is
# WantedBy=multi-user.target and so implicitly After=basic.target; see
# CLAUDE.md, "A multi-user.target unit must never declare Before= on a
# sysinit.target unit".
After=systemd-networkd.service
# Restarts after a failure must never hit the start limit and stop for the
# rest of the boot.
StartLimitIntervalSec=0
# One long-running watcher and no path unit: a PathChanged= path unit stops
# watching while its service runs and does not look again when it re-arms,
# so a lease written during a run was lost until the next renewal. The
# script arms its inotify watch before it reads the leases that are already
# there (a fast lease, or the initramfs lease on netboot) and keeps it armed
# while it reads.

[Service]
Type=simple
ExecStart=/usr/libexec/thinfloe/dhcp-timezone --watch
Restart=on-failure
RestartSec=2
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
