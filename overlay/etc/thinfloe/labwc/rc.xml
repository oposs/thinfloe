<?xml version="1.0"?>
<!--
  thinfloe labwc configuration.

  IMPORTANT: the <keyboard> section deliberately contains no default-keybind
  element and no keybind entries, so labwc registers ZERO keybindings.

  This is required, not cosmetic. Rootless Xwayland (always the case under
  labwc) never requests zwp_keyboard_shortcuts_inhibit_manager_v1 - its only
  call site returns immediately when rootless - so that protocol was never
  the mechanism here. The real one is zwp_xwayland_keyboard_grab_manager_v1,
  which forwards X11 keyboard grabs (XGrabKeyboard) to the compositor. Our
  labwc carries a patch implementing it
  (containers/ubuntu/patches/0002-xwayland-keyboard-grab.patch), but that
  path is unverified on real hardware with a keyboard attached (see
  CLAUDE.md's "labwc must have zero keybindings" and the design spec in
  docs/superpowers/specs/). Until it is confirmed, every keybinding added
  here is a key combination that can never reach the ThinLinc session.

  labwc treats default keybinds as opt-in: omitting the default-keybind
  element yields none.
-->
<labwc_config>
  <keyboard>
    <numlock>on</numlock>
    <repeatDelay>500</repeatDelay>
    <repeatRate>30</repeatRate>
  </keyboard>
  <!--
    Title bar font: Geo, shipped in /usr/share/fonts/truetype/thinfloe. The
    colours are in themerc-override next to this file. No window icon on
    the left (labwc's default layout is icon:iconify,max,close): it pushed
    the title about 32 px in.
  -->
  <theme>
    <titlebar>
      <layout>:iconify,max,close</layout>
    </titlebar>
    <font place="ActiveWindow" name="Geo" size="10" />
    <font place="InactiveWindow" name="Geo" size="10" />
  </theme>
  <!--
    No <mouse> section. An empty one made labwc log
    "empty string is not allowed for mouse, ignoring" on every start.
    Mouse bindings are not a passthrough concern the way keybindings are:
    pointer events reach the focused client regardless, and the default
    bindings act on titlebars and the desktop, neither of which a
    fullscreen ThinLinc session presents.
  -->
  <!--
    thinfloe-menu is the desktop: always the bottom window, so a program
    window can never go behind it, and never in the window list, where it could
    be minimised. The menu sets this app_id in src/thinfloe-menu/src/app.rs.
  -->
  <windowRules>
    <windowRule identifier="thinfloe-menu" skipTaskbar="yes">
      <action name="ToggleAlwaysOnBottom" />
    </windowRule>
  </windowRules>
</labwc_config>
